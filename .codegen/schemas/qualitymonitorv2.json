    "fields": {
      "name": {
        "description": "Can be set by system. Does not need to be user facing.",
        "launch_stage": "PUBLIC_BETA"
      },
      "percent_null_validity_check": {
        "ref": "qualitymonitorv2.PercentNullValidityCheck",
        "launch_stage": "PUBLIC_BETA"
      },
      "range_validity_check": {
        "ref": "qualitymonitorv2.RangeValidityCheck",
        "launch_stage": "PUBLIC_BETA"
      },
      "uniqueness_validity_check": {
        "ref": "qualitymonitorv2.UniquenessValidityCheck",
        "launch_stage": "PUBLIC_BETA"
