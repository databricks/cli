{
  "domains.CreateDomainRequest": {
    "fields": {
      "domain": {
        "ref": "domains.Domain",
        "launch_stage": "PUBLIC_BETA"
      },
      "domain_id": {
        "description": "Client-supplied resource ID for the new domain. If omitted, the server\ngenerates one.",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "OPTIONAL"
        ]
      }
    }
  },
  "domains.DeleteDomainRequest": {
    "fields": {
      "force": {
        "description": "When false (default), DeleteDomain is rejected with FAILED_PRECONDITION if\nthe domain still has Glossary pages. When true, those pages are deleted\nfirst and then the domain is removed.",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "INPUT_ONLY",
          "OPTIONAL"
        ]
      }
    }
  },
  "domains.Domain": {
    "fields": {
      "business_owner_ids": {
        "description": "Principal IDs of the business owners (users, groups, or service principals).",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "OPTIONAL"
        ]
      },
      "create_time": {
        "description": "Timestamp when the domain was created.",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "OUTPUT_ONLY"
        ]
      },
      "description": {
        "description": "Full description (max 4096 chars)",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "OPTIONAL"
        ]
      },
      "domain_id": {
        "description": "Unique identifier for the domain. If omitted at Create, the server\ngenerates one.",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "OUTPUT_ONLY"
        ]
      },
      "draft": {
        "description": "Whether to mark the domain as a draft. If omitted on Create, the server\napplies a default; the resolved value is returned in `effective_draft`.",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "INPUT_ONLY",
          "OPTIONAL"
        ]
      },
      "effective_draft": {
        "description": "Resolved draft state of the domain.",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "OUTPUT_ONLY"
        ]
      },
      "icon": {
        "description": "Icon to display for the domain.",
        "ref": "domains.DomainIcon",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "OPTIONAL"
        ]
      },
      "name": {
        "description": "Full resource name of the domain. The primary identifier for this resource.\nFormat: `domains/{domain_id}`\nIdentifies the domain on get, update, and delete. Not an input on\ncreate — to choose the id, set `CreateDomainRequest.domain_id`.",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "IMMUTABLE"
        ]
      },
      "parent_domain_id": {
        "description": "Domain ID of the parent. If absent, this is a top-level domain.\nIf present, this domain is a subdomain of the specified parent.",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "IMMUTABLE",
          "OPTIONAL"
        ]
      },
      "subtitle": {
        "description": "Short description (max 280 chars)",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "OPTIONAL"
        ]
      },
      "tag_key": {
        "description": "Governed tag key associated with this domain.",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "IMMUTABLE"
        ]
      },
      "technical_owner_ids": {
        "description": "Principal IDs of the technical owners (users, groups, or service principals).",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "OPTIONAL"
        ]
      },
      "update_time": {
        "description": "Timestamp when the domain was last updated.",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "OUTPUT_ONLY"
        ]
      }
    }
  },
  "domains.DomainIcon": {
    "description": "Icon configuration for a domain.",
    "fields": {
      "color": {
        "description": "Hex color code with # prefix (e.g., \"#FF5733\").",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "OPTIONAL"
        ]
      },
      "name": {
        "ref": "domains.DomainIconName",
        "launch_stage": "PUBLIC_BETA",
        "behaviors": [
          "OPTIONAL"
        ]
      }
    }
  },
