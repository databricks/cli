{
  "id": "catalog.Connections",
  "name": "Connections",
  "description": "A connection represents an external data source for use within Databricks.\n\nCreating a connection object is the first step to managing external data sources within Unity Catalog. The\nsecond step is creating a data object (catalog, schema, or table) using the connection. Data objects\nderived from a connection can be written to or read from similar to other Unity Catalog data objects based on\ncloud storage. You can create different types of connections, and each connection has a unique set of\nconfiguration options to support credential management and other settings.",
  "package": {
    "name": "catalog"
  },
  "docs_group": "catalog",
  "launch_stage": "GA",
  "cli_launch_stage_display": "GA",
  "list": {
    "named_id_map": {
