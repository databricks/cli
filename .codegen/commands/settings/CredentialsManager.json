              "enum": [
                {
                  "content": "ARCLIGHT_AZURE_EXCHANGE_TOKEN"
                },
                {
                  "content": "ARCLIGHT_AZURE_EXCHANGE_TOKEN_WITH_USER_DELEGATION_KEY"
