      "can_use_json": true,
      "must_use_json": true,
      "is_crud_create": true,
      "launch_stage": "GA",
      "cli_launch_stage_display": "GA",
      "request": {
        "pascal_name": "CreateStorageConfigurationRequest",
        "is_object": true,
        "has_required_request_body_fields": true,
        "required_fields": [
          {
            "name": "storage_configuration_name",
            "description": "The human-readable name of the storage configuration.",
            "required": true,
            "is_request_body_field": true,
            "entity": {
              "is_string": true
            }
          },
          {
