		}
		if {{.CamelName}}Limit > 0 {
			ctx = cmdio.WithLimit(ctx, {{.CamelName}}Limit)
		}
		response := {{.Bind.ClientExpr}}.{{.Bind.IterMethod}}(ctx{{.Bind.CallArgs}})
		return cmdio.RenderIterator(ctx, cmdgen.MapSeq(response, {{.Bind.FromSDK}}))
		{{- else if eq .Bind.SdkKind "err" }}
		err = {{.Bind.ClientExpr}}.{{.Bind.SdkMethod}}(ctx{{.Bind.CallArgs}})
		if err != nil {
			return err
		}
		return nil
		{{- else }}
		response, err := {{.Bind.ClientExpr}}.{{.Bind.SdkMethod}}(ctx{{.Bind.CallArgs}})
		if err != nil {
			return err
		}
		{{- if .Pagination }}
		if {{.CamelName}}Limit < 0 {
			return fmt.Errorf("--limit must be a non-negative integer, got %d", {{.CamelName}}Limit)
		}
		if {{.CamelName}}Limit > 0 {
			ctx = cmdio.WithLimit(ctx, {{.CamelName}}Limit)
		}
		{{- end }}
		{{template "render-result" .}}
		{{- end }}
		{{- end }}
	}

	// Disable completions since they are not applicable.
	// Can be overridden by manual implementation in `override.go`.
	cmd.ValidArgsFunction = cobra.NoFileCompletions

	// Apply optional overrides to this command.
	for _, fn := range {{.CamelName}}Overrides {
		fn(cmd{{if and (not .IsLegacyEmptyRequest) .Bind.HasRequest}}, &{{.Bind.ReqVar}}{{end}})
	}

	return cmd
}

{{end}}
// end service {{.Name}}{{end}}

{{- define "render-result" -}}
	{{- if not .Bind.HasWaitResult }}
		_ = response
		return nil
	{{- else if .Bind.HasResult }}
		out, err := {{.Bind.FromSDK}}(response)
		if err != nil {
			return err
		}
		return cmdio.Render(ctx, out)
	{{- else }}
		_ = response
		return nil
	{{- end }}
{{- end -}}

{{- define "raw-call" -}}
	{{- $method := .Method -}}
		{{$method.Bind.RawAssemble}}
		{{$method.Bind.RawQuery}}
		api, err := apiclient.New({{if .Service.IsAccounts}}a{{else}}w{{end}}.Config)
		if err != nil {
			return err
		}
		{{- if $method.Response.IsEmptyResponse }}
		err = api.Do(ctx, "{{$method.Bind.Verb}}", rawPath, {{$method.Bind.RawHeaders}}, rawQuery, {{$method.Bind.RawBody}}, nil)
		if err != nil {
			return err
		}
		return nil
		{{- else }}
		var response any
		err = api.Do(ctx, "{{$method.Bind.Verb}}", rawPath, {{$method.Bind.RawHeaders}}, rawQuery, {{$method.Bind.RawBody}}, &response)
		if err != nil {
			return err
		}
		{{- if $method.Pagination }}
		if {{$method.CamelName}}Limit < 0 {
			return fmt.Errorf("--limit must be a non-negative integer, got %d", {{$method.CamelName}}Limit)
		}
		{{- end }}
		return cmdio.Render(ctx, response)
		{{- end }}
{{- end -}}

{{- define "args-scan" -}}
	{{- $field := .Field -}}
	{{- $method := .Method -}}
	{{- $arg := .Arg -}}
	{{- $hasIdPrompt := .HasIdPrompt -}}
	{{ $canUseJson := and $method.CanUseJson (not (in .ExcludeFromJson $method.KebabName)) }}
	{{- $optionalIfJsonIsUsed := and (not $hasIdPrompt) (and $field.IsRequestBodyField $canUseJson) }}
	{{- if $optionalIfJsonIsUsed  }}
	if !cmd.Flags().Changed("json") {
	{{- end }}
	{{- if or $field.Entity.IsTimestamp $field.Entity.IsDuration $field.Entity.IsFieldMask }}
	if args[{{$arg}}] != "" {
		{{$method.Bind.ArgScan $field (printf "args[%d]" $arg)}}
	}
	{{- else }}
	{{$method.Bind.ArgScan $field (printf "args[%d]" $arg)}}
	{{- end }}
	{{- if $optionalIfJsonIsUsed  }}
	}
	{{- end }}
{{- end -}}
