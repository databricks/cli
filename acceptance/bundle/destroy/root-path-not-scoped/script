trace $CLI bundle deploy
trace $CLI bundle destroy --auto-approve

# root_path does not end in ${bundle.name}/${bundle.target}, so the directory above it
# is not this bundle's and is left alone. Double slash keeps Windows from rewriting it.
title "Assert the parent directory is kept"
trace $CLI workspace get-status "//Workspace/Users/${CURRENT_USER_NAME}/.bundle/custom-root" | jq '{path, object_type}'
