# A user destroys a bundle on one machine and redeploys it (under the same name)
# from another machine that has no local state. Local state is scoped by target
# only (.databricks/bundle/<target>), while remote state lives under
# ~/.bundle/<bundle name>/<target>/state, so the two can diverge.
#
# Destroy removes the local state files, so no stale lineage is left behind: when
# machine A comes back after machine B's fresh deploy, it cleanly adopts the
# remote state instead of failing with a lineage mismatch.

title "Machine A: deploy, then destroy\n"
trace $CLI bundle deploy
trace $CLI bundle destroy --auto-approve

title "Destroy removed the local state files:\n"
trace find.py '^.databricks/bundle/default/(resources.json|terraform/terraform.tfstate)$' --expect 0

# Stash machine A's post-destroy local state and wipe it so the next deploy
# behaves like a fresh machine with no local state.
cp -r .databricks .databricks.machineA
rm -rf .databricks

title "Machine B: fresh deploy of the same bundle (mints a new lineage remotely)\n"
trace $CLI bundle deploy

# Mask machine B's (remote) lineage so the golden output is stable.
LINEAGE_B=$(print_state.py | jq -r .lineage)
add_repl.py "$LINEAGE_B" LINEAGE_B

# Back on machine A: restore the stashed local state.
rm -rf .databricks
mv .databricks.machineA .databricks

title "Machine A: commands succeed, adopting machine B's remote state\n"
trace $CLI bundle plan
trace $CLI bundle deploy
