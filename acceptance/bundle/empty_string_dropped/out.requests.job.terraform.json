{
  "method": "POST",
  "path": "/api/2.2/jobs/create",
  "body": {
    "deployment": {
      "kind": "BUNDLE",
      "metadata_file_path": "/Workspace/Users/[USERNAME]/.bundle/test-bundle/tf/state/metadata.json"
    },
    "edit_mode": "UI_LOCKED",
    "format": "MULTI_TASK",
    "git_source": {
      "git_branch": "main",
      "git_provider": "gitHub",
      "git_url": "https://example.com/repo"
    },
    "job_clusters": [
      {
        "job_cluster_key": "main",
        "new_cluster": {
          "aws_attributes": {
            "availability": "SPOT"
          },
          "cluster_log_conf": {
            "s3": {
              "destination": "s3://test-bucket/logs"
            }
          },
          "num_workers": 1
        }
      }
    ],
    "max_concurrent_runs": 1,
    "queue": {
      "enabled": true
    }
  }
}
