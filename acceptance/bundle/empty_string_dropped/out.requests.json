{
  "method": "POST",
  "path": "/api/2.0/apps",
  "q": {
    "no_compute": "true"
  },
  "body": {
    "name": "test-app-direct",
    "description": ""
  }
}
{
  "method": "POST",
  "path": "/api/2.0/database/instances",
  "body": {
    "name": "test-db-instance",
    "capacity": "CU_1"
  }
}
{
  "method": "POST",
  "path": "/api/2.0/mlflow/experiments/create",
  "body": {
    "name": "/Users/[USERNAME]/test-experiment"
  }
}
{
  "method": "POST",
  "path": "/api/2.0/mlflow/registered-models/create",
  "body": {
    "name": "test-model"
  }
}
{
  "method": "POST",
  "path": "/api/2.0/pipelines",
  "body": {
    "clusters": [
      {
        "label": "default",
        "aws_attributes": {
          "availability": "SPOT"
        }
      }
    ],
    "libraries": [
      {
        "file": {
          "path": "/Workspace/Users/[USERNAME]/.bundle/test-bundle/direct/files/pipeline.py"
        }
      }
    ],
    "deployment": {
      "kind": "BUNDLE",
      "metadata_file_path": "/Workspace/Users/[USERNAME]/.bundle/test-bundle/direct/state/metadata.json"
    },
    "root_path": "/Workspace/Users/[USERNAME]/.bundle/test-bundle/direct/files"
  }
}
{
  "method": "POST",
  "path": "/api/2.0/sql/warehouses",
  "body": {
    "name": "test-warehouse",
    "cluster_size": "2X-Small",
    "min_num_clusters": 1,
    "max_num_clusters": 1,
    "auto_stop_mins": 10,
    "spot_instance_policy": "COST_OPTIMIZED",
    "enable_photon": true
  }
}
{
  "method": "POST",
  "path": "/api/2.1/clusters/create",
  "body": {
    "num_workers": 1,
    "spark_version": "13.3.x-scala2.12",
    "aws_attributes": {
      "availability": "SPOT"
    },
    "cluster_log_conf": {
      "s3": {
        "destination": "s3://test-bucket/logs"
      }
    },
    "autotermination_minutes": 60
  }
}
{
  "method": "POST",
  "path": "/api/2.1/unity-catalog/models",
  "body": {
    "name": "test-registered-model",
    "catalog_name": "main",
    "schema_name": "default"
  }
}
{
  "method": "POST",
  "path": "/api/2.1/unity-catalog/schemas",
  "body": {
    "name": "test-schema",
    "catalog_name": "main"
  }
}
{
  "method": "POST",
  "path": "/api/2.1/unity-catalog/volumes",
  "body": {
    "name": "test-volume",
    "catalog_name": "main",
    "schema_name": "default",
    "volume_type": "MANAGED"
  }
}
{
  "method": "POST",
  "path": "/api/2.2/jobs/create",
  "body": {
    "max_concurrent_runs": 1,
    "job_clusters": [
      {
        "job_cluster_key": "main",
        "new_cluster": {
          "spark_version": "13.3.x-scala2.12",
          "aws_attributes": {
            "availability": "SPOT"
          },
          "cluster_log_conf": {
            "s3": {
              "destination": "s3://test-bucket/logs"
            }
          },
          "num_workers": 1
        }
      }
    ],
    "git_source": {
      "git_url": "https://example.com/repo",
      "git_provider": "gitHub",
      "git_branch": "main"
    },
    "format": "MULTI_TASK",
    "queue": {
      "enabled": true
    },
    "edit_mode": "UI_LOCKED",
    "deployment": {
      "kind": "BUNDLE",
      "metadata_file_path": "/Workspace/Users/[USERNAME]/.bundle/test-bundle/direct/state/metadata.json"
    }
  }
}
