# databricks.yml is committed, generated by gen_empty_config.py with every
# settable string field set to "". Deploy through each engine (separate target =>
# separate state), record create requests, and empty_sent.py classifies which
# "" fields each engine sends.
#
# Baseline: terraform drops "" via omitempty, direct sends it. As direct handling
# changes, out.empty_sent_by_direct_only.txt (the gap) shrinks.

# Resolved config the engines see. Today every "" field is still present here; a
# fix in the initialize phase would drop them, and this golden would show that.
$CLI bundle validate -o json -t direct | jq .resources > out.validate.json

# Exclude non-create traffic: workspace file ops and telemetry (nondeterministic).
trace DATABRICKS_BUNDLE_ENGINE=terraform $CLI bundle deploy -t tf
print_requests.py ^//api/2.0/workspace ^//telemetry --sort > out.requests.terraform.json

trace DATABRICKS_BUNDLE_ENGINE=direct $CLI bundle deploy -t direct
print_requests.py ^//api/2.0/workspace ^//telemetry --sort > out.requests.direct.json

$TESTDIR/empty_sent.py
