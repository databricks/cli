# databricks.yml is committed, generated by gen_empty_config.py with every settable
# string field set to "". Deploy on the direct engine and record the create requests to
# show which "" fields it sends. (The terraform engine, which dropped "" via omitempty,
# was removed in v1.20.0, so there is no longer a cross-engine comparison.)

# Resolved config the engine sees. Today every "" field is still present here; a
# fix in the initialize phase would drop them, and this golden would show that.
$CLI bundle validate -o json -t direct | nostamp | jq .resources > out.validate.json

# Exclude non-create traffic: workspace file ops, telemetry (nondeterministic), and the
# deployment history calls the DMS run adds.
trace DATABRICKS_BUNDLE_ENGINE=direct $CLI bundle deploy -t direct
print_requests.py --nostamp ^//api/2.0/workspace ^//telemetry ^//api/2.0/bundle --sort > out.requests.direct.json
