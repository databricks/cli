# Deploy the same config through each engine (separate target => separate state),
# recording create requests for each. dropped_fields.py then compares the fields
# we set to "" against what each engine actually sent, and writes the four
# comparison files.
#
# This test captures the current baseline. As the empty-string handling changes
# (e.g. a mutator in the initialize phase), empty_fields_dropped_by_terraform.txt
# should stay put, empty_fields_dropped_by_direct.txt should move toward it, and
# the *_only.txt files show the remaining gap.

trace DATABRICKS_BUNDLE_ENGINE=terraform $CLI bundle deploy -t tf
print_requests.py //clusters/create //jobs/create --sort > out.requests.terraform.json

trace DATABRICKS_BUNDLE_ENGINE=direct $CLI bundle deploy -t direct
print_requests.py //clusters/create //jobs/create --sort > out.requests.direct.json

./dropped_fields.py

title "Dropped by terraform:\n"
cat out.empty_fields_dropped_by_terraform.txt
title "Dropped by direct:\n"
cat out.empty_fields_dropped_by_direct.txt
title "Dropped by terraform only (direct still sends these):\n"
cat out.empty_fields_dropped_by_terraform_only.txt
title "Dropped by direct only:\n"
cat out.empty_fields_dropped_direct_only.txt
