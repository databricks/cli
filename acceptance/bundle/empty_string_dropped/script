# databricks.yml and empty_fields.txt are committed, generated from the field
# inventory by gen_empty_config.py (every settable string field set to ""). This
# script deploys the same config through each engine (separate target => separate
# state), records create requests, and dropped_fields.py compares the empties we
# set against what each engine sent, writing the four comparison files.
#
# Baseline: terraform drops empties via omitempty, direct sends "". As direct
# handling changes, out.empty_fields_dropped_by_terraform.txt stays put,
# out.empty_fields_dropped_by_direct.txt grows toward it, and the *_only.txt
# files show the remaining gap.

# Exclude non-create traffic: workspace file ops and telemetry (nondeterministic).
trace DATABRICKS_BUNDLE_ENGINE=terraform errcode $CLI bundle deploy -t tf
print_requests.py ^/api/2.0/workspace ^/telemetry --sort > out.requests.terraform.json

trace DATABRICKS_BUNDLE_ENGINE=direct errcode $CLI bundle deploy -t direct
print_requests.py ^/api/2.0/workspace ^/telemetry --sort > out.requests.direct.json

# Writes the four out.empty_fields_dropped_*.txt comparison files, which are
# committed goldens diffed on every run.
$TESTDIR/dropped_fields.py
