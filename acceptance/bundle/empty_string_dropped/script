# databricks.yml and empty_fields.txt are committed, generated from the field
# inventory by gen_empty_config.py (every settable string field set to ""). This
# script deploys the same config through each engine (separate target => separate
# state), records create requests, and dropped_fields.py compares the empties we
# set against what each engine sent, writing the four comparison files.
#
# Baseline: terraform drops empties via omitempty, direct sends "". As direct
# handling changes, out.empty_fields_dropped_by_terraform.txt stays put,
# out.empty_fields_dropped_by_direct.txt grows toward it, and the *_only.txt
# files show the remaining gap.

# Record only resource-create endpoints; workspace file-upload/mkdir/delete
# requests are noisy and non-deterministic.
RECORD="//clusters/create //jobs/create //pipelines //sql/warehouses \
//mlflow/registered-models/create //mlflow/experiments/create \
//unity-catalog/models //unity-catalog/schemas //unity-catalog/volumes \
//database/instances ^//workspace ^//workspace-files"

trace DATABRICKS_BUNDLE_ENGINE=terraform errcode $CLI bundle deploy -t tf
print_requests.py $RECORD --sort > out.requests.terraform.json

trace DATABRICKS_BUNDLE_ENGINE=direct errcode $CLI bundle deploy -t direct
print_requests.py $RECORD --sort > out.requests.direct.json

$TESTDIR/dropped_fields.py

title "Dropped by terraform:\n"
cat out.empty_fields_dropped_by_terraform.txt
title "Dropped by direct:\n"
cat out.empty_fields_dropped_by_direct.txt
title "Dropped by terraform only (direct still sends these):\n"
cat out.empty_fields_dropped_by_terraform_only.txt
title "Dropped by direct only:\n"
cat out.empty_fields_dropped_direct_only.txt
