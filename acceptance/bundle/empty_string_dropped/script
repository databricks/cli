# databricks.yml is committed, generated by gen_empty_config.py with every
# settable string field set to "". Deploy through each engine (separate target =>
# separate state), record create requests, and dropped_fields.py diffs the two
# request sets.
#
# Baseline: terraform drops "" via omitempty, direct sends it. As direct handling
# changes, out.empty_fields_dropped_by_terraform_only.txt (the gap) shrinks.

# Exclude non-create traffic: workspace file ops and telemetry (nondeterministic).
trace DATABRICKS_BUNDLE_ENGINE=terraform errcode $CLI bundle deploy -t tf
print_requests.py ^/api/2.0/workspace ^/telemetry --sort --keep > out.requests.terraform.json
print_requests.py //jobs/create > out.requests.job.terraform.json

trace DATABRICKS_BUNDLE_ENGINE=direct errcode $CLI bundle deploy -t direct
print_requests.py ^/api/2.0/workspace ^/telemetry --sort --keep > out.requests.direct.json
print_requests.py //jobs/create > out.requests.job.direct.json

$TESTDIR/dropped_fields.py
