title "a repository with a remote: branch, commit and origin URL come from .git\n"
mkdir withremote
cd withremote
cp ../databricks.yml .
git-repo-init
git remote add origin https://github.com/databricks/cli
trace $CLI bundle validate -o json | jq .bundle.git
cd ..
rm -fr withremote

title "a malformed .git: the worktree root is still found, with no metadata\n"
mkdir broken
cd broken
cp ../databricks.yml .
# A .git file must name the real git dir; an empty one is reported but not fatal.
printf '' > .git
# validate reports the unreadable .git and fails. Its message names the .git path,
# whose separators differ per platform, so it is asserted on outside the golden.
musterr $CLI bundle validate -o json > ../LOG.validate 2> ../LOG.stderr
jq .bundle.git < ../LOG.validate
contains.py 'failed to read .git' < ../LOG.stderr > /dev/null
cd ..
rm -fr broken
