trace $CLI bundle deploy

print_requests.py //telemetry-ext | jq '.body.protoLogs[] | fromjson | .entry.databricks_cli_log.bundle_deploy_event' > LOG.event.json

title "bool_values"
trace jq '.experimental.bool_values' LOG.event.json

# The bitmap's telemetry bits carry the same flags. app_lifecycle_started took both values, one per
# app: bool_values reports it once, as true, and the bitmap records each value.
title "Telemetry bits of the bundle bitmap"
jq -r .bundle_bitmap LOG.event.json | $CLI bundle bitmap decode | grep ' telemetry\.'
