trace $CLI bundle deploy
job_id="$(read_id.py foo)"
rm "$OUT_REQUESTS"

# The deployed job's key is renamed locally, so --select-ids resolves to a key
# the configuration no longer has.
update_file.py databricks.yml "    foo:" "    bar:"

trace $CLI bundle config-remote-sync --select-ids "jobs:$job_id" -o json

trace cat "$OUT_REQUESTS" | jq 'select(has("path") and .path == "/telemetry-ext") | .body.protoLogs[] | fromjson | .entry.databricks_cli_log.bundle_config_remote_sync_event | select(. != null) | {error_message, error_category}'

rm "$OUT_REQUESTS"
