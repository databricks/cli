# The snapshot upload duration is reported next to the files.(upload) mutator time. Its value
# varies, so only assert how many times it is reported.
print_snapshot_upload_entries() {
    jq -r 'select(.path? == "/telemetry-ext") | (.body.protoLogs // [])[] | fromjson | (.entry // .) | .databricks_cli_log.bundle_deploy_event.experimental.bundle_mutator_execution_time_ms // [] | map(select(.key == "snapshot.upload" and .value >= 0)) | length' "$OUT_REQUESTS"
}

title "First deploy uploads the snapshot\n"
trace $CLI bundle deploy
trace print_telemetry_bool_values | grep immutable_snapshot_used
trace print_snapshot_upload_entries
rm "$OUT_REQUESTS"

title "Second deploy finds the snapshot already uploaded\n"
trace $CLI bundle deploy
trace print_telemetry_bool_values | grep immutable_snapshot_used
trace print_snapshot_upload_entries
rm "$OUT_REQUESTS"
