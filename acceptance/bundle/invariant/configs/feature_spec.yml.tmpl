bundle:
  name: test-bundle-$UNIQUE_NAME

resources:
  feature_specs:
    foo:
      name: main.default.test_feature_spec_$UNIQUE_NAME
      features:
        - feature_lookup:
            table: main.default.user_features
            lookup_keys: [user_id]
            feature_names: [age]
      grants:
        - principal: account users
          privileges:
            - EXECUTE
