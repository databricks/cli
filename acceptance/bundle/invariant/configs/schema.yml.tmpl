bundle:
  name: test-bundle-$UNIQUE_NAME

resources:
  schemas:
    foo:
      catalog_name: main
      name: test-schema-$UNIQUE_NAME
      comment: This is a test schema # CAN_REMOVE
      # CANNOT_REMOVE: properties is a map, and ForceSendFields is inert for maps (#6343), so
      # clearing the whole map drops it from the request and the old value drifts back every plan.
      properties:
        tier: bronze
      grants:
        - principal: account users
          privileges:
            - USE_SCHEMA
