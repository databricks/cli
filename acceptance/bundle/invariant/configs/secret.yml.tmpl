bundle:
  name: test-bundle-$UNIQUE_NAME

variables:
  secret_value:
    description: The value of the secret

resources:
  secrets:
    foo:
      catalog_name: main
      schema_name: default
      name: test-secret-$UNIQUE_NAME
      value: ${var.secret_value}
      grants:
        - principal: account users
          privileges:
            - MANAGE
