bundle:
  name: test-bundle-$UNIQUE_NAME

variables:
  secret_value:
    description: "Test secret value"

resources:
  secrets:
    foo:
      catalog_name: main
      schema_name: default
      name: test-secret-$UNIQUE_NAME
      value: ${var.secret_value}
      comment: "Test secret"
      grants:
        - principal: account users
          privileges:
            - USE_SCHEMA
