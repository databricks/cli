[
  {
    "method": "POST",
    "path": "/api/2.1/unity-catalog/volumes",
    "body": {
      "catalog_name": "main",
      "comment": "This is a test volume",
      "name": "test-volume-[UNIQUE_NAME]",
      "schema_name": "default",
      "volume_type": "MANAGED"
    }
  },
  {
    "method": "PATCH",
    "path": "/api/2.1/unity-catalog/permissions/volume/main.default.test-volume-[UNIQUE_NAME]",
    "body": {
      "changes": [
        {
          "add": [
            "READ_VOLUME"
          ],
          "principal": "account users"
        }
      ]
    }
  }
]
