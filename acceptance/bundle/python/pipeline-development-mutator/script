cleanup() {
    rm -fr .databricks __pycache__
}
trap cleanup EXIT

title "Mutator sets development: false after mode: development stamped it"
trace uv run $UV_ARGS -q $CLI bundle validate --output json | jq '.resources.pipelines.my_pipeline.development'
trace uv run $UV_ARGS -q $CLI bundle deploy
rm "$OUT_REQUESTS"

title "Run does not send development, so the deployed false applies"
trace uv run $UV_ARGS -q $CLI bundle run my_pipeline
trace print_requests.py //pipelines
