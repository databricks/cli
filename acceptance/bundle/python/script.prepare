# Written in both branches, even though only "current" passes it to uv: the file sits
# in the bundle root, so creating it in just one variant makes that variant sync one
# more file than the other, and both variants share a single output.txt.
echo "$DATABRICKS_BUNDLES_WHEEL" > "requirements-latest.txt"
if [ "$PYDAB_VERSION" = "current" ]; then
  UV_ARGS="--with-requirements requirements-latest.txt"
else
  UV_ARGS="--with databricks-bundles==$PYDAB_VERSION"
fi
add_repl.py "$UV_ARGS" UV_ARGS
