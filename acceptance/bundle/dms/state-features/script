envsubst < databricks.yml.tmpl > databricks.yml

title "Deploy keeps resource state in the file and enforces best-effort history"
trace $CLI bundle deploy
replace_ids.py
trace jq '{state_version, features, state}' .databricks/bundle/default/resources.json
deployment_id=$(MSYS_NO_PATHCONV=1 $CLI workspace get-status "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/dms-state-features-${UNIQUE_NAME}/default/state/resources.deployment.json" | python3 -c 'import sys, json; print(json.load(sys.stdin)["object_id"])')
add_repl "$deployment_id" DEPLOYMENT_ID
rm -f "$OUT_REQUESTS"

title "Reopening reads resources from the file and produces a no-op plan"
trace $CLI bundle plan
trace print_requests.py --dms //resources --get --oneline

title "Disabling deployment history allows plan and deploy, and removes the file marker"
update_file.py databricks.yml 'deployment_history: true' 'deployment_history: false'
for command in plan deploy; do
    trace env DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=false $CLI bundle "$command"
done
trace jq '.features // {}' .databricks/bundle/default/resources.json
trace print_requests.py --dms //api/2.0/bundle --oneline

title "Removing the YAML setting also leaves history disabled"
update_file.py databricks.yml $'experimental:\n  deployment_history: false\n' ''
trace env DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=false $CLI bundle plan

title "Destroy also uses the disabled setting"
trace env DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=false $CLI bundle destroy --auto-approve
trace print_requests.py --dms //api/2.0/bundle --oneline

rm -f "$OUT_REQUESTS"
