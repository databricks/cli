envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

list_resources() {
    deployment_id=$(MSYS_NO_PATHCONV=1 $CLI workspace get-status "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/dms-immutable-folder-lifecycle-${UNIQUE_NAME}/default/state/resources.deployment.json" | python3 -c 'import sys, json; print(json.load(sys.stdin)["object_id"])')
    add_repl "$deployment_id" DEPLOYMENT_ID
    trace MSYS_NO_PATHCONV=1 $CLI bundle-deployments list-resources "deployments/${deployment_id}" -o json | jq -S 'map({resource_key, last_version_id, last_action_type})'
}

title "Deploy stages an operation for the job and for the immutable folder snapshot"
trace $CLI bundle deploy
trace print_requests.py --dms --method POST //versions '^//complete' '^//heartbeat'
list_resources

title "A changed file recreates the snapshot, and both resources are recorded at version 2"
echo 'print("changed")' > src/main.py
trace $CLI bundle deploy
list_resources
