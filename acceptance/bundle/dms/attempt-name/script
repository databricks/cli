envsubst < databricks.yml.tmpl > databricks.yml
attempt=webhook-triggers/11111111-1111-1111-1111-111111111111/attempts/22222222-2222-2222-2222-222222222222
trap "errcode trace '$CLI' bundle destroy --auto-approve" EXIT

title "With DATABRICKS_AUTO_DEPLOY_ATTEMPT set, the version the deploy creates records the attempt"
trace DATABRICKS_AUTO_DEPLOY_ATTEMPT=$attempt $CLI bundle deploy
add_repl "$($CLI bundle summary -o json | jq -r .bundle.deployment.deployment_id)" DEPLOYMENT_ID
trace print_requests.py --dms //versions ^//operations ^//complete

title "Without it, the request has no attempt"
trace update_file.py databricks.yml 'name: foo' 'name: renamed'
trace $CLI bundle deploy
trace print_requests.py --dms //versions ^//operations ^//complete

title "A destroy doesn't record the attempt, even with the variable set"
trace DATABRICKS_AUTO_DEPLOY_ATTEMPT=$attempt $CLI bundle destroy --auto-approve
trace print_requests.py --dms //versions ^//operations ^//complete
# Destroyed above, so the cleanup trap has nothing left to do.
trap - EXIT
