envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

title "The service rejects the deployment create, as it does when the workspace hits its deployment limit"
trace fault.py "POST /api/2.0/bundle/deployments" 400 0 1000 RESOURCE_LIMIT_EXCEEDED
trace $CLI bundle deploy

title "Nothing is recorded, so the state helpers read resources.json instead of returning nothing"
# replace_ids.py runs first, so [FOO_ID] below depends on its fallback alone.
trace replace_ids.py
trace read_state.py jobs foo id name
trace print_state.py
job_id=$(read_id.py foo)
echo "job_id is set: ${job_id:+yes}"

title "The ID works for a later command"
trace $CLI jobs get "$job_id" | gron.py | grep settings.name
