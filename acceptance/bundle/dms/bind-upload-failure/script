envsubst < databricks.yml.tmpl > databricks.yml
job_id=$($CLI jobs create --json '{"name": "bind-target-'$UNIQUE_NAME'"}' | jq -r '.job_id')
add_repl "$job_id" JOB_ID
$CLI bundle deployment bind kept "$job_id" --auto-approve &> LOG.setup
rm -f "$OUT_REQUESTS"

title "A remote state upload failure fails the bind version"
trace fault.py "POST /api/2.0/workspace-files/import-file/**resources.json" 400 0 1
trace musterr $CLI bundle deployment bind upload_failed "$job_id" --auto-approve
trace print_requests.py --dms //complete --oneline

rm -rf .databricks
title "Remote state still contains only the successful bindings"
trace $CLI bundle summary -o json | jq '.resources.jobs | map_values(.id // null)'
rm -f "$OUT_REQUESTS"

title "A history upload failure only warns the bind, but fails its version: the service holds no record of the binding"
trace fault.py "PATCH /api/2.0/bundle/deployments/*/versions/*/operations/*" 500 0 1
trace $CLI bundle deployment bind history_failed "$job_id" --auto-approve
trace print_requests.py --dms //complete --oneline

rm -rf .databricks
title "Remote state contains the binding whose history upload failed"
trace $CLI bundle summary -o json | jq '.resources.jobs | map_values(.id // null)'
rm -f "$OUT_REQUESTS"
