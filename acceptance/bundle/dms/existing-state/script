envsubst < databricks.yml.tmpl > databricks.yml

title "Deploy without recording: ordinary direct-engine state tracking one job, unknown to DMS"
trace $CLI bundle deploy
dms_plan
trace print_requests.py --dms //api/2.0/bundle --oneline
trace jq '{state_version, features}' .databricks/bundle/default/resources.json

title "Migrate the existing deployment to DMS without applying resource changes"
trace DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=true $CLI bundle deployment migrate --enable-history
trace print_requests.py --dms --keep //api/2.0/bundle --oneline
trace print_requests.py --keep --del-field raw_body //resources.json.backup --oneline
trace jq '{state_version, features}' .databricks/bundle/default/resources.json

title "The next plan adds deployment metadata without recreating resources"
trace DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=true $CLI bundle plan

title "Migration is idempotent after DMS becomes authoritative"
trace DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=true $CLI bundle deployment migrate --enable-history

# The recorded requests are asserted above via print_requests.py; drop whatever the run added after
# that (telemetry and read-only probes) so nothing is left to compare.
rm -f "$OUT_REQUESTS"
