envsubst < databricks.yml.tmpl > databricks.yml

title "1. Deploy without history: existing state tracks one job"
trace $CLI bundle deploy
dms_plan
trace print_requests.py --dms //api/2.0/bundle --oneline
trace jq '{state_version, features}' .databricks/bundle/default/resources.json

title "2. Enable history on the existing deployment\nExpect: migration succeeds without recreating the job."
trace DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=true $CLI bundle deploy
deployment_id=$(MSYS_NO_PATHCONV=1 $CLI workspace get-status "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/dms-existing-state-${UNIQUE_NAME}/default/state/resources.deployment.json" -o json | python3 -c 'import sys, json; print(json.load(sys.stdin)["object_id"])')
add_repl "$deployment_id" DEPLOYMENT_ID

title "3. Remove local state and deploy again\nExpect: remote DMS state is loaded; no migration or resource creation."
rm -rf .databricks
trace DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=true $CLI bundle deploy

title "4. A leftover local WAL is refused: DMS deployments do not use WALs"
mkdir -p .databricks/bundle/default
printf '{"lineage":"stale","serial":99,"state_version":2,"features":{"deployment_history":{}}}\n' > .databricks/bundle/default/resources.json.wal
musterr trace DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=true $CLI bundle deploy

title "5. Destroy follows recorded state; redeploy starts a new history"
# The rejected WAL remains on disk. Remove it before destroying the recorded deployment.
rm -f .databricks/bundle/default/resources.json.wal
# Turn history off to check that destroy still follows the recorded backend.
trace DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=false $CLI bundle destroy --auto-approve
trace DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=true $CLI bundle deploy
trace find.py 'resources[.]json[.]wal' --expect 0
trace jq '{state_version, features}' .databricks/bundle/default/resources.json

# Registration payloads, versions, and backups are covered by the migration test.
rm -f "$OUT_REQUESTS"
