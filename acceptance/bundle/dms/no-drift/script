envsubst < databricks.yml.tmpl > databricks.yml

title "Deploy, then plan without touching anything: the deployment stamp must not show as drift"
trace $CLI bundle deploy

# Only deploy stamps deployment.deployment_id. Plan sees it in state but not in config,
# so it must ignore it or report spurious changes.
trace $CLI bundle plan | contains.py "Plan: 0 to add, 0 to change, 0 to delete, 2 unchanged"

title "A second deploy is a no-op too: no update request for either resource"
trace $CLI bundle deploy
trace print_requests.py --dms //api/2.2/jobs //api/2.0/pipelines --sort
