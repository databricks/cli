bundle:
  name: dms-no-drift-$UNIQUE_NAME
experimental:
  record_deployment_history: true

resources:
  jobs:
    foo:
      name: foo
  pipelines:
    bar:
      # Unique: the Pipelines API refuses a duplicate name, so two overlapping runs on the
      # same workspace would collide. Jobs allow duplicates, which is why foo above does not.
      name: bar-$UNIQUE_NAME
      catalog: main
      schema: default
      serverless: true
      libraries:
        - file:
            path: ./transform.py
