envsubst < databricks.yml.tmpl > databricks.yml

state_path="/Workspace/Users/${CURRENT_USER_NAME}/.bundle/dms-repeated-migration-${UNIQUE_NAME}/default/state"
title "Setup: deploy job one, migrate in version 2, update its name to updated in version 3, and save recorded state (LOG.setup)"
{
    trace $CLI bundle deploy
    trace DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=false replace_ids.py
    trace update_file.py databricks.yml 'deployment_history: false' 'deployment_history: true'
    trace update_file.py databricks.yml 'name: one' 'name: updated'
    trace $CLI bundle deploy
    deployment_id=$(trace MSYS_NO_PATHCONV=1 $CLI workspace get-status "$state_path/resources.deployment.json" -o json | python3 -c 'import sys, json; print(json.load(sys.stdin)["object_id"])')
    trace MSYS_NO_PATHCONV=1 $CLI workspace export "$state_path/resources.json.backup" --format RAW --file .databricks/resources.backup.first.json
    trace DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=true print_state.py > .databricks/resources.before-repeat.json
} &> LOG.setup

title "Restore the latest recorded state without the history marker: INITIAL_REGISTER version 4, then deploy version 5"
trace MSYS_NO_PATHCONV=1 $CLI workspace import "$state_path/resources.json" --file .databricks/resources.before-repeat.json --format AUTO --overwrite
trace update_file.py databricks.yml 'name: updated' 'name: repeated'
trace $CLI bundle deploy 2>&1 | contains.py 'Deployment history enabled: ' 'Current Deployment Version: ' '?version=4' '?version=5' 'Resources: 0 created' '!Created '

title "Completed registration and deployment preserve the original resource ID"
trace MSYS_NO_PATHCONV=1 $CLI bundle-deployments list-versions "deployments/${deployment_id}" -o json | jq 'map(select((.version_id | tonumber) >= 4))' | dms_versions_fields
trace MSYS_NO_PATHCONV=1 $CLI bundle-deployments list-operations "deployments/${deployment_id}/versions/4" -o json | dms_operations_fields
trace MSYS_NO_PATHCONV=1 $CLI bundle-deployments list-operations "deployments/${deployment_id}/versions/5" -o json | dms_operations_fields
trace MSYS_NO_PATHCONV=1 $CLI bundle-deployments list-resources "deployments/${deployment_id}" -o json | dms_resource_state_fields

title "The backup captures the latest pre-repeat name updated, before deployment changes it to repeated"
trace MSYS_NO_PATHCONV=1 $CLI workspace export "$state_path/resources.json.backup" --format RAW --file .databricks/resources.backup.repeat.json
trace cat .databricks/resources.backup.repeat.json | contains.py '"name": "updated"' '!"name": "repeated"'

title "The refreshed backup equals the restored resources.json byte for byte"
trace cmp .databricks/resources.before-repeat.json .databricks/resources.backup.repeat.json

title "The first backup (name one) is replaced by the latest snapshot (name updated)"
trace musterr cmp -s .databricks/resources.backup.first.json .databricks/resources.backup.repeat.json

rm -f "$OUT_REQUESTS"
