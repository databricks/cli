envsubst < databricks.yml.tmpl > databricks.yml

# The service creates the deployment, but the client never sees the answer (in CI: an HTTP/2
# stream reset while the body is read). A retried create would be rejected as ALREADY_EXISTS.
title "The first deploy's create is applied, but its response is lost"
trace fault.py --after-handler "POST /api/2.0/bundle/deployments" 500 0 1
trace $CLI bundle deploy

title "The deploy recovered the deployment: the job carries its id"
deployment_id=$(MSYS_NO_PATHCONV=1 $CLI workspace get-status "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/dms-create-response-lost-${UNIQUE_NAME}/default/state/resources.deployment.json" | python3 -c 'import sys, json; print(json.load(sys.stdin)["object_id"])')
add_repl "$deployment_id" DEPLOYMENT_ID
job_id=$(jq -r '.state["resources.jobs.foo"].__id__' .databricks/bundle/default/resources.json)
add_repl "$job_id" JOB_ID
trace $CLI jobs get "$job_id" | jq '.settings.deployment'

title "No drift after the deploy"
trace $CLI bundle plan
