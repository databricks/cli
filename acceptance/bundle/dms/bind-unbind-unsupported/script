envsubst < databricks.yml.tmpl > databricks.yml

# The gate that refuses bind while recording deployment history is on the config, so it fires
# before any deploy. Create a real workspace job so bind gets past fetching the resource and
# reaches the gate, instead of failing because the resource does not exist.
title "bind is refused while recording deployment history"
job_id=$($CLI jobs create --json '{"name": "bind-target-'$UNIQUE_NAME'"}' | jq -r '.job_id')
add_repl "$job_id" JOB_ID
trace musterr $CLI bundle deployment bind foo "$job_id"

# File state remains writable even when it carries the history marker.
title "Unbind is allowed for file-backed history state"
trace $CLI bundle deploy
trace $CLI bundle deployment unbind foo
trace jq '{features, state}' .databricks/bundle/default/resources.json
