envsubst < databricks.yml.tmpl > databricks.yml

title "Generate and save plan WITHOUT DMS recording"
$CLI bundle plan -o json > tmp.plan.json
trace jq '{features}' < tmp.plan.json

title "Enable DMS recording and try to deploy the non-DMS plan"
trace musterr env DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=true $CLI bundle deploy --plan tmp.plan.json
trace print_requests.py //api/2.0/bundle --get

rm -f tmp.plan.json "$OUT_REQUESTS"
