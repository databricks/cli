envsubst < databricks.yml.tmpl > databricks.yml
state_path="/Workspace/Users/${CURRENT_USER_NAME}/.bundle/dms-migration-not-committed-${UNIQUE_NAME}/default/state"
other_catalog="dms_other_${UNIQUE_NAME}"

title "Setup (LOG.setup): legacy resources exist; migration would recreate the schema"
{
    $CLI bundle deploy -qq
    DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=false replace_ids.py
    cp .databricks/bundle/default/resources.json .databricks/resources.before-migration.json
    $CLI catalogs create "$other_catalog"
    update_file.py databricks.yml 'deployment_history: false' 'deployment_history: true'
    update_file.py databricks.yml 'catalog_name: main' "catalog_name: ${other_catalog}"
} &> LOG.setup
trap 'update_file.py databricks.yml "deployment_history: true" "deployment_history: false" >> LOG.cleanup 2>&1; $CLI bundle destroy --auto-approve >> LOG.cleanup 2>&1; $CLI catalogs delete "$other_catalog" --force >> LOG.cleanup 2>&1; rm -f "$OUT_REQUESTS"' EXIT
rm -f "$OUT_REQUESTS"

title "1. Planning fails after preparation; no migration is committed"
trace fault.py 'GET /api/2.2/jobs/get*' 403 0 1
trace musterr $CLI bundle deploy -qq
trace cmp .databricks/resources.before-migration.json .databricks/bundle/default/resources.json
trace MSYS_NO_PATHCONV=1 $CLI workspace export "$state_path/resources.json" --format AUTO --file .databricks/resources.after-failure.json
trace cmp .databricks/resources.before-migration.json .databricks/resources.after-failure.json
trace MSYS_NO_PATHCONV=1 $CLI workspace list "$state_path" -o json | jq -c '[.[].path | select(endswith("/resources.json.backup") or endswith("/resources.deployment.json"))]'
trace print_requests.py --dms //api/2.0/bundle

title "2. Destructive deployment is declined; migration stays uncommitted"
trace musterr $CLI bundle deploy -qq
trace cmp .databricks/resources.before-migration.json .databricks/bundle/default/resources.json
trace MSYS_NO_PATHCONV=1 $CLI workspace export "$state_path/resources.json" --format AUTO --file .databricks/resources.after-decline.json
trace cmp .databricks/resources.before-migration.json .databricks/resources.after-decline.json
trace MSYS_NO_PATHCONV=1 $CLI workspace list "$state_path" -o json | jq -c '[.[].path | select(endswith("/resources.json.backup") or endswith("/resources.deployment.json"))]'
trace print_requests.py --dms //api/2.0/bundle
