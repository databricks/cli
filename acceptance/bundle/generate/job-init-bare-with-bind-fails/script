#!/bin/bash
set -e

# Create a temporary directory for this test
tmpdir=$(mktemp -d)
cd "$tmpdir"

# Record files before attempting generate
echo "=== Files before generate ==="
find . -type f 2>/dev/null | sort || echo "(none)"

# Try to run generate job with --init-bare --bind (should fail)
echo ""
echo "=== Attempting: bundle generate job --init-bare --bind --existing-job-id 123 --key my_job ==="
errcode=0
trace $CLI bundle generate job --existing-job-id 123 --key my_job --init-bare --bind 2>&1 || errcode=$?

# Verify it failed
if [ $errcode -eq 0 ]; then
	echo "✗ FAIL: command should have rejected --bind with --init-bare"
	exit 1
fi

echo "✓ Command correctly rejected --bind with --init-bare (exit code: $errcode)"

# Verify no files were materialized
echo ""
echo "=== Files after failed generate ==="
find . -type f 2>/dev/null | sort || echo "(none)"

if [ -f databricks.yml ]; then
	echo "✗ FAIL: databricks.yml should not exist after failed command"
	exit 1
fi

echo "✓ No bundle materialized (as expected)"

# Clean up
cd /
rm -rf "$tmpdir"
