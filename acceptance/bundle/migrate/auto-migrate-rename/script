export DATABRICKS_BUNDLE_ENGINE=

title "Initial deploy on terraform with schema name 'myschema'"
trace DATABRICKS_BUNDLE_ENGINE=terraform $CLI bundle deploy

title "Rename the schema in config, then redeploy on direct (auto-migration)"
# name is an immutable provided id field. The migration seeds id fields from the deployed
# terraform state (reconcileIDFields), so a name changed in config but not applied on
# terraform is recorded as the deployed value and the plan sees a real change: schemas
# recreate on a name change, so the migration's recreate guard keeps the run on terraform
# instead of silently snapshotting the rename as already applied.
update_file.py databricks.yml "name: myschema" "name: renamed_schema"
trace $CLI bundle deploy
