export DATABRICKS_BUNDLE_ENGINE=

title "Initial deploy on terraform"
trace DATABRICKS_BUNDLE_ENGINE=terraform $CLI bundle deploy

title "Opt in via config; inject 403 on the DELETE of remote terraform.tfstate"
update_file.py databricks.yml "name: test-bundle" $'name: test-bundle\n  engine: direct'
# resources.json is uploaded successfully; then we back up terraform.tfstate to
# .backup and delete the original. Fault the second workspace/delete call
# (skipping the first one, which is the deploy's own artifacts cleanup) to
# fail the terraform.tfstate delete. The migration must surface a
# commit-error warning; the local state stays terraform.
fault.py "POST /api/2.0/workspace/delete" 403 1 1
trace $CLI bundle deploy

title "Local state was NOT rewritten (still terraform)\n"
trace find .databricks/bundle -name "resources.json" -type f
trace find .databricks/bundle -name "terraform.tfstate*" -type f

title "Retry recovers: subsequent deploy re-does the backup and completes"
trace $CLI bundle deploy

title "Local state is now direct\n"
trace find .databricks/bundle -name "resources.json" -type f
trace find .databricks/bundle -name "terraform.tfstate*" -type f

rm out.requests.txt
