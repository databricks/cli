export DATABRICKS_BUNDLE_ENGINE=

title "Deploy both jobs on terraform"
trace DATABRICKS_BUNDLE_ENGINE=terraform $CLI bundle deploy
rm -f out.requests.txt

# Point a DABs-only field at another resource's DABs-only field. Neither is in
# terraform.tfstate, so both resolution methods fail. Introduced after the deploy
# because Interpolate rewrites it to a Terraform attribute that does not exist,
# which Terraform rejects outright.
trace update_file.py databricks.yml "autotermination_minutes: 30" 'autotermination_minutes: ${resources.jobs.src.tasks[0].new_cluster.autotermination_minutes}'

# Reached through the migrate command rather than a deploy: the automatic
# migration needs a deploy, and any deploy carrying this reference is rejected by
# Terraform before the conversion runs. So this asserts the error, not telemetry.
#
# The config loader also warns that autotermination_minutes is unknown on a job
# cluster, so this particular field is a slightly synthetic way to reach the
# path; the error itself is the one any DABs-only field produces.
# Reached through the migrate command rather than a deploy: the automatic
# migration needs a deploy, and any deploy carrying this reference is rejected by
# Terraform before the conversion runs, so this asserts the error and not
# telemetry. The config loader also warns that autotermination_minutes is unknown
# on a job cluster, making this particular field a slightly synthetic way in; the
# error itself is the one any DABs-only field produces.
title "The conversion cannot resolve the reference from either side"
trace musterr $CLI bundle deployment migrate

# Not asserted, and it carries per-run timings.
rm -f out.requests.txt

