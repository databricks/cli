export DATABRICKS_BUNDLE_ENGINE=
# Migrating without state, should print a message about missing state.
trace musterr $CLI bundle deployment migrate

trace seed_tfstate.py terraform.tfstate

# The pipeline tags reference the volume's remote-computed storage_location, which the direct
# state does not persist; read it from the backend and inject it into the seeded terraform state,
# as a real terraform state would carry it, so the migration resolves the tag to the deployed value.
VOL_SL=$($CLI volumes read mycat.myschema.myvol | jq -r .storage_location)
update_file.py .databricks/bundle/dev/terraform/terraform.tfstate __VOLUME_SL__ "$VOL_SL"

print_state.py -t dev > out.original_state.json

trace $CLI bundle deployment migrate 2>&1 | contains.py 'Migrated 3 resources'
print_state.py -t dev > out.new_state.json
print_state.py -t dev --backup > out.backup_state.json
trace diff out.original_state.json out.backup_state.json
rm out.backup_state.json

# check that this is stored as resolved value, not as reference:
trace jq '.state."resources.pipelines.test_pipeline".state.tags.volume_storage_location' out.new_state.json | contains.py 's3://'

title "Should show that it's already migrated"
trace musterr $CLI bundle deployment migrate

rm "$OUT_REQUESTS"
# The migrated deploy runs on the direct engine whether or not DATABRICKS_BUNDLE_ENGINE is set.
trace $CLI bundle plan | contains.py "3 unchanged"
trace print_requests.py --get //jobs/get | contains.py 'engine/direct'

trace $CLI bundle deploy
trace print_requests.py --get //jobs/get | jq '.headers["User-Agent"][0]' | contains.py 'engine/direct'

title "Should show that it's already migrated"
trace musterr $CLI bundle deployment migrate
trace $CLI bundle debug states
trace $CLI bundle debug states --force-pull

title "Extra plan: should have no drift"
trace $CLI bundle plan | contains.py "3 unchanged"

rm "$OUT_REQUESTS"

title "Update databricks.yml, run plan & update"
trace update_file.py databricks.yml Migration Migrated
trace $CLI bundle plan
trace $CLI bundle plan -o json | nostamp > out.plan_update.json
trace $CLI bundle deploy

title "Different target: seed prod (a schema) as its own terraform deployment"
trace seed_tfstate.py terraform-prod.tfstate -t prod
trace $CLI bundle debug states -t prod
trace $CLI bundle debug states -t prod --force-pull

rm "$OUT_REQUESTS"
