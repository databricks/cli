if [ -z "${TEST_SP_APPLICATION_ID+x}" ]; then
    export TEST_SP_APPLICATION_ID="123b0db3-ba48-4e12-be3b-3b7898cdf000"
fi

envsubst < databricks.yml.tmpl > databricks.yml
export DATABRICKS_BUNDLE_ENGINE=

cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm -f "$OUT_REQUESTS"
}

trap cleanup EXIT

# Seed a prior terraform deployment of the run-as pipeline.
trace seed_tfstate.py terraform.tfstate
trace print_requests.py //pipelines > out.create_requests.json
trace print_state.py > out.old_state.json

pipeline_id=$($CLI bundle summary --output json | jq -r '.resources.pipelines.foo.id')
trace $CLI pipelines get $pipeline_id > out.pipelines_get.json

trace $CLI bundle deployment migrate
trace print_state.py > out.new_state.json
trace $CLI bundle plan
trace $CLI bundle plan -o json | nostamp > out.plan.json
