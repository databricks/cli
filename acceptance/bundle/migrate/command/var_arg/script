export DATABRICKS_BUNDLE_ENGINE=

# seed_tfstate.py consumes (deletes) the fixture, and the second block re-seeds, so keep a copy.
FIXTURE=$(cat terraform.tfstate)

# Seed a terraform deployment made with a variable, then migrate with the same '--var=X'.
trace seed_tfstate.py terraform.tfstate --var="job_name=Custom Job Name"
trace $CLI bundle deployment migrate --var="job_name=Custom Job Name" 2>&1 | contains.py 'Migrated 1 resources'
trace print_state.py | jq '.state."resources.jobs.test_job".state.name'
trace $CLI bundle plan --var="job_name=Custom Job Name" | contains.py "1 unchanged"
trace $CLI bundle destroy --var="job_name=Custom Job Name" --auto-approve

# Try different syntax, '--var X', instead of '--var=X'
rm -fr .databricks
echo "$FIXTURE" > terraform.tfstate

trace seed_tfstate.py terraform.tfstate --var "job_name=Custom Job Name"
trace $CLI bundle deployment migrate --var "job_name=Custom Job Name" 2>&1 | contains.py 'Migrated 1 resources'
trace print_state.py | jq '.state."resources.jobs.test_job".state.name'
trace $CLI bundle plan --var "job_name=Custom Job Name" | contains.py "1 unchanged"
trace $CLI bundle destroy --var="job_name=Custom Job Name" --auto-approve
