export DATABRICKS_BUNDLE_ENGINE=
trace seed_tfstate.py terraform.tfstate
# Add all resource IDs to runtime replacements to avoid pattern matching ambiguity
replace_ids.py
print_state.py > out.original_state.json

trace $CLI bundle deployment migrate 2>&1 | contains.py 'Migrated 1 resources'
print_state.py > out.new_state.json

rm "$OUT_REQUESTS"
# Badness: known issue with dashboards, will show up as 'recreate' see https://github.com/databricks/cli/pull/3966
trace $CLI bundle plan | contains.py "1 unchanged"
trace $CLI bundle plan -o json | nostamp > out.plan_after_migrate.json
