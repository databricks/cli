# Filter print_telemetry_bool_values output to auto-migration keys
# (direct_drymigrate_*, direct_migrate_*, direct_migrated_via_*). Callers
# clear "$OUT_REQUESTS" themselves; some tests want to keep it for a
# subsequent print_requests.py assertion.
print_migration_telemetry() {
    print_telemetry_bool_values | grep '^direct_' || true
}

# The replay fixtures and the generated out.* files live in the bundle root but are not bundle
# files, so keep them out of `bundle deploy`'s upload. The list excludes .gitignore itself so it is
# not uploaded either; test.toml adds .gitignore to Ignore so the harness does not flag it.
printf '%s\n' '.gitignore' 'out.*' 'terraform*.tfstate' 'terraform*-requests.json' > .gitignore
