# Filter print_telemetry_bool_values output to auto-migration keys
# (direct_migrate_*, direct_migrated_via_*). Callers
# clear "$OUT_REQUESTS" themselves; some tests want to keep it for a
# subsequent print_requests.py assertion.
print_migration_telemetry() {
    print_telemetry_bool_values | grep '^direct_' || true
}

# The replay fixtures and the generated out.* and LOG.* files live in the bundle root but are not bundle
# files, so keep them out of `bundle deploy`'s upload. The list excludes .gitignore itself so it is
# not uploaded either; test.toml adds .gitignore to Ignore so the harness does not flag it.
printf '%s\n' '.gitignore' 'out.*' 'LOG.*' 'terraform*.tfstate' 'terraform*-requests.json' > .gitignore

# Per request: the engine tags in the User-Agent (MISSING if none), method and path.
# The sed strips uniq -c's padding, which differs between GNU and BSD (macOS).
print_engines() {
    print_requests.py --get --oneline | jq -r 'select(.path | startswith("/__testserver/") | not) | ((.headers["User-Agent"][0] | [scan("engine/[a-z]+")] | join(",")) as $e | (if $e == "" then "MISSING" else $e end)) + " " + .method + " " + .path' | sort | uniq -c | sed -E 's/^ +//'
}
