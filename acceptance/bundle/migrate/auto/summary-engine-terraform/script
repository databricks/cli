export DATABRICKS_BUNDLE_ENGINE=

title "Replay a prior terraform deployment"
trace replay_tfstate.py terraform-requests.json terraform.tfstate
rm -f "$OUT_REQUESTS"

# Set after the replay: replay_tfstate.py runs bundle validate, which rejects engine: terraform.
trace update_file.py databricks.yml "{name: test-bundle}" "{name: test-bundle, engine: terraform}"

title "Summary works with engine: terraform and shows the deployed job's ID and URL"
trace $CLI bundle summary
trace $CLI bundle summary -o json | jq '{engine: .bundle.engine, id: .resources.jobs.test_job.id, url: .resources.jobs.test_job.url}'
rm -f "$OUT_REQUESTS"

title "Summary does not migrate: terraform state is left untouched\n"
trace find.py '\.databricks/.*(\.tfstate|resources.*\.json|\.wal)'
