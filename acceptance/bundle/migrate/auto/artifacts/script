export DATABRICKS_BUNDLE_ENGINE=

# The terraform engine was removed in v1.19.0, so seed the state from a fixture instead of a real
# terraform deploy. seed_tfstate.py deploys on direct (expanding the whl glob and uploading the
# wheel), threads the job id into the fixture, and drops the direct state so the bundle is on
# terraform again.
title "Seed a terraform-state fixture from a prior terraform deployment"
trace seed_tfstate.py terraform.tfstate
rm -f "$OUT_REQUESTS"

title "Redeploy with direct default: auto-migration runs after the build, so library refs are resolved"
trace $CLI bundle deploy

title "Local state is now direct\n"
trace find.py '\.databricks/.*(\.tfstate|resources.*\.json|\.wal)'
trace MSYS_NO_PATHCONV=1 $CLI workspace list "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/test-bundle/default/state"

title "Migrated state's library path (should be the resolved remote path, not the local glob)"
trace print_state.py | jq '.. | .libraries? | select(.)'

title "Subsequent deploy is a no-op on direct"
trace $CLI bundle deploy
