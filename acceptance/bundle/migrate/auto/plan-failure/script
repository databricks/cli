export DATABRICKS_BUNDLE_ENGINE=

title "Replay a prior terraform deployment (captured from a real terraform run)"
trace replay_tfstate.py terraform-requests.json terraform.tfstate
replace_ids.py
trace print_migration_telemetry
rm -f "$OUT_REQUESTS"

title "Inject GET failure so the migration plan check fails: migration hard-errors (no terraform fallback)"
# The migration plan-checks the converted state, GET-ing each resource to compare local config
# against remote state. A 403 (non-retryable) fails the plan check. The terraform engine was
# removed in v1.20.0, so there is no fallback: the deploy errors and nothing is committed, leaving
# the bundle on its terraform state so a retry can migrate. The migration runs before any plan, so
# the plan check's DoRead is the first GET here: OFFSET=0 fails it, and TIMES=1 lets the retry through.
fault.py "GET /api/2.2/jobs/get*" 403 0 1
trace DATABRICKS_BUNDLE_ENGINE=direct musterr $CLI bundle deploy
trace print_migration_telemetry
rm -f "$OUT_REQUESTS"

title "Local state was NOT rewritten (still terraform)"
trace find.py '\.databricks/.*(\.tfstate|resources.*\.json|\.wal)'
trace MSYS_NO_PATHCONV=1 $CLI workspace list "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/test-bundle/default/state"

title "Retry: plan check passes this time, migration succeeds"
trace DATABRICKS_BUNDLE_ENGINE=direct $CLI bundle deploy
trace print_migration_telemetry
rm -f "$OUT_REQUESTS"

title "Local state is now direct"
trace find.py '\.databricks/.*(\.tfstate|resources.*\.json|\.wal)'
trace MSYS_NO_PATHCONV=1 $CLI workspace list "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/test-bundle/default/state"

rm -f "$OUT_REQUESTS"
