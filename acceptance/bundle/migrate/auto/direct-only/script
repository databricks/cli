export DATABRICKS_BUNDLE_ENGINE=

title "Replay a prior terraform deployment"
trace replay_tfstate.py terraform-requests.json terraform.tfstate
rm -f "$OUT_REQUESTS"

title "Add a direct-only resource and opt in to the direct engine via config"
trace update_file.py databricks.yml "#instance_pools" "instance_pools"
trace update_file.py databricks.yml "name: test-bundle" $'name: test-bundle\n  engine: direct'

title "Plan runs on the direct engine (state migrated in memory), so the direct-only resource is planned"
trace $CLI bundle plan
trace $CLI bundle plan -o json | nostamp | gron.py | grep instance_pools
title "Plan does not commit state change, terraform stays"
trace find.py '\.databricks/.*(\.tfstate|resources.*\.json|\.wal)'
trace MSYS_NO_PATHCONV=1 $CLI workspace list "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/test-bundle/default/state"

title "Deploy commits the migration and creates the direct-only resource"
trace $CLI bundle deploy
trace print_migration_telemetry
rm -f "$OUT_REQUESTS"

title "Redeploy is a no-op: state is already on the direct engine"
trace $CLI bundle plan
trace $CLI bundle deploy
trace print_requests.py //instance-pools/create

title "No further actions planned"
trace $CLI bundle plan

rm -f "$OUT_REQUESTS"
