export DATABRICKS_BUNDLE_ENGINE=

title "Replay a prior terraform deployment (captured from a real terraform run)"
trace replay_tfstate.py terraform-requests.json terraform.tfstate
# The rejected deploy below never pushes state, so surface the remote terraform.tfstate the deploy
# would have found (replay only wrote the local one) to prove the migration leaks no direct state.
trace push_remote_tfstate.py
rm -f "$OUT_REQUESTS"

title "Direct + deployment-history requested against a terraform state is rejected before commit"
# Migration produces a plain direct state (no deployment_history feature), so requesting
# deployment history while migrating is a mismatch. It is rejected after the in-memory migration
# but before CommitMigration writes or pushes anything, so the bundle stays on terraform with no
# leaked direct state - migrate first (plain deploy), then enable deployment history.
trace DATABRICKS_BUNDLE_ENGINE=direct DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=true errcode $CLI bundle deploy
trace find.py '\.databricks/.*(\.tfstate|resources.*\.json|\.wal)'
trace MSYS_NO_PATHCONV=1 $CLI workspace list "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/test-bundle/default/state"
