export DATABRICKS_BUNDLE_ENGINE=

title "Replay a prior terraform deployment (captured from a real terraform run)"
trace replay_tfstate.py terraform-requests.json terraform.tfstate
original_job_id=$(read_id.py test_job)
rm -f "$OUT_REQUESTS"

title "Terraform migrates to direct deployment with history enabled and preserves the job ID"
trace DATABRICKS_BUNDLE_ENGINE=direct DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=true $CLI bundle deploy
trace find.py '\.databricks/.*(\.tfstate|resources.*\.json|\.wal)'
trace find.py 'resources[.]json[.]wal' --expect 0
trace DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=true $CLI bundle summary -o json |
    jq -ce --arg id "$original_job_id" '{job_id: .resources.jobs.test_job.id, version: .bundle.deployment.latest_version_id} | select(.job_id == $id)'
trace MSYS_NO_PATHCONV=1 $CLI workspace export "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/test-bundle/default/state/resources.json" --format AUTO | jq -c '{features, state}'
