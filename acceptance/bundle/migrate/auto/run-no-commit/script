export DATABRICKS_BUNDLE_ENGINE=

# The terraform engine was removed in v1.19.0, so seed the state from a fixture (a prior terraform
# deployment) instead of a real terraform deploy. seed_tfstate.py deploys on direct to create the
# job, threads its id into the fixture, and drops the direct state so the bundle is on terraform.
title "Seed a terraform-state fixture from a prior terraform deployment"
trace seed_tfstate.py terraform.tfstate
rm -f "$OUT_REQUESTS"

title "bundle run on direct migrates the terraform state IN MEMORY (no commit) to resolve the job"
# run needs the resource id, so it migrates in memory - but it is read-only w.r.t. the engine: it
# writes no local direct state, pushes nothing, and does not retire the terraform state. The bundle
# stays on terraform; a later deploy is what commits the migration.
trace DATABRICKS_BUNDLE_ENGINE=direct errcode $CLI bundle run test_job --no-wait
trace print_migration_telemetry
rm -f "$OUT_REQUESTS"

title "Nothing durable written: still on terraform (local state files + remote), no direct state / migrating temp / WAL\n"
# find.py lists matching files sorted with forward slashes (cross-platform); the terraform provider
# cache under .terraform/ is excluded by matching only state files (tfstate/.backup, resources*.json, WAL).
trace find.py '\.databricks/.*(\.tfstate|resources.*\.json|\.wal)'
trace MSYS_NO_PATHCONV=1 $CLI workspace list "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/test-bundle/default/state"
