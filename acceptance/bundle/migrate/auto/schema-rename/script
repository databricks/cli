envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
  title "Cleanup"
  trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

title "Replay the prior terraform deployment (captured from a real terraform run)"
trace replay_tfstate.py terraform-requests.json terraform.tfstate
rm -f "$OUT_REQUESTS"

title "Rename the schema (an updatable id field) and deploy on direct"
# name is an updatable id field: the schema is renamed in place (UpdateWithID), so the deploy
# needs no --auto-approve. reconcileIDFields seeds the deployed name into the converted state,
# so the migration's plan sees a rename rather than snapshotting the new name as already applied.
update_file.py databricks.yml "myschema-$UNIQUE_NAME" "myschema-$UNIQUE_NAME-renamed"
trace DATABRICKS_BUNDLE_ENGINE=direct $CLI bundle deploy

title "Redeploy on direct: the schema now matches config, so the plan is a clean no-op"
trace DATABRICKS_BUNDLE_ENGINE=direct $CLI bundle deploy

title "The schema exists under the new name and the local state is direct"
trace $CLI schemas get "main.myschema-$UNIQUE_NAME-renamed" | jq "{full_name}"
trace find.py '\.databricks/.*(\.tfstate|resources.*\.json|\.wal)'
