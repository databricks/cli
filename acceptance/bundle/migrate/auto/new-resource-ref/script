export DATABRICKS_BUNDLE_ENGINE=
export BUNDLE_VAR_warehouse_id=$TEST_DEFAULT_WAREHOUSE_ID

title "Replay a prior terraform deployment of a job only"
trace replay_tfstate.py terraform-requests.json terraform.tfstate
rm -f "$OUT_REQUESTS"

# The job gains an alert_task that references a new alert, neither of which terraform ever deployed.
# Neither the job's terraform state nor the alert has the referenced id, so the migration must not
# try to resolve it.
title "Add a new alert and a job task that references it"
# Uncomment the alert, the task and timeout_seconds (a number field with a reference) in databricks.yml.
update_file.py databricks.yml '# ' ''

title "Plan shows the new alert and the job update (the terraform state is migrated in memory)"
trace $CLI bundle plan -o json
rm -f "$OUT_REQUESTS"

title "Deploy migrates to direct, creates the alert and updates the job"
trace $CLI bundle deploy
replace_ids.py

title "The job update carries the new alert id and timeout"
trace print_requests.py //api/2.2/jobs/reset | gron.py | grep -E "alert_id|timeout_seconds"
rm -f "$OUT_REQUESTS"

title "Redeploy is a no-op"
trace $CLI bundle plan

trace $CLI bundle destroy --auto-approve
rm -f "$OUT_REQUESTS"
