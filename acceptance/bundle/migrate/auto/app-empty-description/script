export DATABRICKS_BUNDLE_ENGINE=

# Terraform always sent description "" for apps, so a terraform-deployed app without a
# description has description "" in its state. After auto-migration the config, which omits
# description, must not plan an update.
title "Replay a prior terraform deployment"
trace replay_tfstate.py terraform-requests.json terraform.tfstate
rm -f "$OUT_REQUESTS"

title "Plan after auto-migration"
trace $CLI bundle plan

title "Deploy after auto-migration"
trace $CLI bundle deploy
rm -f "$OUT_REQUESTS"

title "Plan after deploy"
trace $CLI bundle plan

trace $CLI bundle destroy --auto-approve
rm -f "$OUT_REQUESTS"
