export DATABRICKS_BUNDLE_ENGINE=

title "Replay a prior terraform deployment"
trace replay_tfstate.py terraform-requests.json terraform.tfstate
replace_ids.py
rm -f "$OUT_REQUESTS"

title "Deploy migrates to direct and honors lifecycle.depends_on"
trace $CLI bundle deploy
trace print_migration_telemetry

title "The edge is recorded in the plan"
trace $CLI bundle plan -o json | jq '.plan | map_values(.depends_on)'
