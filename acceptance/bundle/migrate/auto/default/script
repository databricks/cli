export DATABRICKS_BUNDLE_ENGINE=

title "Initial deploy opts out of direct, so it uses the terraform engine"
trace DATABRICKS_BUNDLE_ENGINE=terraform $CLI bundle deploy
trace print_migration_telemetry
rm -f "$OUT_REQUESTS"

title "Redeploy with nothing set: direct is the default, so auto-migration triggers"
trace $CLI bundle deploy
trace print_migration_telemetry
rm -f "$OUT_REQUESTS"

title "Direct-engine state is now in place; terraform state is backed up\n"
trace find .databricks/bundle -name "resources.json" -type f
trace find .databricks/bundle -name "terraform.tfstate*" -type f

title "Remote state also reflects the migration (force-pull surfaces workspace state)\n"
trace $CLI bundle debug states --force-pull

title "Subsequent deploy is a no-op on direct"
trace $CLI bundle deploy
trace print_migration_telemetry

rm -f "$OUT_REQUESTS"

title "Destroy the migrated bundle leaves no state behind, local or remote"
# The migrating deploy above renamed the local terraform.tfstate to terraform.tfstate.backup and
# backed up the remote one; this direct destroy must not leave either (nor the direct state) behind.
# find.py lists matching state files sorted with forward slashes (cross-platform), excluding the
# terraform provider cache under .terraform/; the remote state dir is gone once the destroy completes.
trace $CLI bundle destroy --auto-approve
trace find.py '\.databricks/.*(\.tfstate|resources.*\.json|\.wal)'
trace MSYS_NO_PATHCONV=1 musterr $CLI workspace list "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/test-bundle/default/state"

rm -f "$OUT_REQUESTS"
