export DATABRICKS_BUNDLE_ENGINE=

# A prior terraform deployment left this bundle on the terraform engine. The terraform engine
# was removed in v1.19.0, so instead of a real terraform deploy, seed the state from a fixture:
# seed_tfstate.py deploys on direct to create matching backend resources, threads their ids into
# the checked-in terraform.tfstate, and drops the direct state so the bundle looks like a
# terraform deployment again.
title "Seed a terraform-state fixture from a prior terraform deployment"
trace seed_tfstate.py terraform.tfstate
rm -f "$OUT_REQUESTS"

# Each call to print_migration_telemetry inspects "$OUT_REQUESTS"; clear
# it after each call so the next deploy's telemetry stands alone.
title "Opt in to direct engine via config and redeploy: auto-migration triggers"
trace update_file.py databricks.yml "name: test-bundle" $'name: test-bundle\n  engine: direct'
trace $CLI bundle deploy
trace print_migration_telemetry
rm -f "$OUT_REQUESTS"

title "Direct-engine state is now in place; terraform state is backed up\n"
trace find.py '\.databricks/.*(\.tfstate|resources.*\.json|\.wal)'

title "Remote state also reflects the migration (force-pull surfaces workspace state)\n"
trace $CLI bundle debug states --force-pull

title "Subsequent plan under direct is a no-op"
trace $CLI bundle plan | contains.py "1 unchanged"

title "Subsequent deploy under direct is a no-op"
trace $CLI bundle deploy
trace print_migration_telemetry
rm -f "$OUT_REQUESTS"

title "Modify the config — plan shows the pending update"
trace update_file.py databricks.yml "Test Auto-Migrate Job" "Test Auto-Migrate Job (renamed)"
trace $CLI bundle plan
$CLI bundle plan -o json > out.plan_update.json

title "Deploy picks up the update (with and without --plan)\n"
$CLI bundle deploy $(readplanarg out.plan_update.json)
trace print_migration_telemetry
rm -f "$OUT_REQUESTS"

trace $CLI bundle plan | contains.py "1 unchanged"

rm -f "$OUT_REQUESTS"
