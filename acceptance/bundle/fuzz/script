# Mutate a curated config per seed and run ../invariant/$FUZZ_TARGET. Loop: run_fuzz.py (see README).

# Empty READPLAN: the saved-plan matrix is out of scope for fuzz.
export READPLAN=""

# Fail if ../invariant/test.toml gained a stub that was not copied here.
grep '^Pattern = ' "$INVARIANT_DIR/test.toml" | while read -r stub; do
    grep -qxF -- "$stub" "$TESTDIR/test.toml" || echo "stub missing from fuzz/test.toml: $stub"
done | contains.py '!stub missing' > /dev/null

# Must be a function: the sourced target needs helpers from script.prepare in this shell.
seed_body() {
    cd "$1"
    # Per-seed names: seeds share one workspace, so leftover state otherwise looks like drift.
    export UNIQUE_NAME="$UNIQUE_NAME-$2"
    export FUZZ_SEED="$2"
    source "$INVARIANT_DIR/$FUZZ_TARGET/script"
}

# Fresh bash per seed, so export seed_body and helpers it calls (trace).
export -f $(compgen -A function)

run_fuzz.py
