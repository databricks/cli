git init -qb main
git config core.autocrlf false
git config user.name "Tester"
git config user.email "tester@databricks.com"
git config core.hooksPath no-hooks
# A repo-root src/ unrelated to the bundle's proj/src/, as in a monorepo.
git add proj src
git commit -qm 'Add bundle'

cd proj
trace errcode $CLI bundle deploy

for name in from_git from_git_include from_worktree; do
    title "Contents of $name.tgz"
    if [ -f dist/$name.tgz ]; then
        tar -tzf dist/$name.tgz | sort
    else
        echo "(not built)"
    fi
done

rm -rf ../.git
rm "$OUT_REQUESTS"
