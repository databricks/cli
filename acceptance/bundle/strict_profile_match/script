# The test server is reachable as both 127.0.0.1 and localhost. The first stands
# in for a host that serves one workspace, the second for a custom host shared
# by several workspaces of an account.
export CLASSIC_HOST=$DATABRICKS_HOST
export CUSTOM_HOST=${DATABRICKS_HOST/127.0.0.1/localhost}
add_repl "$CUSTOM_HOST" CUSTOM_HOST

# The workspace ID that the test server reports for its workspace.
export WORKSPACE_ID=$(curl -s "$DATABRICKS_HOST/.well-known/databricks-config" | jq -r .workspace_id)

# $CLI stays in databricks.yml so the bundle script expands it at run time.
for f in databricks.yml .databrickscfg ambiguous.databrickscfg account.databrickscfg; do
  envsubst '$CLASSIC_HOST $CUSTOM_HOST $WORKSPACE_ID' < $f > out && mv out $f
done

# Credentials come only from DATABRICKS_TOKEN. Each profile allows one pair of
# host and workspace ID; the custom host has no profile without a workspace ID.
unset DATABRICKS_HOST
export DATABRICKS_CONFIG_FILE=$TEST_TMP_DIR/.databrickscfg

title "Without strict mode, the environment token is used for a custom host of another workspace"
trace errcode $CLI bundle validate -t custom_host_other_workspace

export DATABRICKS_BUNDLE_STRICT_PROFILE_MATCH=1

for target in classic classic_with_workspace_id custom_host custom_host_workspace_id_field classic_with_matching_profile; do
  title "Strict mode, target $target matches one profile"
  trace errcode $CLI bundle validate -t $target -o json | jq '{host: .workspace.host, workspace_id: .workspace.workspace_id, profile: .workspace.profile}'
done

for target in classic_other_workspace custom_host_without_workspace_id custom_host_other_workspace unknown_host no_host classic_with_profile; do
  title "Strict mode, target $target is rejected"
  trace errcode $CLI bundle validate -t $target
done

title "Strict mode accepts an explicit profile that matches the target"
trace errcode $CLI bundle validate -t classic -p workspace_classic -o json | jq .workspace.profile

title "Strict mode rejects an explicit profile that doesn't match the target"
trace errcode $CLI bundle validate -t classic -p workspace_classic_id

title "Strict mode, a CLI started from a bundle script gets the selected profile"
trace errcode $CLI bundle run -t custom_host nested_validate

title "Strict mode, a target that matches several profiles, including [DEFAULT], is rejected"
trace errcode env DATABRICKS_CONFIG_FILE=$TEST_TMP_DIR/ambiguous.databrickscfg $CLI bundle validate -t classic

title "Strict mode skips account profiles"
trace errcode env DATABRICKS_CONFIG_FILE=$TEST_TMP_DIR/account.databrickscfg $CLI bundle validate -t custom_host -o json | jq .workspace.profile
trace errcode env DATABRICKS_CONFIG_FILE=$TEST_TMP_DIR/account.databrickscfg $CLI bundle validate -t custom_host_without_workspace_id

title "Strict mode, a missing config file is rejected"
trace errcode env DATABRICKS_CONFIG_FILE=$TEST_TMP_DIR/missing.databrickscfg $CLI bundle validate -t classic
