git-repo-init
git remote add origin https://github.com/acme/repo

title "A target without a trigger"
trace musterr $CLI bundle auto-deploy attempts

$CLI bundle auto-deploy create >> LOG.setup 2>&1
attempt_id=$($CLI bundle auto-deploy attempts -o json | jq -r '.[0].attempt_id')
rm "$OUT_REQUESTS"

title "Creating the trigger queues its first attempt"
trace $CLI bundle auto-deploy attempts
trace $CLI bundle auto-deploy attempts $attempt_id
print_requests.py --get //attempts

title "A failed attempt"
trace $CLI bundle auto-deploy attempts 11111111-1111-4111-8111-111111111111

title "An attempt that does not exist"
trace musterr $CLI bundle auto-deploy attempts 22222222-2222-4222-8222-222222222222
trace musterr $CLI bundle auto-deploy attempts webhook-triggers/x/attempts/y
