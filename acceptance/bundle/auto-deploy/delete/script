git-repo-init
git remote add origin https://github.com/acme/repo

$CLI bundle auto-deploy create >> LOG.setup 2>&1
$CLI bundle auto-deploy create -t prod >> LOG.setup 2>&1
rm "$OUT_REQUESTS"

title "Without a terminal, delete needs --auto-approve"
trace musterr $CLI bundle auto-deploy delete

title "Deleting the target's trigger leaves the other target's"
trace $CLI bundle auto-deploy delete --auto-approve
print_requests.py //git-webhooks
trace $CLI bundle auto-deploy list

title "A retried delete sends its body again"
fault.py --body-contains deployment_mode "DELETE /api/2.0/git-webhooks/trigger" 503 0 1 TEMPORARILY_UNAVAILABLE
trace $CLI bundle auto-deploy delete -t prod --auto-approve
print_requests.py //git-webhooks
trace $CLI bundle auto-deploy list

title "A target without a trigger"
trace musterr $CLI bundle auto-deploy delete --auto-approve
