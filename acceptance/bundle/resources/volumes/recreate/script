envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

trace $CLI bundle validate
trace $CLI bundle deploy -qq

title "Assert the volume is created successfully"
CATALOG_NAME="main"
SCHEMA_NAME="schema1-${UNIQUE_NAME}"
VOLUME_NAME="my_volume"
VOLUME_FULL_NAME="${CATALOG_NAME}.${SCHEMA_NAME}.${VOLUME_NAME}"
trace $CLI volumes read "${VOLUME_FULL_NAME}" | jq '{catalog_name, full_name, schema_name, volume_type}'

title "Assert that the grants were successfully applied"
trace $CLI grants get VOLUME "${VOLUME_FULL_NAME}"

title "Recreation of the volume without --auto-approve should fail since prompting is not possible"
trace errcode $CLI bundle deploy --var=schema_name='${resources.schemas.schema2.name}'

title "Successfully recreate the volume with --auto-approve"
trace $CLI bundle deploy --var=schema_name='${resources.schemas.schema2.name}' --auto-approve -qq

title "The grants landed on the recreated volume"
NEW_VOLUME_FULL_NAME="${CATALOG_NAME}.schema2-${UNIQUE_NAME}.${VOLUME_NAME}"
trace $CLI grants get VOLUME "${NEW_VOLUME_FULL_NAME}"

# The engines diverge here, so the plan goes to a per-engine file. Terraform converges.
#
# BUG (direct engine): the plan is not clean. Recreating the volume gave it a new id, but
# the grants node's state entry keeps the old one -- DeploymentUnit.Update saves state
# under the id it was called with, and neither grants nor permissions implements
# DoUpdateWithID, so the entry is never re-keyed. DoRead echoes the stale id back as
# full_name, the planner compares it against the config's new name, and plans the same
# update again -- every deploy, forever. The grants themselves are correct (asserted
# above), so this is stale bookkeeping rather than lost access; the deploy just never
# reports converged. Same shape for permissions on any resource whose id changes on
# recreate.
title "Plan after recreate"
trace $CLI bundle plan --var=schema_name='${resources.schemas.schema2.name}' &> out.plan_after_recreate.$DATABRICKS_BUNDLE_ENGINE.txt
