OLD_SCHEMA="main.test-schema-${UNIQUE_NAME}"
NEW_SCHEMA="main.test-schema-renamed-${UNIQUE_NAME}"

cleanup() {
    errcode $CLI schemas delete "$NEW_SCHEMA" --force > LOG.cleanup 2>&1

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a schema, then a volume that names it in lower case: the volume has no dependency on the schema"
envsubst < databricks-schema-only.yml.tmpl > databricks.yml
trace $CLI bundle deploy
envsubst < databricks.yml.tmpl > databricks.yml
trace $CLI bundle deploy
print_requests.py //unity-catalog &> LOG.deploy_requests

title "Rename the schema and the volume out of band, and remove both from the config"
trace $CLI schemas update "$OLD_SCHEMA" --new-name "test-schema-renamed-${UNIQUE_NAME}" | schema_fields
trace $CLI volumes update "$NEW_SCHEMA.myvolume" --new-name myvolume2 | volume_fields
envsubst < databricks-empty.yml.tmpl > databricks.yml
print_requests.py //unity-catalog &> LOG.rename_requests

title "Selecting only the schema still lists the volume, which its delete takes along"
trace $CLI bundle deploy --select schemas.schema1 --auto-approve
trace print_requests.py //unity-catalog
trace musterr $CLI schemas get "$NEW_SCHEMA"
trace $CLI bundle summary --output json | jq '.resources // {}'
