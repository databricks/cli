envsubst < databricks.yml.tmpl > databricks.yml

SCHEMA="main.test-schema-${UNIQUE_NAME}"

cleanup() {
    # Deleting the schema deletes the volumes in it, the one created out of band too.
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

# Drop the remote_state fields that differ between clouds or from the test server.
plan() {
    trace $CLI bundle plan --output json | jq .plan | normalize_uc_payload.py updated_at updated_by metastore_id effective_predictive_optimization_flag storage_location
}

title "Deploy a schema with a volume in it"
trace $CLI bundle deploy
print_requests.py //unity-catalog &> LOG.deploy_requests
add_repl "$($CLI volumes read "$SCHEMA.myvolume" | jq -r .volume_id)" VOLUME_ID

title "Out of band, delete the volume and create another one under a new name"
trace $CLI volumes delete "$SCHEMA.myvolume"
NEW_VOLUME_ID=$($CLI volumes create main "test-schema-${UNIQUE_NAME}" myvolume2 MANAGED | jq -r .volume_id)
add_repl "$NEW_VOLUME_ID" NEW_VOLUME_ID
print_requests.py //unity-catalog &> LOG.recreate_requests

title "With the config renamed to match, the plan finds a volume at the new name, but its volume_id differs, so it plans a create"
trace update_file.py databricks.yml "name: myvolume" "name: myvolume2"
trace print_state.py | jq '.state["resources.volumes.volume1"] | {__id__, volume_id: .state.volume_id}'
trace $CLI volumes read "$SCHEMA.myvolume2" | jq '{full_name, volume_id}'
plan
