# Creating a feature spec resolves its lookup tables in Unity Catalog, so the test creates them in
# a schema of its own.
export SCHEMA_FULL_NAME="main.fspec_$UNIQUE_NAME"
trace $CLI schemas create "fspec_$UNIQUE_NAME" main -o json | jq '{full_name}'
trace create_feature_spec_fixtures.py "$SCHEMA_FULL_NAME"

cleanup() {
    $CLI bundle destroy --auto-approve >> LOG.cleanup 2>&1 || true
    $CLI schemas delete "$SCHEMA_FULL_NAME" --force >> LOG.cleanup 2>&1 || true
}
trap cleanup EXIT

envsubst < databricks.yml.tmpl > databricks.yml

trace $CLI bundle plan -o json | jq 'del(.features)' > out.plan1.json
trace print_requests.py --get //permissions
trace $CLI bundle deploy
trace print_requests.py //permissions > out.deploy1.requests.json
trace $CLI grants get function $SCHEMA_FULL_NAME.myspec | jq --sort-keys

title "Every change recreates the feature spec, which drops its grants; the bundle must re-apply them"
trace update_file.py databricks.yml "[age, country]" "[age]"
trace $CLI bundle plan -o json | jq 'del(.features)' > out.plan2.json
trace $CLI bundle deploy --auto-approve
trace print_requests.py //feature-engineering //permissions > out.deploy2.requests.json
trace $CLI grants get function $SCHEMA_FULL_NAME.myspec | jq --sort-keys

trace $CLI bundle destroy --auto-approve
trace print_requests.py //permissions > out.destroy.requests.json
