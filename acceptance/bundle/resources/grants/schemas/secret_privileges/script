envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace errcode $CLI bundle destroy --auto-approve
    rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

trace $CLI bundle deploy
trace $CLI grants get schema main.schema_secret_privileges_$UNIQUE_NAME -o json | jq -r '.privilege_assignments[] | select(.principal == "deco-test-user@databricks.com") | .privileges[]' | sort | contains.py CREATE_SECRET CREATE_FEATURE READ_FEATURE READ_SECRET REFERENCE_SECRET WRITE_SECRET
trace $CLI bundle plan
