envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace errcode $CLI bundle destroy --auto-approve
    rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

trace $CLI bundle deploy
trace $CLI grants get schema main.schema_remove_principal_manage_$UNIQUE_NAME | gron.py --noindex | sort_lines.py --repl | contains.py "$CURRENT_USER_NAME" 'deco-test-user@databricks.com'

# Remove the MANAGE principal from config.
grep -v 'TO_REMOVE' databricks.yml > tmp.yml && mv tmp.yml databricks.yml

trace $CLI bundle deploy

# The removed principal is gone: MANAGE was revoked by name, not just via
# Remove: [ALL_PRIVILEGES] (which the backend does not apply to MANAGE).
trace $CLI grants get schema main.schema_remove_principal_manage_$UNIQUE_NAME | gron.py --noindex | sort_lines.py --repl

# The deploy converges: no perpetual update.
trace $CLI bundle plan
trace $CLI bundle deploy
trace $CLI bundle plan
