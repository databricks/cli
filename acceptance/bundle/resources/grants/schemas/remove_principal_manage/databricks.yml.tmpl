bundle:
  name: schema-grants-remove-principal-manage-$UNIQUE_NAME

resources:
  schemas:
    grants_schema:
      name: schema_remove_principal_manage_$UNIQUE_NAME
      catalog_name: main
      grants:
        - principal: $CURRENT_USER_NAME
          privileges:
            - CREATE_TABLE
        # This principal holds MANAGE, which ALL_PRIVILEGES does not imply. Removing
        # it exercises the revocation path: buildGrantChanges must revoke MANAGE by
        # name (not just via Remove: [ALL_PRIVILEGES], which the backend does not
        # apply to MANAGE), otherwise the principal lingers and the plan never
        # converges.
        - { principal: deco-test-user@databricks.com, privileges: [MANAGE] } # TO_REMOVE
