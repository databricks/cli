envsubst < databricks.yml.tmpl > databricks.yml

NEW_SCHEMA="main.test-schema-renamed-${UNIQUE_NAME}"

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a schema with grants"
trace $CLI bundle deploy
trace print_requests.py //unity-catalog
trace read_state.py schemas schema1.grants id

title "Rename the schema: its ID changes, and so does the ID of its grants"
trace update_file.py databricks.yml test-schema- test-schema-renamed-
trace $CLI bundle plan
trace $CLI bundle plan --output json | nostamp | jq '.plan | map_values((.changes // {}) | with_entries(select(.value.action != "skip"))) | with_entries(select(.value != {}))'

title "Deploy moves the schema to the new name and applies the grants there"
trace $CLI bundle deploy --auto-approve
trace print_requests.py //unity-catalog
trace $CLI grants get schema "$NEW_SCHEMA" | jq '.privilege_assignments[] | select(.principal == "deco-test-user@databricks.com")'

title "The grants are recorded under the new name, so the next plan is a no-op"
trace read_state.py schemas schema1.grants id
trace $CLI bundle plan
