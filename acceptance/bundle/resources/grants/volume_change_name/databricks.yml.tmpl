bundle:
  name: test-bundle-$UNIQUE_NAME

resources:
  schemas:
    schema1:
      catalog_name: main
      name: test-schema-$UNIQUE_NAME
  volumes:
    volume1:
      catalog_name: main
      schema_name: ${resources.schemas.schema1.name}
      name: myvolume
      grants:
        - principal: deco-test-user@databricks.com
          privileges:
            - READ_VOLUME
  registered_models:
    model1:
      catalog_name: main
      schema_name: ${resources.schemas.schema1.name}
      name: mymodel
      grants:
        - principal: deco-test-user@databricks.com
          privileges:
            - APPLY_TAG
