envsubst < databricks.yml.tmpl > databricks.yml

NEW_VOLUME="main.test-schema-${UNIQUE_NAME}.myvolume_renamed"
NEW_MODEL="main.test-schema-${UNIQUE_NAME}.mymodel_renamed"

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a volume and a registered model with grants"
trace $CLI bundle deploy
# The volume and the model, and then their grants, are changed in parallel.
trace print_requests.py --sort //unity-catalog
trace read_state.py volumes volume1.grants id
trace read_state.py registered_models model1.grants id

title "Rename the volume and the model: their IDs change, and so do the IDs of their grants"
trace update_file.py databricks.yml myvolume myvolume_renamed
trace update_file.py databricks.yml mymodel mymodel_renamed
trace $CLI bundle plan --output json | jq '.plan["resources.volumes.volume1.grants"].changes'
trace $CLI bundle plan --output json | jq '.plan["resources.registered_models.model1.grants"].changes'

title "Deploy renames the volume and the model in place and applies the grants under the new names"
trace $CLI bundle deploy
# The volume and the model, and then their grants, are changed in parallel.
trace print_requests.py --sort //unity-catalog
trace $CLI grants get volume "$NEW_VOLUME" | jq '.privilege_assignments[] | select(.principal == "deco-test-user@databricks.com")'
trace $CLI grants get function "$NEW_MODEL" | jq '.privilege_assignments[] | select(.principal == "deco-test-user@databricks.com")'

title "The grants are recorded under the new name, so the next plan is a no-op"
trace read_state.py volumes volume1.grants id
trace read_state.py registered_models model1.grants id
trace $CLI bundle plan
