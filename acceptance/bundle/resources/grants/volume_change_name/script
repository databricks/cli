envsubst < databricks.yml.tmpl > databricks.yml

NEW_VOLUME="main.test-schema-${UNIQUE_NAME}.myvolume_renamed"

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a volume with grants"
trace $CLI bundle deploy
trace print_requests.py //unity-catalog
trace read_state.py volumes volume1.grants id

title "Rename the volume: its ID changes, and so does the ID of its grants"
trace update_file.py databricks.yml myvolume myvolume_renamed
trace $CLI bundle plan --output json | jq '.plan["resources.volumes.volume1.grants"].changes'

title "Deploy renames the volume and applies the grants under the new name"
trace $CLI bundle deploy
trace print_requests.py //unity-catalog
trace $CLI grants get volume "$NEW_VOLUME" | jq '.privilege_assignments[] | select(.principal == "deco-test-user@databricks.com")'

title "The grants are recorded under the new name, so the next plan is a no-op"
trace read_state.py volumes volume1.grants id
trace $CLI bundle plan
