envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

trace $CLI bundle deploy

title "Settings the backend derives from is_single_node are not drift at any cluster-spec location"
trace $CLI bundle plan

title "Each is classified backend_default"
trace $CLI bundle plan -o json | jq -S '.plan["resources.jobs.my_job"].changes
  | with_entries(select(.key | test("spark_conf|custom_tags")))'
