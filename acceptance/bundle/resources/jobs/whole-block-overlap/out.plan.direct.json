{
  "plan_version": [PLAN_VERSION],
  "cli_version": "[CLI_VERSION]",
  "lineage": "[UUID]",
  "serial": 1,
  "plan": {
    "resources.jobs.my_job": {
      "action": "update",
      "new_state": {
        "value": {
          "deployment": {
            "kind": "BUNDLE",
            "metadata_file_path": "/Workspace/Users/[USERNAME]/.bundle/test-bundle/default/state/metadata.json"
          },
          "edit_mode": "UI_LOCKED",
          "format": "MULTI_TASK",
          "max_concurrent_runs": 1,
          "name": "test-job",
          "queue": {
            "enabled": true
          },
          "schedule": {
            "pause_status": "UNPAUSED",
            "quartz_cron_expression": "0 0 12 * * ?",
            "timezone_id": "America/New_York"
          },
          "tasks": [
            {
              "notebook_task": {
                "notebook_path": "/nb"
              },
              "task_key": "main"
            }
          ]
        }
      },
      "remote_state": {
        "created_time": [UNIX_TIME_MILLIS],
        "creator_user_name": "[USERNAME]",
        "deployment": {
          "kind": "BUNDLE",
          "metadata_file_path": "/Workspace/Users/[USERNAME]/.bundle/test-bundle/default/state/metadata.json"
        },
        "edit_mode": "UI_LOCKED",
        "email_notifications": {},
        "format": "MULTI_TASK",
        "job_id": [MY_JOB_ID],
        "max_concurrent_runs": 1,
        "name": "test-job",
        "queue": {
          "enabled": true
        },
        "run_as_user_name": "[USERNAME]",
        "tasks": [
          {
            "email_notifications": {},
            "notebook_task": {
              "notebook_path": "/nb",
              "source": "WORKSPACE"
            },
            "run_if": "ALL_SUCCESS",
            "task_key": "main",
            "timeout_seconds": 0
          }
        ],
        "timeout_seconds": 0,
        "webhook_notifications": {}
      },
      "changes": {
        "email_notifications": {
          "action": "skip",
          "reason": "empty",
          "remote": {}
        },
        "schedule": {
          "action": "update",
          "old": {
            "pause_status": "UNPAUSED",
            "quartz_cron_expression": "0 0 12 * * ?",
            "timezone_id": "UTC"
          },
          "new": {
            "pause_status": "UNPAUSED",
            "quartz_cron_expression": "0 0 12 * * ?",
            "timezone_id": "America/New_York"
          }
        },
        "tasks[task_key='main'].email_notifications": {
          "action": "skip",
          "reason": "empty",
          "remote": {}
        },
        "tasks[task_key='main'].notebook_task.source": {
          "action": "skip",
          "reason": "backend_default",
          "remote": "WORKSPACE"
        },
        "tasks[task_key='main'].run_if": {
          "action": "skip",
          "reason": "backend_default",
          "remote": "ALL_SUCCESS"
        },
        "tasks[task_key='main'].timeout_seconds": {
          "action": "skip",
          "reason": "empty",
          "remote": 0
        },
        "timeout_seconds": {
          "action": "skip",
          "reason": "empty",
          "remote": 0
        },
        "webhook_notifications": {
          "action": "skip",
          "reason": "empty",
          "remote": {}
        }
      }
    }
  }
}
