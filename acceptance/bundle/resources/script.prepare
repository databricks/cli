# The *_fields helpers are the allow-lists of fields the acceptance tests assert on. Anything the
# backend returns outside a list is dropped, so a new field in the API response does not break the
# golden.
schema_fields() {
    jq '{full_name, schema_id} | with_entries(select(.value != null))'
}
volume_fields() {
    jq '{full_name, volume_id} | with_entries(select(.value != null))'
}
registered_model_fields() {
    jq '{full_name}'
}
# secret_scope_names prints the sorted names from 'secrets list-scopes -o json' on one line.
secret_scope_names() {
    jq -c '[.[].name] | sort'
}

# summary_ids prints the ID of each resource in 'bundle summary', by group and key.
summary_ids() {
    $CLI bundle summary --output json | jq '.resources // {} | map_values(map_values(.id))'
}
