trace $CLI bundle deploy
trace print_requests.py //knowledge

title "Summary shows the page ID"
trace $CLI bundle summary

title "Verify deployment (a page is a draft unless the config says otherwise)"
PAGE_ID=$($CLI bundle summary -o json | jq -r .resources.pages.chargeback.id)
trace $CLI api get /api/2.0/knowledge/pages/$PAGE_ID | jq '{name, display_name, description, synonyms, state, owner_ids, body}'

title "A second plan has no changes"
trace $CLI bundle plan

title "Update the body and the description (should update in place, and leave the state alone)"
trace update_file.py databricks.yml "initiated by the cardholder's bank" "started by the bank of the cardholder"
trace update_file.py databricks.yml "description: A reversal of a card payment." "description: A payment that was reversed."
trace $CLI bundle plan
trace $CLI bundle deploy
trace print_requests.py //knowledge
trace $CLI api get /api/2.0/knowledge/pages/$PAGE_ID | jq '{description, state, body}'

title "Publish the page"
trace update_file.py databricks.yml "display_name: Chargeback" "display_name: Chargeback
      state: PUBLISHED"
trace $CLI bundle deploy
trace print_requests.py //knowledge
trace $CLI api get /api/2.0/knowledge/pages/$PAGE_ID | jq '{state}'
trace $CLI bundle plan

title "A change made outside of the bundle shows up in the plan"
trace $CLI api patch "/api/2.0/knowledge/pages/$PAGE_ID?update_mask=body" --json '{"body": "edited in the UI"}' | jq '{body}'
trace $CLI bundle plan
print_requests.py > /dev/null

trace $CLI bundle destroy --auto-approve
trace print_requests.py //knowledge //domains

rm -f out.requests.txt
