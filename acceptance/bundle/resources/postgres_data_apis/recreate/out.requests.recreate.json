{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]",
  "q": {
    "update_mask": "spec.display_name"
  },
  "body": {
    "spec": {
      "display_name": "Test Project for Data API Recreate",
      "pg_version": 16
    }
  }
}
{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]/branches/production",
  "q": {
    "update_mask": "spec.expiration"
  },
  "body": {
    "spec": {
      "no_expiry": true
    }
  }
}
{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]/branches/production/databases/first-database",
  "q": {
    "update_mask": "spec.postgres_database,spec.role"
  },
  "body": {
    "spec": {
      "postgres_database": "first_db",
      "role": "projects/test-pg-proj-[UNIQUE_NAME]/branches/production/roles/app-owner"
    }
  }
}
{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]/branches/production/databases/second-database",
  "q": {
    "update_mask": "spec.postgres_database,spec.role"
  },
  "body": {
    "spec": {
      "postgres_database": "second_db",
      "role": "projects/test-pg-proj-[UNIQUE_NAME]/branches/production/roles/app-owner"
    }
  }
}
{
  "method": "DELETE",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]/branches/production/databases/first-database/data-api"
}
{
  "method": "POST",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]/branches/production/databases/second-database/data-api",
  "body": {
    "spec": {
      "db_max_rows": 100,
      "db_schemas": [
        "public"
      ]
    }
  }
}
