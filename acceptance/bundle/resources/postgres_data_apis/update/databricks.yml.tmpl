bundle:
  name: update-pg-data-api-$UNIQUE_NAME

sync:
  paths: []

resources:
  postgres_projects:
    my_project:
      project_id: test-pg-proj-$UNIQUE_NAME
      display_name: "Test Project for Data API Update"
      pg_version: 16

  postgres_roles:
    owner:
      parent: ${resources.postgres_projects.my_project.id}/branches/production
      role_id: app-owner
      postgres_role: app_owner

  postgres_databases:
    my_database:
      parent: ${resources.postgres_projects.my_project.id}/branches/production
      database_id: my-database
      postgres_database: app_db
      role: ${resources.postgres_roles.owner.id}

  postgres_data_apis:
    my_data_api:
      parent: ${resources.postgres_databases.my_database.name}
      db_schemas:
        - public
      db_max_rows: 100
      server_cors_allowed_origins:
        - https://app.example.com
