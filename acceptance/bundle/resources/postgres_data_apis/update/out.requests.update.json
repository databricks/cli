{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]",
  "q": {
    "update_mask": "spec.display_name"
  },
  "body": {
    "spec": {
      "display_name": "Test Project for Data API Update",
      "pg_version": 16
    }
  }
}
{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]/branches/production",
  "q": {
    "update_mask": "spec.expiration"
  },
  "body": {
    "spec": {
      "no_expiry": true
    }
  }
}
{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]/branches/production/databases/my-database",
  "q": {
    "update_mask": "spec.postgres_database,spec.role"
  },
  "body": {
    "spec": {
      "postgres_database": "app_db",
      "role": "projects/test-pg-proj-[UNIQUE_NAME]/branches/production/roles/app-owner"
    }
  }
}
{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]/branches/production/databases/my-database/data-api",
  "q": {
    "update_mask": "spec"
  },
  "body": {
    "spec": {
      "db_max_rows": 500,
      "db_schemas": [
        "public"
      ],
      "server_cors_allowed_origins": [
        "https://app.example.com"
      ]
    }
  }
}
