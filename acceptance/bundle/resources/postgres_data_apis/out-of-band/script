cleanup() {
   trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

database_name="projects/test-pg-proj-${UNIQUE_NAME}/branches/production/databases/my-database"
data_api_name="${database_name}/data-api"

title "Deploy enables the Data API"
envsubst < databricks.yml.tmpl > databricks.yml
trace $CLI bundle deploy
trace $CLI postgres get-data-api "${data_api_name}" | data_api_fields

title "Change the spec out of band"
trace $CLI postgres update-data-api "${data_api_name}" spec --json '{"spec": {"db_schemas": ["public"], "db_max_rows": 7}}' | data_api_fields

title "Plan does not detect the change: spec is input-only and GET does not return it"
trace $CLI bundle plan

title "Disable the Data API out of band"
trace $CLI postgres delete-data-api "${data_api_name}"

title "Plan detects the Data API is gone and re-creates it"
trace $CLI bundle plan
trace $CLI bundle deploy
trace $CLI postgres get-data-api "${data_api_name}" | data_api_fields
