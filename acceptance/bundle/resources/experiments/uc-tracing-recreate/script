cleanup() {
    trace $CLI bundle destroy --auto-approve
}

trap cleanup EXIT

title "Deploy an experiment whose config declares no trace_location"
trace $CLI bundle deploy -qq
experiment_id=$($CLI bundle summary --output json | jq -r '.resources.experiments.my_experiment.id')

title "An out-of-band job bound a UC trace location; GetExperiment now echoes it"
trace $CLI experiments get-experiment "$experiment_id" | jq '.experiment | {name, lifecycle_stage, trace_location}'

title "Re-plan with unchanged config: no recreate (SUP-37168 fix)"
title "trace_location is a backend_default, so a config-absent, remote-populated"
title "value is left in place instead of forcing an immutable-field recreate."
trace $CLI bundle plan

title "Deploy is a no-op and preserves the out-of-band UC trace location"
trace $CLI bundle deploy -qq
trace $CLI experiments get-experiment "$experiment_id" | jq '.experiment | {name, lifecycle_stage, trace_location}'
