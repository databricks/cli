cleanup() {
    trace $CLI bundle destroy --auto-approve
}

trap cleanup EXIT

title "create the experiment"
trace export EXPERIMENT_ARTIFACT_LOCATION="s3://original-${UNIQUE_NAME}"
trace export EXPERIMENT_NAME_PREFIX="original"
trace envsubst < templates/one_tag.tmpl > databricks.yml
trace $CLI bundle plan
trace $CLI bundle deploy -qq
experiment_id=$(read_id.py my_experiment)
trace $CLI experiments get-experiment $experiment_id | jq '.experiment | {name, artifact_location, tags}'

title "update the name"
trace export EXPERIMENT_NAME_PREFIX="new-name"
trace envsubst < templates/one_tag.tmpl > databricks.yml
trace $CLI bundle plan
trace $CLI bundle deploy -qq
experiment_id=$(read_id.py my_experiment)
trace $CLI experiments get-experiment $experiment_id | jq '.experiment | {name, artifact_location, tags}'

title "updating the artifact location should cause a recreation"
trace export EXPERIMENT_ARTIFACT_LOCATION="s3://new-${UNIQUE_NAME}"
trace envsubst < templates/one_tag.tmpl > databricks.yml
trace $CLI bundle plan
trace $CLI bundle deploy -qq
experiment_id=$(read_id.py my_experiment)
trace $CLI experiments get-experiment $experiment_id | jq '.experiment | {name, artifact_location, tags}'

title "adding a new tag updates the existing experiment"
existing_experiment_id=$experiment_id
trace envsubst < templates/two_tag.tmpl > databricks.yml
trace $CLI bundle plan > out.plan.txt
trace $CLI bundle deploy -qq
experiment_id=$(read_id.py my_experiment)
test "$experiment_id" = "$existing_experiment_id"
trace $CLI experiments get-experiment $experiment_id | jq '.experiment | {name, artifact_location, tags: (.tags | sort_by(.key))}'

title "removing all configured tags is rejected"
trace envsubst < templates/no_tag.tmpl > databricks.yml
trace musterr $CLI bundle deploy -qq
test "$(read_id.py my_experiment)" = "$existing_experiment_id"

title "removing a configured tag is rejected"
trace envsubst < templates/one_tag.tmpl > databricks.yml
trace musterr $CLI bundle deploy -qq
test "$(read_id.py my_experiment)" = "$existing_experiment_id"
trace $CLI experiments get-experiment $experiment_id | jq '.experiment | {name, artifact_location, tags: (.tags | sort_by(.key))}'
