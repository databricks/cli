envsubst < databricks.yml.tmpl > databricks.yml

NEW_MODEL="main.test-schema-renamed-${UNIQUE_NAME}.mymodel"

cleanup() {
    trace $CLI bundle destroy --auto-approve --force-lock

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a schema with a registered model in it"
trace $CLI bundle deploy
print_requests.py //unity-catalog &> LOG.deploy_requests
add_repl "$($CLI registered-models get "main.test-schema-${UNIQUE_NAME}.mymodel" | jq -r .created_at)" MODEL_CREATED_AT

title "Rename the schema and change the model's comment. The CLI is killed on the model's update, after the schema's rename is saved"
trace update_file.py databricks.yml test-schema- test-schema-renamed-
trace update_file.py databricks.yml "comment: c1" "comment: c2"
kill_after.py "PATCH /api/2.1/unity-catalog/models/$NEW_MODEL" 0 1
# -q: the per-resource lines race the kill signal.
trace errcode $CLI bundle deploy -q
trace print_requests.py //unity-catalog

title "The model is gone from its recorded path. A model has no recorded id, so the plan does not find it at its new path and creates it again"
trace print_state.py | jq '.state["resources.registered_models.model1"] | {__id__}'
trace $CLI bundle plan --output json | jq .plan | normalize_uc_payload.py created_at updated_at

title "The create fails: the model is already there"
trace errcode $CLI bundle deploy --force-lock
trace print_requests.py //unity-catalog
trace $CLI registered-models get "$NEW_MODEL" | jq '{full_name, comment, created_at}'

title "The next plan creates it again"
trace $CLI bundle plan
