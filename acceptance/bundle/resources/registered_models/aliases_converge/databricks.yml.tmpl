bundle:
  name: deploy-registered-models-aliases-$UNIQUE_NAME

resources:
  registered_models:
    my_registered_model:
      name: my-registered-model-aliases-$UNIQUE_NAME
      comment: $COMMENT
      catalog_name: main
      schema_name: default
      # The backend fills in more fields on each alias than the config sets
      # (id, catalog_name, schema_name, model_name), so a config that sets
      # aliases must still converge instead of reporting a perpetual update.
      aliases:
        - alias_name: champion
          version_num: 1
