envsubst < databricks.yml.tmpl > databricks.yml

NEW_SCHEMA="test_catalog_renamed_${UNIQUE_NAME}.myschema2"

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a catalog with a schema and a registered model in it"
trace $CLI bundle deploy
print_requests.py //unity-catalog &> LOG.deploy_requests
add_repl "$($CLI registered-models get "test_catalog_${UNIQUE_NAME}.myschema.mymodel" | jq -r .created_at)" MODEL_CREATED_AT

title "Rename the catalog and the schema in one deploy"
trace update_file.py databricks.yml test_catalog_ test_catalog_renamed_
trace update_file.py databricks.yml "name: myschema" "name: myschema2"

title "Both of the model's parents are renamed, so both its catalog_name and schema_name follow them"
# Drop the remote_state fields that differ between clouds or from the test server.
trace $CLI bundle plan --output json | tee .databricks/plan.json | jq .plan | normalize_uc_payload.py created_at updated_at updated_by metastore_id browse_only effective_predictive_optimization_flag enable_predictive_optimization isolation_mode securable_type storage_location

title "Deploy renames the catalog, then the schema under it. UC moves the model both times, so it gets no request"
trace $CLI bundle deploy $(readplanarg .databricks/plan.json)
trace print_requests.py //unity-catalog

title "The model is under the new names and was not recreated"
trace $CLI registered-models get "$NEW_SCHEMA.mymodel" | jq '{full_name, created_at}'
trace $CLI bundle summary --output json | jq '.resources | map_values(map_values(.id))'

title "Redeploy is a no-op"
trace $CLI bundle plan
