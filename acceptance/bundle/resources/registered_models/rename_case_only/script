envsubst < databricks.yml.tmpl > databricks.yml

MODEL="main.test_schema_${UNIQUE_NAME}.mymodel"

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a model with a lowercase name"
trace $CLI bundle deploy
print_requests.py //unity-catalog &> LOG.deploy_requests
add_repl "$($CLI registered-models get "$MODEL" | jq -r .created_at)" MODEL_CREATED_AT

title "Change only the case of the name. UC lowercases names, so the rename keeps the model as it was"
trace update_file.py databricks.yml "name: mymodel" "name: MyModel"
# Drop the remote_state fields that differ between clouds or from the test server.
trace $CLI bundle plan --output json | jq .plan | normalize_uc_payload.py created_at updated_at updated_by metastore_id browse_only effective_predictive_optimization_flag storage_location
trace $CLI bundle deploy
trace print_requests.py //unity-catalog
trace $CLI registered-models get "$MODEL" | jq '{full_name, name, created_at}'

title "Redeploy"
trace $CLI bundle plan

title "Rename the schema. The model is re-keyed without a request. Its recorded ID keeps the config's casing, which UC reads case-insensitively"
trace update_file.py databricks.yml test_schema_ test_schema_renamed_
trace $CLI bundle deploy
trace print_requests.py //unity-catalog
trace $CLI bundle summary --output json | jq '.resources.registered_models.model1.id'
trace $CLI bundle plan
