echo "*" > .gitignore
envsubst < databricks.yml.tmpl > databricks.yml

MODEL="main.test-schema-${UNIQUE_NAME}.test-model-${UNIQUE_NAME}"

# print_requests.py consumes out.requests.txt, so it runs after the last request.
cleanup() {
    trace $CLI bundle destroy --auto-approve

    title "The UpdateRegisteredModel payloads the deploys sent"
    trace print_requests.py --method PATCH //unity-catalog/models
}
trap cleanup EXIT

title "Deploy with a comment"
trace $CLI bundle deploy

title "Remove the comment from the configuration and redeploy"
update_file.py databricks.yml 'comment: declared in the bundle' ''
trace $CLI bundle deploy

title "The comment the bundle no longer declares"
MSYS_NO_PATHCONV=1 trace $CLI api get "/api/2.1/unity-catalog/models/$MODEL" | jq '.comment'

title "Redeploy"
trace $CLI bundle plan
