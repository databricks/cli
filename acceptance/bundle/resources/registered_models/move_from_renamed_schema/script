envsubst < databricks.yml.tmpl > databricks.yml

RENAMED_MODEL="main.test-schema1-renamed-${UNIQUE_NAME}.mymodel"
NEW_MODEL="main.test-schema2-${UNIQUE_NAME}.mymodel"

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy two schemas and a registered model in the first one"
trace $CLI bundle deploy
print_requests.py //unity-catalog &> LOG.deploy_requests

title "Rename the first schema and move the model to the second one in one deploy. Moving the model recreates it"
trace update_file.py databricks.yml test-schema1- test-schema1-renamed-
trace update_file.py databricks.yml schemas.schema1.name schemas.schema2.name
# Drop the remote_state fields that differ between clouds or from the test server.
trace $CLI bundle plan --output json | tee .databricks/plan.json | jq .plan | normalize_uc_payload.py created_at updated_at updated_by metastore_id browse_only effective_predictive_optimization_flag storage_location
trace $CLI bundle deploy $(readplanarg .databricks/plan.json) --auto-approve
trace print_requests.py //unity-catalog

title "The model is in the second schema"
trace $CLI registered-models get "$NEW_MODEL" | jq '{full_name}'

title "The old model, moved with the renamed schema, was deleted there"
trace musterr $CLI registered-models get "$RENAMED_MODEL"

title "Redeploy is a no-op"
trace $CLI bundle plan
