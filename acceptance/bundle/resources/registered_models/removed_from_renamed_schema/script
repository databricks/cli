envsubst < databricks.yml.tmpl > databricks.yml

OLD_SCHEMA="main.test-schema-${UNIQUE_NAME}"
NEW_SCHEMA="main.test-schema-renamed-${UNIQUE_NAME}"

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a schema with a registered model in it, and rename the schema out of band"
trace $CLI bundle deploy
trace $CLI schemas update "$OLD_SCHEMA" --new-name "test-schema-renamed-${UNIQUE_NAME}" | schema_fields
print_requests.py //unity-catalog &> LOG.deploy_requests

title "Follow the rename in the config and remove the model from it: the model has no internal ID, but is found at its new path inside the bundle's schema"
envsubst < databricks-renamed-without-model.yml.tmpl > databricks.yml
trace $CLI bundle plan

title "Deploy deletes the model at its new path, and keeps the schema"
trace $CLI bundle deploy --auto-approve
trace print_requests.py //unity-catalog
trace musterr $CLI registered-models get "$NEW_SCHEMA.mymodel"
trace $CLI schemas get "$NEW_SCHEMA" | schema_fields
