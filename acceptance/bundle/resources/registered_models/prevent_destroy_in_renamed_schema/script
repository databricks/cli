envsubst < databricks.yml.tmpl > databricks.yml

OLD_SCHEMA="main.test-schema-${UNIQUE_NAME}"
NEW_SCHEMA="main.test-schema-renamed-${UNIQUE_NAME}"

cleanup() {
    errcode $CLI schemas delete "$NEW_SCHEMA" --force > LOG.cleanup 2>&1
    errcode $CLI schemas delete "$OLD_SCHEMA" --force >> LOG.cleanup 2>&1

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a schema with a registered model in it that must not be destroyed"
trace $CLI bundle deploy
print_requests.py //unity-catalog &> LOG.deploy_requests

title "Rename the schema and the model out of band"
trace $CLI schemas update "$OLD_SCHEMA" --new-name "test-schema-renamed-${UNIQUE_NAME}" | schema_fields
trace $CLI registered-models update "$NEW_SCHEMA.mymodel" --new-name mymodel2 | registered_model_fields
print_requests.py //unity-catalog &> LOG.rename_requests

title "The model has no internal ID and is not at its new path, but the schema's delete would take it, so destroy lists it and prevent_destroy stops it"
trace musterr $CLI bundle destroy --auto-approve
trace print_requests.py //unity-catalog
trace $CLI registered-models get "$NEW_SCHEMA.mymodel2" | registered_model_fields
