bundle:
  name: start-deployment-on-create-$UNIQUE_NAME

resources:
  apps:
    myapp:
      name: $UNIQUE_NAME
      source_code_path: ./app
      config:
        command: ["flask", "--app", "app", "run"]
        env:
          - name: FROM_BUNDLE_CONFIG
            value: "1"
      lifecycle:
        started: true
