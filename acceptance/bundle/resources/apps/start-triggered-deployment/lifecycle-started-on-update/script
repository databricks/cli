envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

# The source folder has no app.yaml: the inline config is the only place that says how to
# run the app.
title "Deploy with lifecycle.started=false: the app is created stopped and nothing is deployed to it"
trace $CLI bundle deploy

title "Deploy with lifecycle.started=true: the compute is started and the source is deployed with the inline config"
trace update_file.py databricks.yml "started: false" "started: true"
trace errcode $CLI bundle deploy
$CLI apps get $UNIQUE_NAME > LOG.app_after_deploy
trace $CLI apps get $UNIQUE_NAME | app_deployments
