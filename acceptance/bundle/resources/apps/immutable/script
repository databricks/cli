envsubst < databricks.yml.tmpl > databricks.yml

assert_dms_unsupported internal_immutable_snapshots

cleanup() {
    rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

trace $CLI bundle deploy
trace $CLI bundle run my_app

# Print the app requests to verify that source_code_path in the deployment
# points to the content-addressed snapshot path rather than a local path.
trace print_requests.py //apps
