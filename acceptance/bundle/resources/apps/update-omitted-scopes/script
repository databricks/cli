print_requests() {
    print_requests.py //apps '^//api/2.0/bundle' --del-body url
}

trace $CLI bundle deploy
trace print_requests > /dev/null

title "Out-of-band: set scopes on an app whose bundle does not declare any"
trace $CLI api post /api/2.0/apps/myappname/update --json '{"app": {"name": "myappname", "user_api_scopes": ["sql", "jobs"]}, "update_mask": "user_api_scopes"}' > /dev/null

title "Change description and re-deploy; user_api_scopes must not be in the update mask"
trace update_file.py databricks.yml my_app_description MY_APP_DESCRIPTION
trace $CLI bundle deploy
trace print_requests > out.requests.json
trace $CLI apps get myappname | jq '{description, user_api_scopes}'

trace $CLI bundle destroy --auto-approve
