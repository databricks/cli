envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

# --unique: appdeploy.Deploy retries POST .../deployments after waiting when the first
# attempt fails (e.g. a deployment is already in progress right after start), so on
# cloud the same request is occasionally recorded twice.

title "Deploy with started=true: app created with compute running"
trace $CLI bundle deploy
trace print_requests.py //apps --unique
rm -f "$OUT_REQUESTS"
trace $CLI apps get $UNIQUE_NAME | jq '.compute_status.state'

title "Re-deploy with description change: code deployed again"
trace update_file.py databricks.yml my_app_description MY_APP_DESCRIPTION
trace $CLI bundle deploy
trace print_requests.py //deployments ^//api/2.0/bundle --unique
rm -f "$OUT_REQUESTS"

title "Stop app externally while config says started=true: plan detects drift"
trace $CLI apps stop $UNIQUE_NAME | jq '.compute_status.state'
trace $CLI bundle plan

title "Deploy fixes the drift: compute restarted"
trace $CLI bundle deploy
rm -f "$OUT_REQUESTS"

title "Stop app externally, then deploy with started=false: app stays stopped"
trace $CLI apps stop $UNIQUE_NAME | jq '.compute_status.state'
trace update_file.py databricks.yml "started: true" "started: false"
trace update_file.py databricks.yml MY_APP_DESCRIPTION MY_APP_DESCRIPTION_2
trace $CLI bundle deploy
trace print_requests.py //apps --unique
rm -f "$OUT_REQUESTS"
trace $CLI apps get $UNIQUE_NAME | jq '.compute_status.state'

title "Deploy with started=true: compute restarted and code deployed"
trace update_file.py databricks.yml "started: false" "started: true"
trace update_file.py databricks.yml MY_APP_DESCRIPTION_2 MY_APP_DESCRIPTION_3
trace $CLI bundle deploy
trace print_requests.py //apps --unique
rm -f "$OUT_REQUESTS"
trace $CLI apps get $UNIQUE_NAME | jq '.compute_status.state'
