print_requests() {
    # url is output-only field that terraform adds but that is ignored by the backend
    print_requests.py //apps '^//api/2.0/bundle' --del-body url
}

title "Deploy with compute_size declared"
trace $CLI bundle deploy
trace print_requests > out.requests.json

title "Update description while compute_size is still declared"
trace update_file.py databricks.yml my_app_description MY_APP_DESCRIPTION
trace $CLI bundle deploy
trace print_requests >> out.requests.json

title "Remove compute_size and update description"
grep -v compute_size databricks.yml > databricks.yml.new
mv databricks.yml.new databricks.yml
trace update_file.py databricks.yml MY_APP_DESCRIPTION MY_APP_DESCRIPTION_2
trace $CLI bundle plan
trace $CLI bundle deploy
trace print_requests >> out.requests.json
