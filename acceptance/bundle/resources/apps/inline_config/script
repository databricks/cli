envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

trace $CLI bundle deploy

APP_NAME=$($CLI bundle summary -o json | jq -r '.resources.apps.myapp.name')
# Route the progress output and the dynamic app URL to a log so output.txt stays stable;
# unlike /dev/null, the harness prints LOG.* files, so a failed run shows its error.
$CLI bundle run myapp &> LOG.run_app

DEPLOYMENT_ID=$($CLI apps get "$APP_NAME" | jq -r '.active_deployment.deployment_id')
add_repl "$DEPLOYMENT_ID" DEPLOYMENT_ID

trace $CLI apps get-deployment "$APP_NAME" "$DEPLOYMENT_ID" | jq '{command, env_vars}'
