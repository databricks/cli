{
  "method": "POST",
  "path": "/api/2.0/apps",
  "q": {
    "no_compute": "true"
  },
  "body": {
    "name": "myappname",
    "description": "my_app_description"
  }
}
{
  "method": "POST",
  "path": "/api/2.0/apps/myappname/update",
  "body": {
    "app": {
      "name": "myappname",
      "description": "MY_APP_DESCRIPTION"
    },
    "update_mask": "budget_policy_id,compute_max_instances,compute_min_instances,compute_size,description,git_repository,resources,telemetry_export_destinations,usage_policy_id,user_api_scopes",
    "app_name": "myappname"
  }
}
{
  "method": "DELETE",
  "path": "/api/2.0/apps/myappname"
}
{
  "method": "POST",
  "path": "/api/2.0/apps",
  "q": {
    "no_compute": "true"
  },
  "body": {
    "name": "mynewappname",
    "description": "MY_APP_DESCRIPTION"
