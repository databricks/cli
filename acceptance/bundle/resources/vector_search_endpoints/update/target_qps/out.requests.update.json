{
  "method": "PATCH",
  "path": "/api/2.0/vector-search/endpoints/vs-endpoint-[UNIQUE_NAME]",
  "body": {
    "name": "vs-endpoint-[UNIQUE_NAME]",
    "target_qps": 2
  }
}
{
  "method": "PUT",
  "path": "/api/2.0/permissions/vector-search-endpoints/[UUID]",
  "body": {
    "request_object_type": "vector-search-endpoints",
    "request_object_id": "[UUID]",
    "access_control_list": [
      {
        "group_name": "admins",
        "permission_level": "CAN_USE"
      },
      {
        "user_name": "[USERNAME]",
        "permission_level": "CAN_MANAGE"
      }
    ]
  }
}
