envsubst < databricks.yml.tmpl > databricks.yml

ENDPOINT="vs-endpoint-$UNIQUE_NAME"

cleanup() {
    # Whatever destroy left behind.
    errcode $CLI bundle destroy --auto-approve > LOG.cleanup 2>&1
    errcode $CLI vector-search-endpoints delete-endpoint "$ENDPOINT" >> LOG.cleanup 2>&1
    rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

title "Outside the bundle, create an endpoint with the name the bundle uses, but of another endpoint_type"
trace $CLI vector-search-endpoints create-endpoint "$ENDPOINT" STORAGE_OPTIMIZED --no-wait | jq '{name, endpoint_type}'

title "The bundle's create request fails with a 504 that the backend did not apply: deploy takes the endpoint"
fault.py "POST /api/2.0/vector-search/endpoints" 504 0 1 TEMPORARILY_UNAVAILABLE
trace $CLI bundle deploy

title "The next deploy would delete the endpoint and create one of the bundle's type"
trace $CLI bundle plan
