bundle:
  name: remove-is-protected-$UNIQUE_NAME

sync:
  paths: []

resources:
  postgres_projects:
    my_project:
      project_id: test-pg-proj-$UNIQUE_NAME
      display_name: "Test Project for Branch Protection Removal"
      pg_version: 16
      history_retention_duration: 604800s

  postgres_branches:
    main:
      parent: ${resources.postgres_projects.my_project.id}
      branch_id: main
      no_expiry: true
      is_protected: true
