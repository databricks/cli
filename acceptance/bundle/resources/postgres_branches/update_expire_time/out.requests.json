{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]",
  "q": {
    "update_mask": "spec.display_name"
  },
  "body": {
    "spec": {
      "display_name": "Test Project for Branch Expire Update",
      "pg_version": 16
    }
  }
}
{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]/branches/dev-branch",
  "q": {
    "update_mask": "spec.expiration"
  },
  "body": {
    "spec": {
      "expire_time": "[EXPIRE_TIME_AFTER]"
    }
  }
}
