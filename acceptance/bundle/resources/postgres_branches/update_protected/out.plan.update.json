{
  "depends_on": [
    {
      "node": "resources.postgres_projects.my_project",
      "label": "${resources.postgres_projects.my_project.id}"
    }
  ],
  "action": "update",
  "new_state": {
    "value": {
      "branch_id": "dev-branch",
      "is_protected": true,
      "no_expiry": true,
      "parent": "projects/test-pg-proj-[UNIQUE_NAME]"
    }
  },
  "changes": {
    "is_protected": {
      "action": "update",
      "old": false,
      "new": true,
      "remote": false
    }
  }
}
