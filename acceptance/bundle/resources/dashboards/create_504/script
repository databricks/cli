# dashboards/test.toml sets MSYS_NO_PATHCONV, which keeps Python from finding these helpers on
# Windows; see the same workaround in acceptance/script.prepare.
fault.py() { env -u MSYS_NO_PATHCONV "$(type -P fault.py)" "$@"; }
print_requests.py() { env -u MSYS_NO_PATHCONV "$(type -P print_requests.py)" "$@"; }

title "The create request times out but the dashboard was created: deploy uses the dashboard"
# The first read of a new dashboard returns 404 (INJECT_STALE_ON_DIRECT), so the deploy repeats
# the create, gets ALREADY_EXISTS, and finds the dashboard on the next look.
fault.py --after-handler "POST /api/2.0/lakeview/dashboards" 504 0 1 DEADLINE_EXCEEDED
trace $CLI bundle deploy
trace print_requests.py --get //lakeview //workspace/get-status | jq -r 'select(.path != "/api/2.0/workspace/get-status" or (.q.path | endswith(".lvdash.json"))) | .method + " " + .path + (if .q.path then " " + .q.path else "" end)' | sed -E 's/[0-9a-f]{32}/[DASHBOARD_ID]/'
$CLI bundle destroy --auto-approve > /dev/null 2>&1
rm -f "$OUT_REQUESTS"

title "The create request times out and the dashboard was not created: deploy repeats the create"
fault.py "POST /api/2.0/lakeview/dashboards" 504 0 1 DEADLINE_EXCEEDED
trace $CLI bundle deploy
trace print_requests.py --get //lakeview //workspace/get-status | jq -r 'select(.path != "/api/2.0/workspace/get-status" or (.q.path | endswith(".lvdash.json"))) | .method + " " + .path + (if .q.path then " " + .q.path else "" end)' | sed -E 's/[0-9a-f]{32}/[DASHBOARD_ID]/'
$CLI bundle destroy --auto-approve > /dev/null 2>&1
rm -f "$OUT_REQUESTS"
