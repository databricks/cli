export DASHBOARD_DISPLAY_NAME="test bundle-deploy-dashboard $UNIQUE_NAME)"

if [ -z "$CLOUD_ENV" ]; then
    export TEST_DEFAULT_WAREHOUSE_ID="warehouse-1234"
    add_repl "warehouse-1234" TEST_DEFAULT_WAREHOUSE_ID
fi

envsubst < databricks.yml.tmpl > databricks.yml

# Deploy the dashboard
trace $CLI bundle deploy
DASHBOARD_ID=$($CLI bundle summary --output json | jq -r '.resources.dashboards.dashboard1.id')

# Capture the dashboard ID as a replacement.
add_repl "$DASHBOARD_ID" DASHBOARD_ID
DASHBOARD=$(retry $CLI lakeview get $DASHBOARD_ID)
add_repl "$(echo "$DASHBOARD" | jq -r '.etag')" ETAG

# Verify dashboard was deployed
echo "$DASHBOARD" | jq '{lifecycle_state, parent_path}'

# Trash the dashboard out of band (simulating external deletion)
# This should succeed
trace $CLI lakeview trash $DASHBOARD_ID

trace $CLI bundle plan

trace $CLI bundle plan -o json | nostamp.py > out.plan.$DATABRICKS_BUNDLE_ENGINE.json

# Run destroy - should succeed even though dashboard is already trashed.
# -qq drops the summary: terraform refreshes the trashed dashboard away and reports
# "0 deleted" while direct still counts it as "1 deleted".
trace $CLI bundle destroy --auto-approve -qq
