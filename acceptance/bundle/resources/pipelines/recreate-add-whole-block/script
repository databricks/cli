touch foo.py

# The ingestion_definition block is commented out in the template with #TO_ADD:
# markers, so phase 1 deploys a pipeline without it.
envsubst < databricks.yml.tmpl > databricks.yml
trace cat databricks.yml
trace $CLI bundle deploy

# Phase 2: add the whole ingestion_definition block by dropping the #TO_ADD:
# markers. connection_name is immutable, so adding it must recreate the pipeline.
trace update_file.py databricks.yml "#TO_ADD: " ""
trace cat databricks.yml

# BUG: prints "update pipelines.my"; should print "recreate pipelines.my".
trace $CLI bundle plan
$CLI bundle plan -o json | nostamp > out.plan.$DATABRICKS_BUNDLE_ENGINE.json

rm -f out.requests.txt
