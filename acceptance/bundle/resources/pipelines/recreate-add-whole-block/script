touch foo.py

# Phase 1: deploy a pipeline WITHOUT ingestion_definition.
envsubst > databricks.yml <<'EOF'
bundle:
  name: acc-$UNIQUE_NAME

resources:
  pipelines:
    my:
      name: test-pipeline-$UNIQUE_NAME
      storage: dbfs:/pipelines/custom
      libraries:
        - file:
            path: "./foo.py"
EOF

trace cat databricks.yml
trace $CLI bundle deploy

# Phase 2: add the whole ingestion_definition block. connection_name is
# immutable, so adding it must recreate the pipeline.
envsubst > databricks.yml <<'EOF'
bundle:
  name: acc-$UNIQUE_NAME

resources:
  pipelines:
    my:
      name: test-pipeline-$UNIQUE_NAME
      storage: dbfs:/pipelines/custom
      ingestion_definition:
        connection_name: my_connection
        objects:
          - {}
      libraries:
        - file:
            path: "./foo.py"
EOF

trace cat databricks.yml

# BUG: prints "update pipelines.my"; should print "recreate pipelines.my".
trace $CLI bundle plan
$CLI bundle plan -o json | nostamp > out.plan.$DATABRICKS_BUNDLE_ENGINE.json

rm -f out.requests.txt
