trace $CLI bundle deploy

# Register [POL_ID] and [J_ID] so the resolved references are deterministic.
replace_ids.py

title "Deploy requests in dependency order: policy create precedes job create, job carries resolved policy id"
trace print_requests.py //policies/clusters //jobs --nostamp

title "Update both the policy and the job"
trace update_file.py databricks.yml my_policy my_policy_2
trace update_file.py databricks.yml my_job my_job_2
trace $CLI bundle deploy
trace print_requests.py //policies/clusters //jobs --nostamp

title "Destroy: job delete precedes policy delete"
trace $CLI bundle destroy --auto-approve
trace print_requests.py //policies/clusters //jobs --nostamp
