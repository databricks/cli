envsubst < databricks.yml.tmpl > databricks.yml

trace $CLI bundle validate -o json | jq ".resources.cluster_policies"

cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm -f out.requests.txt
}
trap cleanup EXIT
trace $CLI bundle deploy

title "Create bodies carry policy_family_id and overrides as a JSON string (YAML normalized, JSON preserved)"
trace print_requests.py //policies/clusters/create --sort
