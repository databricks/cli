envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm "$OUT_REQUESTS"
}
trap cleanup EXIT

title "create the secret scope"
trace $CLI bundle deploy -qq

grep -v DELETE < databricks.yml > databricks.yml.tmp && mv databricks.yml.tmp databricks.yml

trace $CLI bundle plan &> out.plan.$DATABRICKS_BUNDLE_ENGINE.txt
rm "$OUT_REQUESTS"

trace $CLI bundle deploy -qq
trace print_requests.py '^//api/2.0/bundle' '^//import-file/' '^//workspace/' '^//telemetry-ext' &> out.deploy.requests.txt
