envsubst < databricks.yml.tmpl > databricks.yml
export BUNDLE_VAR_secret_value=secret-value

OLD_SCHEMA="main.test-schema-${UNIQUE_NAME}"
NEW_SCHEMA="main.test-schema-renamed-${UNIQUE_NAME}"

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a schema with a secret in it"
trace $CLI bundle deploy
print_requests.py //unity-catalog &> LOG.deploy_requests

title "Rename the schema out of band. UC moves the secret with it"
trace $CLI schemas update "$OLD_SCHEMA" --new-name "test-schema-renamed-${UNIQUE_NAME}" | jq '{full_name}'
print_requests.py //unity-catalog &> LOG.rename_requests

title "With the config renamed to match, the plan finds the schema by its schema_id. A secret has no such id, so the plan creates it again"
trace update_file.py databricks.yml test-schema- test-schema-renamed-
trace $CLI bundle plan

title "The create fails: the secret is already there"
trace musterr $CLI bundle deploy
trace print_requests.py //unity-catalog
trace $CLI secrets-uc get-secret "$NEW_SCHEMA.mysecret" | jq '{full_name}'
