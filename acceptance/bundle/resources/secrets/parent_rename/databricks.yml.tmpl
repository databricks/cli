bundle:
  name: test-bundle-$UNIQUE_NAME

variables:
  secret_value:
    description: The secret's value

resources:
  catalogs:
    catalog1:
      name: test_catalog_$UNIQUE_NAME
  schemas:
    schema1:
      catalog_name: ${resources.catalogs.catalog1.name}
      name: myschema
  secrets:
    secret1:
      catalog_name: ${resources.catalogs.catalog1.name}
      schema_name: ${resources.schemas.schema1.name}
      name: mysecret
      value: ${var.secret_value}
      comment: c1
