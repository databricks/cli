envsubst < databricks.yml.tmpl > databricks.yml
export BUNDLE_VAR_secret_value=secret-value

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

# Drop the remote_state fields that differ between clouds or from the test server.
plan() {
    trace $CLI bundle plan --output json | tee .databricks/plan.json | jq .plan | normalize_uc_payload.py created_at updated_at updated_by metastore_id browse_only effective_predictive_optimization_flag enable_predictive_optimization isolation_mode securable_type
}

title "Deploy a catalog with a schema and a secret in it"
trace $CLI bundle deploy
trace print_requests.py //unity-catalog
add_repl "$($CLI secrets-uc get-secret "test_catalog_${UNIQUE_NAME}.myschema.mysecret" | jq -r .create_time)" SECRET_CREATE_TIME

title "Rename the schema: UC moves the secret with it, so the secret is re-keyed without a request"
trace update_file.py databricks.yml "name: myschema" "name: myschema2"
plan
trace $CLI bundle deploy $(readplanarg .databricks/plan.json)
trace print_requests.py //unity-catalog
trace $CLI secrets-uc get-secret "test_catalog_${UNIQUE_NAME}.myschema2.mysecret" | jq '{full_name, comment, create_time}'

title "Rename the catalog and change the secret's comment: the update reaches the secret at its new path"
trace update_file.py databricks.yml test_catalog_ test_catalog_renamed_
trace update_file.py databricks.yml "comment: c1" "comment: c2"
plan
trace $CLI bundle deploy $(readplanarg .databricks/plan.json)
trace print_requests.py //unity-catalog
trace $CLI secrets-uc get-secret "test_catalog_renamed_${UNIQUE_NAME}.myschema2.mysecret" | jq '{full_name, comment, create_time}'

title "The state tracks the new path and the plan is a no-op"
trace $CLI bundle summary --output json | jq '.resources | map_values(map_values(.id))'
trace $CLI bundle plan
