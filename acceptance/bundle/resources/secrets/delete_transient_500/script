trace $CLI bundle deploy

# In each phase below, the first delete lands but every attempt answers 500, so the retries run
# out on an error. The read that follows finds the secret gone, so the delete counts as done,
# without a warning.

title "Recreate: renaming the secret deletes the old one first"
fault.py --after-handler "DELETE /api/2.1/unity-catalog/secrets/*" 500 0 3 INTERNAL_ERROR
update_file.py databricks.yml "name: test_secret" "name: test_secret2"
trace $CLI bundle deploy --auto-approve

# Three delete requests (the first one deleted the secret, the retries got 500), the GET that
# confirms it is gone, then the create.
trace print_requests.py --get --summary //unity-catalog/secrets

title "Destroy"
fault.py --after-handler "DELETE /api/2.1/unity-catalog/secrets/*" 500 0 3 INTERNAL_ERROR
trace $CLI bundle destroy --auto-approve

trace print_requests.py --get --summary //unity-catalog/secrets
