envsubst < databricks.yml.tmpl > databricks.yml
export BUNDLE_VAR_secret_value=secret-value

CATALOG="test_catalog_${UNIQUE_NAME}"

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

# Drop the remote_state fields that differ between clouds or from the test server.
plan() {
    trace $CLI bundle plan --output json | tee .databricks/plan.json | jq .plan | normalize_uc_payload.py created_at updated_at updated_by metastore_id browse_only effective_predictive_optimization_flag enable_predictive_optimization isolation_mode securable_type
}

title "Deploy a catalog with a schema and a secret in it"
trace $CLI bundle deploy
print_requests.py //unity-catalog &> LOG.deploy_requests
add_repl "$($CLI secrets-uc get-secret "$CATALOG.myschema.mysecret" | jq -r .create_time)" OLD_SECRET_CREATE_TIME

title "Rename the schema and the secret in one deploy. UC cannot rename a secret, so the secret is recreated"
trace update_file.py databricks.yml "name: myschema" "name: myschema2"
trace update_file.py databricks.yml "name: mysecret" "name: mysecret2"
plan
trace $CLI bundle deploy $(readplanarg .databricks/plan.json) --auto-approve
trace print_requests.py //unity-catalog

title "The new secret is in the renamed schema"
trace $CLI secrets-uc get-secret "$CATALOG.myschema2.mysecret2" | jq '{full_name}'

title "The old secret, moved with the renamed schema, was deleted there"
trace musterr $CLI secrets-uc get-secret "$CATALOG.myschema2.mysecret"

title "Redeploy is a no-op"
trace $CLI bundle plan
