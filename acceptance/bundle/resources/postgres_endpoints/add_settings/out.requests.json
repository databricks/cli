{
  "method": "DELETE",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]/branches/main/endpoints/my-endpoint"
}
{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]",
  "q": {
    "update_mask": "spec.display_name,spec.history_retention_duration"
  },
  "body": {
    "spec": {
      "display_name": "Test Project for Endpoint settings Add",
      "history_retention_duration": "604800s",
      "pg_version": 16
    }
  }
}
{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]/branches/main",
  "q": {
    "update_mask": "spec.expiration"
  },
  "body": {
    "spec": {
      "no_expiry": true
    }
  }
}
{
  "method": "POST",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]/branches/main/endpoints",
  "q": {
    "endpoint_id": "my-endpoint"
  },
  "body": {
    "spec": {
      "autoscaling_limit_max_cu": 8,
      "autoscaling_limit_min_cu": 0.5,
      "endpoint_type": "ENDPOINT_TYPE_READ_ONLY",
      "settings": {
        "pg_settings": {
          "statement_timeout": "8000"
        }
      }
    }
  }
}
