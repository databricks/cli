envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
   trace $CLI bundle destroy --auto-approve
   rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

endpoint_name="projects/test-pg-proj-${UNIQUE_NAME}/branches/main/endpoints/my-endpoint"

title "Initial deployment with suspend_timeout_duration: 300s"
trace $CLI bundle deploy
rm -f "$OUT_REQUESTS"
trace $CLI postgres get-endpoint "${endpoint_name}" | endpoint_fields

title "Remove suspend_timeout_duration and restore the default"
trace update_file.py databricks.yml '      suspend_timeout_duration: "300s"' ""

trace $CLI bundle plan
trace $CLI bundle plan -o json | nostamp | jq '.plan."resources.postgres_endpoints.my_endpoint" | {action, changes}' > out.plan.$DATABRICKS_BUNDLE_ENGINE.json
rm -f "$OUT_REQUESTS"
trace $CLI bundle deploy
trace print_requests.py --del-body project_id,branch_id,endpoint_id --sort '//postgres' '^//workspace-files/' '^//workspace/' '^//telemetry-ext' '^//operations/' > out.requests.$DATABRICKS_BUNDLE_ENGINE.json

# The documented default converges the existing suspension oneof; a second plan
# is clean for both engines.
trace $CLI postgres get-endpoint "${endpoint_name}" | endpoint_fields
trace $CLI bundle plan &> out.plan.drift.$DATABRICKS_BUNDLE_ENGINE.txt
trace $CLI bundle plan -o json | nostamp | jq -e '[.plan[] | select(.action != "skip")] | length == 0'
