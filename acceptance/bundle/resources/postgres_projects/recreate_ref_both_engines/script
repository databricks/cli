envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

title "Initial deployment"
trace $CLI bundle deploy
rm -f "$OUT_REQUESTS"   # drop create requests; capture only the recreate below

# pg_version is spec:immutable, so BOTH engines recreate the project on a bump. project_id
# (hence the project name "projects/{project_id}") is unchanged, so my_catalog.branch --
# built from ${my_project.name} -- resolves to the same value: the catalog does not change.
title "Bump pg_version: recreates the project; project_id and name are unchanged"
trace update_file.py databricks.yml "pg_version: 16" "pg_version: 17"

# PLANNED (identical on both engines): neither engine can resolve ${my_project.name} for a
# project being recreated (a recreate does not preserve the id), so both diff the saved
# branch against the literal "${...}" placeholder and plan a spurious recreate of the
# catalog alongside the project. The catalog's branch value never actually changes.
title "Plan"
trace $CLI bundle plan

# WHAT ACTUALLY HAPPENED: both engines perform a real delete + create of the catalog. Deploy
# stdout goes to LOG.deploy (parallel completion order is nondeterministic, so it is not a
# golden); the API calls are recorded per engine. out.requests.* shows the DELETE + POST
# issued against the catalog with an identical, unchanged spec -- a destructive recreate of a
# resource that did not change. The two engines send project_id/catalog_id differently (query
# string vs body), which is why the request files differ.
title "Deploy the recreate and record per-engine requests (see out.requests.*)"
$CLI bundle deploy --auto-approve &> LOG.deploy
trace print_requests.py --sort '//postgres' > out.requests.$DATABRICKS_BUNDLE_ENGINE.txt
