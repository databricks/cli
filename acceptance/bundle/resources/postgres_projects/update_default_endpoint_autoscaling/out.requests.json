{
  "method": "PATCH",
  "path": "/api/2.0/postgres/projects/test-pg-proj-[UNIQUE_NAME]",
  "q": {
    "update_mask": "spec.default_endpoint_settings.autoscaling_limit_max_cu"
  },
  "body": {
    "name": "projects/test-pg-proj-[UNIQUE_NAME]",
    "spec": {
      "display_name": "Test Project for Default Endpoint Autoscaling",
      "pg_version": 16,
      "history_retention_duration": "604800s",
      "default_endpoint_settings": {
        "autoscaling_limit_min_cu": 0.5,
        "autoscaling_limit_max_cu": 8
      }
    }
  }
}
