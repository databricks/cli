trace $CLI bundle deploy

# The delete lands but the response is a transient 500. The retry gets a NotFound, which counts as
# deleted, so the destroy succeeds.
fault.py --after-handler "DELETE /api/2.0/postgres/projects/*" 500 0 1 INTERNAL_ERROR

trace $CLI bundle destroy --auto-approve

# Two delete requests: the one that landed and the retry.
trace print_requests.py --method DELETE --summary //postgres
