envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
   trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

title "Initial deployment with no default_endpoint_settings block"
trace $CLI bundle deploy

title "Add the whole default_endpoint_settings block and re-deploy"
trace update_file.py databricks.yml "#TO_ADD: " ""

# The direct plan's "changes" map is the structdiff artifact: it records one
# change at path default_endpoint_settings (the whole block) instead of descending
# to its leaves. (The top-level plan verdict is 'update'.)
$CLI bundle plan -o json | plan_filter.py > out.plan.json

# The consequence shows up at deploy time: masking the whole message means the API
# requires the suspension oneof in the body (see dresources/util.go), so the deploy
# FAILS with a 400.
errcode $CLI bundle deploy > out.deploy.txt 2>&1
