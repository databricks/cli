bundle:
  name: remove-default-pg-settings-key-$UNIQUE_NAME

sync:
  paths: []

resources:
  postgres_projects:
    my_project:
      project_id: test-pg-proj-$UNIQUE_NAME
      display_name: "Test Project for Default pg_settings Key Removal"
      pg_version: 16
      history_retention_duration: 604800s
      default_endpoint_settings:
        pg_settings:
          statement_timeout: "8000"
          lock_timeout: "5000"
