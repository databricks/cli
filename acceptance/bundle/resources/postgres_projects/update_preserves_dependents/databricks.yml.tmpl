bundle:
  name: project-reference-update-$UNIQUE_NAME

sync:
  paths: []

resources:
  postgres_projects:
    project:
      project_id: reference-update-$UNIQUE_NAME
      display_name: Original project name

  postgres_catalogs:
    catalog:
      catalog_id: reference_update_$UNIQUE_NAME
      branch: ${resources.postgres_projects.project.name}/branches/production
      postgres_database: appdb
      create_database_if_missing: true

  postgres_roles:
    reader:
      parent: ${resources.postgres_projects.project.name}/branches/production
      role_id: reader
      postgres_role: app_reader
