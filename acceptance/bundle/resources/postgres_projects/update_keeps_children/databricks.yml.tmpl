bundle:
  name: update-keeps-children-$UNIQUE_NAME

sync:
  paths: []

# Children wire themselves to the project/branch via ${...name}, the idiomatic
# pattern used throughout acceptance/bundle/invariant/configs/postgres_*.yml.tmpl.
# Both parent fields are immutable id_fields, so a spurious diff on the .name
# reference would recreate the child. Regression for ES-2202624.
resources:
  postgres_projects:
    my_project:
      project_id: test-pg-proj-$UNIQUE_NAME
      display_name: "Original Name"
      pg_version: 16

  postgres_branches:
    my_branch:
      parent: ${resources.postgres_projects.my_project.name}
      branch_id: test-branch
      no_expiry: true

  postgres_roles:
    my_role:
      parent: ${resources.postgres_branches.my_branch.name}
      role_id: test-role
      postgres_role: app_role
