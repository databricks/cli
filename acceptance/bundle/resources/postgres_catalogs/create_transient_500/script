title "The create request fails with 500 but the catalog was created: deploy uses the catalog"
fault.py --after-handler "POST /api/2.0/postgres/catalogs" 500 0 1 INTERNAL_ERROR
trace $CLI bundle deploy
trace print_requests.py --get //postgres/catalogs | jq -r '.method + " " + .path'
$CLI bundle destroy --auto-approve &> LOG.destroy
rm -f "$OUT_REQUESTS"

title "The create request times out and the catalog was not created: deploy repeats the create"
fault.py "POST /api/2.0/postgres/catalogs" 504 0 1 DEADLINE_EXCEEDED
trace $CLI bundle deploy
trace print_requests.py --get //postgres/catalogs | jq -r '.method + " " + .path'
$CLI bundle destroy --auto-approve &> LOG.destroy
rm -f "$OUT_REQUESTS"

title "The catalog cannot be read after the create request fails: deploy fails with the create error"
fault.py "POST /api/2.0/postgres/catalogs" 500 0 1 INTERNAL_ERROR
fault.py "GET /api/2.0/postgres/catalogs/lakebase_test" 403 0 1 PERMISSION_DENIED
trace musterr $CLI bundle deploy
trace print_requests.py --get //postgres/catalogs | jq -r '.method + " " + .path'
$CLI bundle destroy --auto-approve &> LOG.destroy
