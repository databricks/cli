cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm -f out.requests.txt
}
trap cleanup EXIT

# The workspace starts the run and the response is replaced by a 503, which is what
# the client sees when a response is lost on the way back. The SDK retries that
# status, so run-now is sent a second time while the first run already exists.
fault.py --after-handler "POST /api/2.2/jobs/run-now" 503 0 1

title "the deploy succeeds, though its run-now was answered with a 503"
trace $CLI bundle deploy

title "run-now was sent twice, both times with the same token"
trace read_id.py my_job
trace print_requests.py //jobs/run-now

title "the second request was answered with the run the first one started"
trace read_id.py my_run
# Without the token the resend would have started a run of its own, which the deploy
# would not have recorded and destroy would have left behind.
trace $CLI jobs list-runs -o json | jq length
