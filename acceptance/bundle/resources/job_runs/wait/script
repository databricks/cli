envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    destroy-bundle
}
trap cleanup EXIT

title "the deploy waits for the run to finish"
trace $CLI bundle deploy

trace read_id.py my_run

title "the downstream job was created with the run's result_state"
downstream_id=$(read_id.py downstream_job)
trace $CLI jobs get $downstream_id -o json | jq -r ".settings.tags.run_result"

title "nothing the run resolved is drift, so a redeploy starts no new run"
trace $CLI bundle plan -o json | jq -r '.plan | to_entries[] | "\(.key) \(.value.action)"'
trace $CLI bundle deploy
