cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm -f out.requests.txt
}
trap cleanup EXIT

# The run's only task fails, so the deploy aborts here: the error names the
# failed task and points at rerun_token as the way to retry. downstream_job
# depends on my_run and is reported as "dependency failed" rather than created.
title "a run that finishes FAILED fails the deploy"
musterr trace $CLI bundle deploy
