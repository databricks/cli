title "The create request times out but the endpoint was created: deploy uses the endpoint"
fault.py --after-handler "POST /api/2.0/serving-endpoints" 504 0 1 DEADLINE_EXCEEDED
trace $CLI bundle deploy
trace print_requests.py --get //serving-endpoints | jq -r '.method + " " + .path'
$CLI bundle destroy --auto-approve > /dev/null 2>&1
rm -f "$OUT_REQUESTS"

title "The create request times out and the endpoint was not created: deploy repeats the create"
fault.py "POST /api/2.0/serving-endpoints" 504 0 1 DEADLINE_EXCEEDED
trace $CLI bundle deploy
trace print_requests.py --get //serving-endpoints | jq -r '.method + " " + .path'
$CLI bundle destroy --auto-approve > /dev/null 2>&1
rm -f "$OUT_REQUESTS"
