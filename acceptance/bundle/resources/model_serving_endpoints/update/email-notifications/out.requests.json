{
  "method": "POST",
  "path": "/api/2.0/serving-endpoints",
  "body": {
    "name": "[ENDPOINT_ID]",
    "config": {
      "served_entities": [
        {
          "name": "prod",
          "external_model": {
            "provider": "openai",
            "name": "gpt-4o-mini",
            "task": "llm/v1/chat",
            "openai_config": {
              "openai_api_key": "{{secrets/test-scope/openai-key}}"
            }
          }
        }
      ]
    },
    "email_notifications": {
      "on_update_success": [
        "user1@example.com"
      ]
    }
  }
}
{
  "method": "PATCH",
  "path": "/api/2.0/serving-endpoints/[ENDPOINT_ID]/notifications",
  "body": {
    "name": "[ENDPOINT_ID]",
    "email_notifications": {
      "on_update_success": [
        "user2@example.com"
      ]
    }
  }
}
