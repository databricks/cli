envsubst < databricks.yml.tmpl > databricks.yml

OLD_SCHEMA="main.test-schema-${UNIQUE_NAME}"
OLD_VOLUME="$OLD_SCHEMA.myvolume"
NEW_VOLUME="main.test-schema-renamed-${UNIQUE_NAME}.myvolume"

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a schema with a volume in it"
trace $CLI bundle deploy
trace print_requests.py //unity-catalog
VOLUME_ID=$($CLI volumes read "$OLD_VOLUME" | jq -r .volume_id)

title "Rename the schema"
trace update_file.py databricks.yml test-schema- test-schema-renamed-

title "UC moves the volume with the schema, so the plan re-keys the volume instead of recreating it"
trace $CLI bundle plan
trace $CLI bundle plan --output json | nostamp | jq '.plan | map_values(.changes | with_entries(select(.value.action != "skip")))'

title "Deploy renames the schema and updates the volume at its new path"
trace $CLI bundle deploy
trace print_requests.py //unity-catalog

title "The old schema is gone and the volume is under the new one"
trace musterr $CLI schemas get "$OLD_SCHEMA"
trace $CLI volumes read "$NEW_VOLUME" | jq '{full_name, schema_name}'

title "The volume_id is preserved, so this is the same volume\n"
if [ "$($CLI volumes read "$NEW_VOLUME" | jq -r .volume_id)" = "$VOLUME_ID" ]; then
    echo "volume_id is unchanged"
else
    echo "volume_id changed"
fi

title "The state tracks the new path"
trace $CLI bundle summary --output json | jq '.resources.volumes.volume1.id'

title "Redeploy is a no-op"
trace $CLI bundle plan
trace $CLI bundle deploy
trace print_requests.py //unity-catalog
