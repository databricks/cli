envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace errcode $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a schema with a lowercase name"
trace $CLI bundle deploy
print_requests.py //unity-catalog &> LOG.deploy_requests
add_repl "$($CLI schemas get "main.test_schema_${UNIQUE_NAME}" | jq -r .schema_id)" SCHEMA_ID

title "Change only the case of the name. UC lowercases names, so it is the same name"
trace update_file.py databricks.yml test_schema_ Test_Schema_
# Drop the remote_state fields that differ between clouds or from the test server.
trace $CLI bundle plan --output json | jq .plan | normalize_uc_payload.py updated_at updated_by effective_predictive_optimization_flag
trace errcode $CLI bundle deploy
trace print_requests.py //unity-catalog
trace $CLI schemas get "main.test_schema_${UNIQUE_NAME}" | jq '{full_name, name, schema_id}'

title "Redeploy"
trace $CLI bundle plan
