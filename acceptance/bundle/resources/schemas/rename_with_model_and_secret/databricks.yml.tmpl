bundle:
  name: test-bundle-$UNIQUE_NAME

variables:
  secret_value:
    description: The secret's value

resources:
  schemas:
    schema1:
      catalog_name: main
      name: test-schema-$UNIQUE_NAME
  registered_models:
    model1:
      catalog_name: main
      schema_name: ${resources.schemas.schema1.name}
      name: mymodel
  secrets:
    secret1:
      catalog_name: main
      schema_name: ${resources.schemas.schema1.name}
      name: mysecret
      value: ${var.secret_value}
