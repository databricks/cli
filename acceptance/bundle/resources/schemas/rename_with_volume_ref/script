envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy a schema, a volume in it and a job that reads the volume's full_name and id"
trace $CLI bundle deploy
print_requests.py //unity-catalog &> LOG.deploy_requests
JOB_ID=$($CLI bundle summary --output json | jq -r .resources.jobs.job1.id)
add_repl "$JOB_ID" JOB_ID
add_repl "$($CLI volumes read "main.test-schema-${UNIQUE_NAME}.myvolume" | jq -r .volume_id)" VOLUME_ID
trace $CLI jobs get "$JOB_ID" | jq .settings.parameters

title "Rename the schema"
trace update_file.py databricks.yml test-schema- test-schema-renamed-

title "The volume's full_name and id change with the schema, so the job is updated too"
trace $CLI bundle plan

title "Deploy passes the volume's new full_name and id to the job"
trace $CLI bundle deploy
trace print_requests.py //unity-catalog
trace $CLI jobs get "$JOB_ID" | jq .settings.parameters

title "Redeploy is a no-op"
trace $CLI bundle plan
