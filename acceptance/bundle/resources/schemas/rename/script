envsubst < databricks.yml.tmpl > databricks.yml

OLD_SCHEMA="main.test-schema-${UNIQUE_NAME}"
NEW_SCHEMA="main.test-schema-renamed-${UNIQUE_NAME}"

cleanup() {
    trace $CLI bundle destroy --auto-approve

    # Consume the destroy's requests so none are left recorded.
    print_requests.py //unity-catalog &> LOG.destroy_requests
}
trap cleanup EXIT

title "Deploy the schema"
trace $CLI bundle deploy
trace print_requests.py //unity-catalog
add_repl "$($CLI schemas get "$OLD_SCHEMA" | jq -r .schema_id)" SCHEMA_ID

title "Rename the schema"
trace update_file.py databricks.yml test-schema- test-schema-renamed-

title "The plan renames the schema in place instead of recreating it"
# Drop the remote_state fields that differ between clouds or from the test server.
trace $CLI bundle plan --output json | jq .plan | normalize_uc_payload.py updated_at updated_by effective_predictive_optimization_flag

title "Deploy renames the schema without a deletion prompt"
trace $CLI bundle deploy
trace print_requests.py //unity-catalog

title "The schema is only reachable under the new name, with its original schema_id"
trace musterr $CLI schemas get "$OLD_SCHEMA"
trace $CLI schemas get "$NEW_SCHEMA" | jq '{full_name, name, comment, schema_id}'

title "The state and summary track the new name"
trace $CLI bundle summary --output json | jq '.resources.schemas.schema1 | {id, name}'

title "Redeploy is a no-op"
trace $CLI bundle plan
trace $CLI bundle deploy
trace print_requests.py //unity-catalog
