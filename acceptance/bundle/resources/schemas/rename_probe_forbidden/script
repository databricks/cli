cleanup() {
    trace errcode $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

title "Deploy a schema"
trace $CLI bundle deploy

title "Delete the schema out of band and rename it in the config. Reading the new name is forbidden"
trace $CLI schemas delete main.myschema
trace update_file.py databricks.yml "name: myschema" "name: myschema2"
trace errcode $CLI bundle plan
