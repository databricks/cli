envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

trace $CLI bundle deploy

# The deploy summary prints the genie room URL (on both the create above and the
# delete below), which embeds this random id.
echo "$($CLI bundle summary -o json | jq -r '.resources.genie_spaces.sales_analytics.id'):GENIE_SPACE_ID" >> ACC_REPLS

title "Deploying without the genie space warns before deleting it (chat history loss)"
envsubst < no_space.yml.tmpl > databricks.yml
trace $CLI bundle deploy --auto-approve
