envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

trace $CLI bundle deploy

# The backend migrates a version-1 serialized_space to version 2 on write and
# returns an etag for the migrated (version 2) content. serialized_space is
# ignore_remote_changes (etag_based), so the permanent local(v1)/remote(v2)
# mismatch does not surface as drift: the resource action stays "skip" and a
# re-plan reports no changes.
title "Plan after deploy is drift-free despite the version 1 -> version 2 migration"
trace $CLI bundle plan

# The mismatch the etag masks: the local config stays version 1 while the remote
# (and the etag guarding it) is version 2. The serialized_space change is
# recorded but skipped via the etag_based rule. The plan holds content hashes
# for serialized_space (hashed_fields), so the versions are read from the
# config and from the Genie API instead.
title "serialized_space: local version 1, remote version 2, skipped (etag_based)"
GENIE_SPACE_ID=$($CLI bundle summary --output json | jq -r '.resources.genie_spaces.foo.id')
LOCAL_VERSION=$($CLI bundle validate -o json | jq '.resources.genie_spaces.foo.serialized_space | if type == "string" then fromjson else . end | .version')
REMOTE_VERSION=$($CLI genie get-space $GENIE_SPACE_ID --include-serialized-space -o json | jq '.serialized_space | fromjson | .version')
$CLI bundle plan -o json | nostamp \
  | jq --argjson local_version "$LOCAL_VERSION" --argjson remote_version "$REMOTE_VERSION" \
       '.plan["resources.genie_spaces.foo"].changes.serialized_space
        | {action, reason,
           local_version: $local_version,
           remote_version: $remote_version,
           remote_differs: (.new != .remote)}'
