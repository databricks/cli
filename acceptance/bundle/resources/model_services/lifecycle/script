envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

trace $CLI bundle deploy

MODEL_SERVICE_ID=$($CLI bundle summary --output json | jq -r '.resources.model_services.ms.id')

trace $CLI ai-gateway get-model-service "model-services/$MODEL_SERVICE_ID" | jq '{name, comment}'

# Verify there is no drift right after deploy. Text plan (not -o json) keeps the
# output identical between the mock and a real workspace: the server populates
# output-only fields (owner, timestamps, resolved config) but the resource
# action stays "unchanged", so the rendered plan is the same.
trace $CLI bundle plan
