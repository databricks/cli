bundle:
  name: test-matset-batch-$UNIQUE_NAME

resources:
  features:
    batchfeat:
      full_name: $CATALOG_NAME.$SCHEMA_NAME.batch_$UNIQUE_NAME
      source:
        delta_table_source:
          full_name: $TABLE_NAME
      function:
        aggregation_function:
          count_function:
            input: value
          time_window:
            sliding:
              window_duration: 604800s
              slide_duration: 86400s
      entities:
        - name: id
      timeseries_column:
        name: timestamp

    # Stream-sourced, so it materializes on the streaming path while batchfeat stays on the
    # batch path. The set below asks for one of each.
    streamfeat:
      full_name: $CATALOG_NAME.$SCHEMA_NAME.batchstream_$UNIQUE_NAME
      source:
        stream_source:
          full_name: $STREAM_FULL_NAME
      function:
        aggregation_function:
          count_function:
            input: value.passenger_count_1
          time_window:
            rolling:
              window_duration: 3600s
      entities:
        - name: value.pickup_zip
      timeseries_column:
        name: value.event_timestamp

  materialization_sets:
    set1:
      materialized_features:
        # The offline member a delete cascades from, and the only one a schedule state can be
        # applied to.
        - feature_name: ${resources.features.batchfeat.full_name}
          offline_store_config:
            catalog_name: $CATALOG_NAME
            schema_name: $SCHEMA_NAME
            table_name_prefix: batch_${UNIQUE_NAME}_off
          cron_schedule_trigger:
            mode: MANUAL
            cron_expression: "0 0 * * * ?"
        - feature_name: ${resources.features.streamfeat.full_name}
          online_store_config:
            online_store_name: $ONLINE_STORE_NAME
            catalog_name: $CATALOG_NAME
            schema_name: $SCHEMA_NAME
            table_name_prefix: batchstream_$UNIQUE_NAME
          streaming_mode:
            mode: STREAMING_MODE_TYPE_RTM
