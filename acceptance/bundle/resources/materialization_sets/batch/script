export CATALOG_NAME="${MATSET_CATALOG:-danielb}"
export SCHEMA_NAME="${MATSET_SCHEMA:-fs2680}"
export ONLINE_STORE_NAME="${MATSET_ONLINE_STORE:-danielb}"
export STREAM_FULL_NAME="${MATSET_STREAM:-danielb.fs2680.fs2680_dch48o_stream}"
export TABLE_NAME="$CATALOG_NAME.$SCHEMA_NAME.src_$UNIQUE_NAME"

# Each phase is its own template rather than a string edit, so the fixture a phase deploys is
# readable on its own.
render() {
    envsubst < "$1" > databricks.yml
    [ -n "${MATSET_PROFILE:-}" ] || return 0
    printf "\nworkspace:\n  profile: %s\n" "$MATSET_PROFILE" >> databricks.yml
}

set_actions() {
    jq '.plan | with_entries(select(.key | startswith("resources.materialization_sets"))) | map_values(.action)' out.plan.json
}

cleanup() {
    $CLI bundle destroy --auto-approve > /dev/null 2>&1 || true
    $CLI tables delete "$TABLE_NAME" > /dev/null 2>&1 || true
}
trap cleanup EXIT

trace create_table.py "$TABLE_NAME"
render databricks.yml.tmpl

title "A batch feature with both destinations creates, and a redeploy plans nothing"
trace $CLI bundle deploy
trace $CLI bundle plan -o json > out.plan.json
trace set_actions

title "Neither member of the pair can be removed on its own. The offline member is the one a"
title "delete is applied to, so removing it reaches the online one too,"
render drop-offline.yml.tmpl
trace $CLI bundle plan -o json > out.plan.json
trace set_actions
trace musterr $CLI bundle deploy --auto-approve

title "and removing the online member names nothing a delete can be applied to"
render drop-online.yml.tmpl
trace $CLI bundle plan -o json > out.plan.json
trace set_actions
trace musterr $CLI bundle deploy --auto-approve

title "Removing both satisfies the cascade but empties the set, which the update endpoint refuses"
title "in favour of the delete endpoint. Restoring the pair plans nothing, so no refusal wrote."
render drop-both.yml.tmpl
trace musterr $CLI bundle deploy --auto-approve
render databricks.yml.tmpl
trace $CLI bundle plan -o json > out.plan.json
trace set_actions

title "Repointing the destinations is a recreate, not a silent no-op. The server cannot move a"
title "materialization in place, so the set is rebuilt at the new location."
render moved.yml.tmpl
trace $CLI bundle plan -o json > out.plan.json
trace set_actions
trace jq -r '.plan["resources.materialization_sets.set1"].changes | to_entries | map(select(.value.action == "recreate")) | .[] | "\(.value.reason) old=\(.value.old) new=\(.value.new)"' out.plan.json

title "The schedule state is write-once, so pausing the feature is a recreate rather than the"
title "in-place update the endpoint would refuse"
render paused-both.yml.tmpl
trace $CLI bundle plan -o json > out.plan.json
trace set_actions
trace $CLI bundle deploy --auto-approve
trace $CLI bundle plan -o json > out.plan.json
trace set_actions

title "Pausing the offline member alone plans as a recreate too, and the create refuses the"
title "members of one feature disagreeing on the state"
render paused-offline.yml.tmpl
trace $CLI bundle plan -o json > out.plan.json
trace set_actions
trace musterr $CLI bundle deploy --auto-approve

title "A set cannot mix a feature that materializes on the batch path with one that materializes"
title "on the streaming path. The refusal above left no set behind, so this reaches the create"
title "endpoint, and it is raised before the shared-destination rule the two features also break."
render mixed.yml.tmpl
trace musterr $CLI bundle deploy --auto-approve

rm -f out.requests.txt out.plan.json
