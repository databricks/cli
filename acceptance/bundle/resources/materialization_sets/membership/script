set_members() {
    $CLI bundle summary -o json | jq '.resources.materialization_sets.set1.materialized_features | map({feature_name, is_online})'
}

set_action() {
    jq '.plan | with_entries(select(.key | startswith("resources.materialization_sets"))) | map_values(.action)' out.plan.json
}

trace $CLI bundle deploy
trace print_requests.py //materialization-sets

title "The cascade is per feature and runs both ways. Removing featA's online member alone is"
title "refused, because the delete also reaches the offline member the config still declares"
trace update_file.py databricks.yml '        - feature_name: main.myschema.featA
          online_store_config:
            online_store_name: danielb
            catalog_name: main
            schema_name: myschema
            table_name_prefix: shared
' ''
trace musterr $CLI bundle deploy --auto-approve
rm -f "$OUT_REQUESTS"

title "And removing featA's offline member alone is refused for the same reason, from the other"
title "direction"
trace update_file.py databricks.yml '        - feature_name: main.myschema.featA
          offline_store_config:
            catalog_name: main
            schema_name: myschema
            table_name_prefix: shared
' '        - feature_name: main.myschema.featA
          online_store_config:
            online_store_name: danielb
            catalog_name: main
            schema_name: myschema
            table_name_prefix: shared
'
trace musterr $CLI bundle deploy --auto-approve
rm -f "$OUT_REQUESTS"

title "A feature contributing one member can have it removed alone: the cascade set is that one"
title "member, and the features the request says nothing about are untouched"
trace update_file.py databricks.yml '        - feature_name: main.myschema.featA
          online_store_config:
            online_store_name: danielb
            catalog_name: main
            schema_name: myschema
            table_name_prefix: shared
' '        - feature_name: main.myschema.featA
          offline_store_config:
            catalog_name: main
            schema_name: myschema
            table_name_prefix: shared
        - feature_name: main.myschema.featA
          online_store_config:
            online_store_name: danielb
            catalog_name: main
            schema_name: myschema
            table_name_prefix: shared
'
trace update_file.py databricks.yml '        - feature_name: main.myschema.featB
          offline_store_config:
            catalog_name: main
            schema_name: myschema
            table_name_prefix: shared
' ''
trace $CLI bundle plan -o json > out.plan.json
trace set_action
trace $CLI bundle deploy --auto-approve
trace set_members

title "Removing a whole feature's pair plans as update, not recreate, and the surviving member"
title "keeps its id, so the set was reconciled rather than rebuilt"
trace update_file.py databricks.yml '        - feature_name: main.myschema.featA
          offline_store_config:
            catalog_name: main
            schema_name: myschema
            table_name_prefix: shared
        - feature_name: main.myschema.featA
          online_store_config:
            online_store_name: danielb
            catalog_name: main
            schema_name: myschema
            table_name_prefix: shared
' ''
trace $CLI bundle plan -o json > out.plan.json
trace set_action
trace $CLI bundle deploy --auto-approve
trace print_requests.py //materialization-sets
trace set_members

trace $CLI bundle destroy --auto-approve

rm -f out.requests.txt out.plan.json
