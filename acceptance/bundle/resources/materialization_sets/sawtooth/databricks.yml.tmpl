bundle:
  name: test-matset-sawtooth-$UNIQUE_NAME

resources:
  features:
    sawfeat:
      full_name: $CATALOG_NAME.$SCHEMA_NAME.saw_$UNIQUE_NAME
      source:
        stream_source:
          full_name: $STREAM_FULL_NAME
      function:
        aggregation_function:
          sum:
            input: value.passenger_count_1
          time_window:
            sawtooth:
              window_duration: 259200s
      entities:
        - name: value.pickup_zip
      timeseries_column:
        name: value.event_timestamp

  materialization_sets:
    set1:
      materialized_features:
        # Offline batch, on the schedule the service derives for a sawtooth window.
        - feature_name: ${resources.features.sawfeat.full_name}
          offline_store_config:
            catalog_name: $CATALOG_NAME
            schema_name: $SCHEMA_NAME
            table_name_prefix: saw_${UNIQUE_NAME}_off
          cron_schedule_trigger:
            mode: DERIVED
        # Online batch, sharing its destination with the streaming member below.
        - feature_name: ${resources.features.sawfeat.full_name}
          online_store_config:
            online_store_name: $ONLINE_STORE_NAME
            catalog_name: $CATALOG_NAME
            schema_name: $SCHEMA_NAME
            table_name_prefix: saw_$UNIQUE_NAME
          cron_schedule_trigger:
            mode: DERIVED
        # Online streaming. RTM is the only streaming mode a non-Kinesis stream source accepts.
        - feature_name: ${resources.features.sawfeat.full_name}
          online_store_config:
            online_store_name: $ONLINE_STORE_NAME
            catalog_name: $CATALOG_NAME
            schema_name: $SCHEMA_NAME
            table_name_prefix: saw_$UNIQUE_NAME
          streaming_mode:
            mode: STREAMING_MODE_TYPE_RTM
