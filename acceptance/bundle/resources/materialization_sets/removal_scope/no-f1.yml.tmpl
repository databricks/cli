bundle:
  name: test-matset-removal-scope-$UNIQUE_NAME

resources:
  features:
    featf1:
      full_name: $CATALOG_NAME.$SCHEMA_NAME.featf1_$UNIQUE_NAME
      source:
        delta_table_source:
          full_name: $TABLE_NAME
      function:
        aggregation_function:
          count_function:
            input: value
          time_window:
            sliding:
              window_duration: 604800s
              slide_duration: 86400s
      entities:
        - name: id
      timeseries_column:
        name: timestamp
    featf2:
      full_name: $CATALOG_NAME.$SCHEMA_NAME.featf2_$UNIQUE_NAME
      source:
        delta_table_source:
          full_name: $TABLE_NAME
      function:
        aggregation_function:
          count_function:
            input: value
          time_window:
            sliding:
              window_duration: 604800s
              slide_duration: 86400s
      entities:
        - name: id
      timeseries_column:
        name: timestamp

  materialization_sets:
    set1:
      # featf1's only member dropped; featf2 is untouched.
      materialized_features:
        - feature_name: ${resources.features.featf2.full_name}
          offline_store_config:
            catalog_name: $CATALOG_NAME
            schema_name: $SCHEMA_NAME
            table_name_prefix: $PREFIX
          cron_schedule_trigger:
            mode: MANUAL
            cron_expression: "0 0 * * * ?"
