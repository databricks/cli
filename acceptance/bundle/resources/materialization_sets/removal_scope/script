export CATALOG_NAME="${MATSET_CATALOG:-main}"
export SCHEMA_NAME="matset_${UNIQUE_NAME}"
export TABLE_NAME="$CATALOG_NAME.$SCHEMA_NAME.src_$UNIQUE_NAME"
export PREFIX="mat_$UNIQUE_NAME"

# Each phase is its own template rather than a string edit, so the membership a phase declares is
# readable on its own.
render() {
    envsubst < "$1" > databricks.yml
    [ -n "${MATSET_PROFILE:-}" ] || return 0
    printf "\nworkspace:\n  profile: %s\n" "$MATSET_PROFILE" >> databricks.yml
}

set_action() {
    jq '.plan | with_entries(select(.key | startswith("resources.materialization_sets"))) | map_values(.action)' out.plan.json
}

set_members() {
    $CLI bundle summary -o json | jq '.resources.materialization_sets.set1.materialized_features | map({feature_name, is_online})'
}

cleanup() {
    $CLI bundle destroy --auto-approve > /dev/null 2>&1 || true
    $CLI tables delete "$TABLE_NAME" > /dev/null 2>&1 || true
    $CLI schemas delete "$CATALOG_NAME.$SCHEMA_NAME" --force > /dev/null 2>&1 || true
}
trap cleanup EXIT

trace $CLI schemas create "$SCHEMA_NAME" "$CATALOG_NAME" -o json | jq '{full_name}'
trace create_table.py "$TABLE_NAME"
render databricks.yml.tmpl

trace $CLI bundle deploy

# The create's requests are pinned by the basic case, so drop them and let the update's stand alone.
rm -f "$OUT_REQUESTS"

title "A feature contributing one member can have it removed alone: the cascade set is that one"
title "member, and the feature the request says nothing about is untouched"
render no-f1.yml.tmpl
trace $CLI bundle plan -o json > out.plan.json
trace set_action
trace $CLI bundle deploy --auto-approve
trace set_members

title "The update returns a long-running operation, and the reconciled set is read back from it"
trace print_requests.py --keep //materialization-sets
trace print_requests.py --get //feature-engineering/operations

rm -f out.plan.json
