export CATALOG_NAME="${MATSET_CATALOG:-main}"
export SCHEMA_NAME="matset_${UNIQUE_NAME}"
export TABLE_NAME="$CATALOG_NAME.$SCHEMA_NAME.src_$UNIQUE_NAME"

# Each phase is its own template rather than a string edit, so the fixture a phase deploys is
# readable on its own.
render() {
    envsubst < "$1" > databricks.yml
    [ -n "${MATSET_PROFILE:-}" ] || return 0
    printf "\nworkspace:\n  profile: %s\n" "$MATSET_PROFILE" >> databricks.yml
}

set_action() {
    jq '.plan | with_entries(select(.key | startswith("resources.materialization_sets"))) | map_values(.action)' out.plan.json
}

cleanup() {
    $CLI bundle destroy --auto-approve > /dev/null 2>&1 || true
    $CLI tables delete "$TABLE_NAME" > /dev/null 2>&1 || true
    $CLI schemas delete "$CATALOG_NAME.$SCHEMA_NAME" --force > /dev/null 2>&1 || true
}
trap cleanup EXIT

trace $CLI schemas create "$SCHEMA_NAME" "$CATALOG_NAME" -o json | jq '{full_name}'
trace create_table.py "$TABLE_NAME"
render databricks.yml.tmpl

trace $CLI bundle deploy

title "A member field the endpoint cannot alter is caught by the planner as a recreate, so the"
title "request never reaches the server"
update_file.py databricks.yml '0 0 * * * ?' '0 30 * * * ?'
trace $CLI bundle plan -o json > out.plan.json
trace set_action

title "The endpoint cannot add a member either, so adding one plans a recreate of the whole set"
title "and warns that every member is dropped and recomputed"
render added-member.yml.tmpl
trace $CLI bundle plan -o json > out.plan.json
trace set_action

title "A recreate needs approval, so a deploy that cannot prompt stops before changing anything"
trace musterr $CLI bundle deploy

title "With approval the set is rebuilt holding both members, and the rebuilt set plans clean"
trace $CLI bundle deploy --auto-approve
trace $CLI bundle plan -o json > out.plan.json
trace set_action

title "Removing a member is still an update"
render databricks.yml.tmpl
trace $CLI bundle plan -o json > out.plan.json
trace set_action
trace $CLI bundle deploy --auto-approve

title "A member whose feature name changes reads as one member removed and another added, so it"
title "plans a recreate as well"
render renamed-member.yml.tmpl
trace $CLI bundle plan -o json > out.plan.json
trace set_action

rm -f out.requests.txt out.plan.json
