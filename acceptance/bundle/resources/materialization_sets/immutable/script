export CATALOG_NAME="${MATSET_CATALOG:-main}"
export SCHEMA_NAME="${MATSET_SCHEMA:-materialization_set_acceptance_test}"
export TABLE_NAME="$CATALOG_NAME.$SCHEMA_NAME.src_$UNIQUE_NAME"

# Each phase is its own template rather than a string edit, so the fixture a phase deploys is
# readable on its own.
render() {
    envsubst < "$1" > databricks.yml
    [ -n "${MATSET_PROFILE:-}" ] || return 0
    printf "\nworkspace:\n  profile: %s\n" "$MATSET_PROFILE" >> databricks.yml
}

set_action() {
    jq '.plan | with_entries(select(.key | startswith("resources.materialization_sets"))) | map_values(.action)' out.plan.json
}

cleanup() {
    $CLI bundle destroy --auto-approve > /dev/null 2>&1 || true
    $CLI tables delete "$TABLE_NAME" > /dev/null 2>&1 || true
}
trap cleanup EXIT

trace create_table.py "$TABLE_NAME"
render databricks.yml.tmpl

trace $CLI bundle deploy

title "A member field the endpoint cannot alter is caught by the planner as a recreate, so the"
title "request never reaches the server"
sed -i 's/0 0 \* \* \* ?/0 30 * * * ?/' databricks.yml
trace $CLI bundle plan -o json > out.plan.json
trace set_action

title "Adding a member is routed to update, where the server refuses it by name rather than"
title "recreating the set and destroying the members the config left alone"
render added-member.yml.tmpl
trace $CLI bundle plan -o json > out.plan.json
trace set_action
trace musterr $CLI bundle deploy --auto-approve

rm -f out.requests.txt out.plan.json
