{
  "method": "PUT",
  "path": "/api/2.0/permissions/pipelines/[UUID]",
  "body": {
    "access_control_list": [
      {
        "permission_level": "IS_OWNER",
        "user_name": "other_user@databricks.com"
      },
      {
        "permission_level": "CAN_MANAGE",
        "user_name": "[USERNAME]"
      }
    ]
  }
}
{
  "method": "PATCH",
  "path": "/api/2.0/bundle/deployments/[NUMID]/versions/1/operations/pipelines.foo.permissions",
  "q": {
    "update_mask": "state,error_message,resource_id,status"
  },
  "body": {
    "state": "{\"state\":{\"object_id\":\"/pipelines/[UUID]\",\"__embed__\":[{\"level\":\"IS_OWNER\",\"user_name\":\"other_user@databricks.com\"},{\"level\":\"CAN_MANAGE\",\"user_name\":\"[USERNAME]\"}]},\"depends_on\":[{\"node\":\"resources.pipelines.foo\",\"label\":\"${resources.pipelines.foo.id}\"}]}",
    "resource_id": "/pipelines/[UUID]",
    "status": "OPERATION_STATUS_SUCCEEDED",
    "sequence_id": "0"
  }
}
