{
  "plan_version": [PLAN_VERSION],
  "cli_version": "[CLI_VERSION]",
  "lineage": "[UUID]",
  "serial": 3,
  "plan": {
    "resources.pipelines.foo": {
      "action": "skip",
      "remote_state": {
        "channel": "CURRENT",
        "deployment": {
          "kind": "BUNDLE",
          "metadata_file_path": "/Workspace/Users/[USERNAME]/.bundle/permissions-test/default/state/metadata.json"
        },
        "edition": "ADVANCED",
        "id": "[FOO_ID]",
        "name": "foo",
        "storage": "dbfs:/pipelines/[FOO_ID]",
        "creator_user_name": "[USERNAME]",
        "effective_publishing_mode": "DEFAULT_PUBLISHING_MODE",
        "last_modified": [UNIX_TIME_MILLIS],
        "pipeline_id": "[FOO_ID]",
        "run_as_user_name": "[USERNAME]",
        "state": "IDLE"
      },
      "changes": {
        "storage": {
          "action": "skip",
          "reason": "immutable_backend_value",
          "remote": "dbfs:/pipelines/[FOO_ID]"
        }
      }
    },
    "resources.pipelines.foo.permissions": {
      "depends_on": [
        {
          "node": "resources.pipelines.foo",
          "label": "${resources.pipelines.foo.id}"
        }
      ],
      "action": "delete",
      "state_only": true
    }
  }
}
