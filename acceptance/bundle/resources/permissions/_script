trace $CLI bundle validate -o json | nostamp.py | jq .resources.$RESOURCE.foo.permissions
rm "$OUT_REQUESTS"

$CLI bundle plan -o json | nostamp.py > out.plan.$DATABRICKS_BUNDLE_ENGINE.json

print_requests() {
    jq -c < "$OUT_REQUESTS" | jq 'select(.method != "GET" and (.path | contains("permissions")) and (.path | contains("/api/2.0/bundle") | not))'
    rm "$OUT_REQUESTS"
}

rm "$OUT_REQUESTS"
trace $CLI bundle deploy
print_requests > out.requests.deploy.$DATABRICKS_BUNDLE_ENGINE.json

trace $CLI bundle destroy --auto-approve
print_requests > out.requests.destroy.$DATABRICKS_BUNDLE_ENGINE.json
