bundle:
  name: recreate-ref-update-$UNIQUE_NAME

sync:
  paths: []

# Companion to postgres_projects/recreate_ref_both_engines (which shows the spurious
# RECREATE). Here the referrer field is MUTABLE, so the same phantom diff plans a
# spurious UPDATE instead of a recreate.
#
# Changing postgres_role recreates the role (the backend rejects it in the PATCH
# update_mask - see postgres_roles/recreate-postgres-role), but role_id is unchanged, so
# my_role.name (projects/.../roles/app-owner) is stable. The direct engine cannot resolve
# ${my_role.name} while the role is being recreated, so my_database.role diffs the saved
# name against the literal "${...}" placeholder and plans an unnecessary update.
resources:
  postgres_projects:
    my_project:
      project_id: test-pg-proj-$UNIQUE_NAME
      display_name: My project
      pg_version: 16

  postgres_branches:
    my_branch:
      parent: ${resources.postgres_projects.my_project.name}
      branch_id: main
      no_expiry: true

  postgres_roles:
    my_role:
      parent: ${resources.postgres_branches.my_branch.name}
      role_id: app-owner
      postgres_role: app_role

  postgres_databases:
    my_database:
      database_id: my-db
      parent: ${resources.postgres_branches.my_branch.name}
      postgres_database: mydb
      role: ${resources.postgres_roles.my_role.name}
