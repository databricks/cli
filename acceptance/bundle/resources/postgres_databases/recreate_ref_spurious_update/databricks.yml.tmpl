bundle:
  name: recreate-ref-update-$UNIQUE_NAME

sync:
  paths: []

# Companion to postgres_projects/recreate_ref_both_engines (which shows the spurious
# RECREATE). Here the referrer field is MUTABLE, so the same phantom diff plans a
# spurious UPDATE instead of a recreate.
#
# Changing postgres_role recreates the role (the backend rejects it in the PATCH
# update_mask - see postgres_roles/recreate-postgres-role), but role_id is unchanged, so
# owner.name (projects/.../roles/app-owner) is stable. The direct engine cannot resolve
# ${owner.name} while owner is being recreated, so d.role diffs the saved name against
# the literal "${...}" placeholder and plans an unnecessary update of the database.
resources:
  postgres_projects:
    p:
      project_id: test-pg-proj-$UNIQUE_NAME
      display_name: P
      pg_version: 16

  postgres_branches:
    b:
      parent: ${resources.postgres_projects.p.name}
      branch_id: main
      no_expiry: true

  postgres_roles:
    owner:
      parent: ${resources.postgres_branches.b.name}
      role_id: app-owner
      postgres_role: app_role

  postgres_databases:
    d:
      database_id: my-db
      parent: ${resources.postgres_branches.b.name}
      postgres_database: mydb
      role: ${resources.postgres_roles.owner.name}
