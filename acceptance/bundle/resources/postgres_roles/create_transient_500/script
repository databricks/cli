title "The create request fails with 500 but the role was created: deploy uses the role"
fault.py --after-handler "POST /api/2.0/postgres/projects/*/branches/*/roles" 500 0 1 INTERNAL_ERROR
trace $CLI bundle deploy
trace print_requests.py --get //postgres/projects/test-pg-proj/branches/main/roles | jq -r '.method + " " + .path'
$CLI bundle destroy --auto-approve &> LOG.destroy
rm -f "$OUT_REQUESTS"

title "The create request fails with 500 and the role was not created: deploy repeats the create"
fault.py "POST /api/2.0/postgres/projects/*/branches/*/roles" 500 0 1 INTERNAL_ERROR
trace $CLI bundle deploy
trace print_requests.py --get //postgres/projects/test-pg-proj/branches/main/roles | jq -r '.method + " " + .path'
$CLI bundle destroy --auto-approve &> LOG.destroy
rm -f "$OUT_REQUESTS"

title "The role cannot be read after the create request fails: deploy fails with the create error"
fault.py "POST /api/2.0/postgres/projects/*/branches/*/roles" 500 0 1 INTERNAL_ERROR
fault.py "GET /api/2.0/postgres/projects/*/branches/*/roles/app-owner" 403 0 1 PERMISSION_DENIED
trace musterr $CLI bundle deploy
trace print_requests.py --get //postgres/projects/test-pg-proj/branches/main/roles | jq -r '.method + " " + .path'
$CLI bundle destroy --auto-approve &> LOG.destroy
rm -f "$OUT_REQUESTS"

title "With replace_existing, a failed create request is repeated without reading the role"
update_file.py databricks.yml "postgres_role: app_owner" "postgres_role: app_owner
      replace_existing: true"
fault.py --after-handler "POST /api/2.0/postgres/projects/*/branches/*/roles" 500 0 1 INTERNAL_ERROR
trace $CLI bundle deploy
trace print_requests.py --get //postgres/projects/test-pg-proj/branches/main/roles | jq -r '.method + " " + .path'
$CLI bundle destroy --auto-approve &> LOG.destroy
