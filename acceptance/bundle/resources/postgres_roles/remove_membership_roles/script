envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
   trace $CLI bundle destroy --auto-approve
   rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

# membership_roles is a repeated field: remove its only entry.
# Each step records whether the change reaches the backend: the planned changes, the
# deploy outcome, the PATCH it sent, the resource read back, and the plan that follows.
step() {
    local name=$1
    $CLI bundle plan -o json | nostamp | jq '.plan."resources.postgres_roles.my_role" | {action, changes}' > out.plan.$name.json
    errcode $CLI bundle deploy &> out.deploy.$name.txt
    print_requests.py --del-body project_id,branch_id,endpoint_id,role_id //postgres --method PATCH > out.requests.$name.json
    $CLI postgres get-role "projects/test-pg-proj-${UNIQUE_NAME}/branches/main/roles/test-role" | jq '.status | {membership_roles}' > out.get.$name.json
    $CLI bundle plan -o json | nostamp | jq '.plan."resources.postgres_roles.my_role" | {action, changes}' > out.plan.after_$name.json
}

title "Initial deployment"
trace $CLI bundle deploy
rm -f "$OUT_REQUESTS"
trace $CLI postgres get-role "projects/test-pg-proj-${UNIQUE_NAME}/branches/main/roles/test-role" | jq '.status | {membership_roles}'

title "Remove membership_roles"
update_file.py databricks.yml "$(printf '      membership_roles:\n        - DATABRICKS_SUPERUSER\n')" ""
step remove
