cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm -f out.requests.txt
}
trap cleanup EXIT

title "Deploy a cluster with a pypi library"
trace $CLI bundle deploy

title "Removing the whole libraries block plans a delete of the libraries sub-resource"
update_file.py databricks.yml "      libraries:
        - pypi:
            package: requests
" ""
trace $CLI bundle plan

title "Redeploy uninstalls the libraries and restarts the running cluster"
trace $CLI bundle deploy
trace print_requests.py //libraries/uninstall
