envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm -f out.requests.txt
}
trap cleanup EXIT

# Deploy output goes to LOG (it is verbose and not the focus); the create install is the proof.
title "Deploy a cluster that declares one library (requests)"
$CLI bundle deploy &> LOG.deploy
cat LOG.deploy | contains.py "Created clusters.mycluster" > /dev/null
printf '\n%s\n' "OK: cluster created"
trace print_requests.py //libraries/install

# The cluster id is server-generated; read it from state to target the out-of-band call.
CLUSTER_ID=$(read_id.py mycluster)

title "A job run (or the UI) installs another library on the shared cluster, out of band"
MSYS_NO_PATHCONV=1 $CLI api post /api/2.0/libraries/install --json "{\"cluster_id\": \"$CLUSTER_ID\", \"libraries\": [{\"pypi\": {\"package\": \"six\"}}]}" > /dev/null
trace print_requests.py //libraries/install

title "Add a second declared library (urllib3) and redeploy - the bundle doesn't delete the out-of-band 'six'"
update_file.py databricks.yml "        - pypi:
            package: requests" "        - pypi:
            package: requests
        - pypi:
            package: urllib3"
trace $CLI bundle deploy

title "The redeploy installs urllib3 and restarts to apply it, but leaves the out-of-band 'six' alone (no uninstall)"
trace print_requests.py //libraries/uninstall //libraries/install //clusters/restart
