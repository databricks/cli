envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

title "Deploy with started=true: cluster created and running"
trace $CLI bundle deploy
CLUSTER_ID=$($CLI bundle summary -o json | jq -r '.resources.clusters.mycluster.id')
trace print_requests.py //clusters
rm -f "$OUT_REQUESTS"
trace $CLI clusters get "$CLUSTER_ID" | jq '.state'

title "Stop cluster externally while config says started=true: plan detects drift"
trace $CLI clusters delete "$CLUSTER_ID" | jq '.state'
trace $CLI bundle plan

title "Deploy fixes the drift: cluster restarted"
trace $CLI bundle deploy
trace print_requests.py //clusters
rm -f "$OUT_REQUESTS"
trace $CLI clusters get "$CLUSTER_ID" | jq '.state'

title "Deploy with started=false while cluster is stopped: cluster stays terminated"
trace $CLI clusters delete "$CLUSTER_ID" | jq '.state'
trace update_file.py databricks.yml "started: true" "started: false"
trace $CLI bundle deploy
trace print_requests.py //clusters
rm -f "$OUT_REQUESTS"
trace $CLI clusters get "$CLUSTER_ID" | jq '.state'

title "Deploy with started=true: cluster restarted"
trace update_file.py databricks.yml "started: false" "started: true"
trace $CLI bundle deploy
trace print_requests.py //clusters
rm -f "$OUT_REQUESTS"
trace $CLI clusters get "$CLUSTER_ID" | jq '.state'
