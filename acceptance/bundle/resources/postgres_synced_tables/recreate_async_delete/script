cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

export TIMESERIES_KEY=tpep_pickup_datetime
envsubst < databricks.yml.tmpl > databricks.yml
trace $CLI bundle deploy

title "A recreate polls the deleting table until it is gone, then re-creates it"
# The testserver keeps the deleted table visible (DELETING) for one more GET, so the
# poll below observes present-then-gone and the create succeeds instead of racing a 409.
export TIMESERIES_KEY=tpep_dropoff_datetime
envsubst < databricks.yml.tmpl > databricks.yml
rm -f "$OUT_REQUESTS"
trace $CLI bundle deploy
# The GET poll (present, then 404) sits between the DELETE and the re-create POST.
trace print_requests.py --get --oneline --del-field body,q //postgres/synced_tables
