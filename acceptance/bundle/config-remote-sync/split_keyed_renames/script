#!/bin/bash

envsubst < databricks.yml.tmpl > databricks.yml
export DATABRICKS_BUNDLE_TARGET=dev

cleanup() {
  trace $CLI bundle destroy --auto-approve -t dev
}
trap cleanup EXIT

$CLI bundle deploy -t dev

s4_id="$(read_id.py -t dev s4_target_rename)"
s5_id="$(read_id.py -t dev s5_rename_both_blocks)"
s6_id="$(read_id.py -t dev s6_rename_and_add)"
shifted_id="$(read_id.py -t dev shifted_delete_rename)"
target_only_id="$(read_id.py -t dev target_only_list)"

title "S4: rename a target-only element"
edit_resource.py jobs "$s4_id" <<'EOF'
next(t for t in r["tasks"] if t["task_key"] == "t1")["task_key"] = "t1b"
EOF

title "Rename matching is not confused by a preceding deletion"
edit_resource.py jobs "$shifted_id" <<'EOF'
r["tasks"] = [t for t in r["tasks"] if t["task_key"] != "a_target"]
next(t for t in r["tasks"] if t["task_key"] == "m_top")["task_key"] = "z_top_renamed"
EOF

title "A new keyed list element uses the broadest existing resource scope"
edit_resource.py jobs "$target_only_id" <<'EOF'
r["tasks"].extend([
    {
        "task_key": "a_brand_top",
        "notebook_task": {"notebook_path": "/Workspace/brand-top-a"},
    },
    {
        "task_key": "b_brand_top",
        "notebook_task": {"notebook_path": "/Workspace/brand-top-b"},
    },
])
EOF

title "S5: rename elements in both blocks without swapping their provenance"
edit_resource.py jobs "$s5_id" <<'EOF'
next(t for t in r["tasks"] if t["task_key"] == "m")["task_key"] = "z_new_top"
next(t for t in r["tasks"] if t["task_key"] == "a")["task_key"] = "a_new_target"
EOF

title "S6: keep a rename in target while placing a genuinely new element at top level"
edit_resource.py jobs "$s6_id" <<'EOF'
next(t for t in r["tasks"] if t["task_key"] == "t")["task_key"] = "t_new"
r["tasks"].append({
    "task_key": "a_brand_new",
    "notebook_task": {"notebook_path": "/Workspace/s6-brand-new"},
})
EOF

title "Sync split keyed-list renames"
echo
cp databricks.yml databricks.yml.backup
$CLI bundle config-remote-sync -t dev --save

title "Configuration changes"
echo
trace diff.py databricks.yml.backup databricks.yml
rm databricks.yml.backup

title "Second sync is idempotent"
echo
cp databricks.yml databricks.yml.second-backup
$CLI bundle config-remote-sync -t dev --save | contains.py "No changes detected."
trace diff.py databricks.yml.second-backup databricks.yml
rm databricks.yml.second-backup
