bundle:
  name: test-bundle-$UNIQUE_NAME

resources:
  jobs:
    rename_target_task:
      tasks:
        - task_key: top1
          notebook_task:
            notebook_path: /Workspace/rename-target-top

    rename_tasks_in_both_blocks:
      tasks:
        - task_key: m
          notebook_task:
            notebook_path: /Workspace/rename-both-top

    rename_target_and_add_top_level:
      tasks:
        - task_key: n
          notebook_task:
            notebook_path: /Workspace/rename-and-add-top

    independent_task_replacement:
      timeout_seconds: 50
      job_clusters:
        - job_cluster_key: shared_cluster
          new_cluster:
            spark_version: $DEFAULT_SPARK_VERSION
            node_type_id: $NODE_TYPE_ID
            num_workers: 1
      tasks:
        - task_key: survivor
          job_cluster_key: shared_cluster
          notebook_task:
            notebook_path: /Workspace/surviving-task

    shifted_delete_rename:
      tasks:
        - task_key: m_top
          timeout_seconds: 610
          notebook_task:
            notebook_path: /Workspace/shift-top

    target_only_list:
      timeout_seconds: 800

targets:
  dev:
    mode: development
    resources:
      jobs:
        rename_target_task:
          tasks:
            - task_key: t1
              timeout_seconds: 40
              notebook_task:
                notebook_path: /Workspace/rename-target-dev

        rename_tasks_in_both_blocks:
          tasks:
            - task_key: a
              notebook_task:
                notebook_path: /Workspace/rename-both-target

        rename_target_and_add_top_level:
          tasks:
            - task_key: t
              notebook_task:
                notebook_path: /Workspace/rename-and-add-target

        independent_task_replacement:
          tasks:
            - task_key: etl
              # This note belongs only to the task that is removed.
              job_cluster_key: shared_cluster
              timeout_seconds: 100
              notebook_task:
                notebook_path: /Workspace/shared-task

        shifted_delete_rename:
          tasks:
            - task_key: a_target
              timeout_seconds: 620
              notebook_task:
                notebook_path: /Workspace/shift-target

        target_only_list:
          tasks:
            - task_key: z_target
              notebook_task:
                notebook_path: /Workspace/target-only

  prod:
    mode: production
    resources:
      jobs:
        rename_target_task:
          tasks:
            - task_key: prod1
              notebook_task:
                notebook_path: /Workspace/rename-target-prod
