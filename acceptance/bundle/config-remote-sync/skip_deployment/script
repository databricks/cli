#!/bin/bash

envsubst < databricks.yml.tmpl > databricks.yml
add_repl "$DEFAULT_SPARK_VERSION" DEFAULT_SPARK_VERSION
add_repl "$NODE_TYPE_ID" NODE_TYPE_ID

cleanup() {
  trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

$CLI bundle deploy
job_id="$(read_id.py my_job)"
pipeline_id="$(read_id.py my_pipeline)"


title "Modify the CLI-managed deployment metadata and one user field remotely"
echo
# deployment.* is rewritten by the CLI on every deploy (metadata.AnnotateJobs /
# AnnotatePipelines), so config-remote-sync must never sync it back, even when it
# differs from the local value. The description / configuration edits are the
# contrast: they are user fields and must still sync, so the diff below shows
# only them, never deployment.
edit_resource.py jobs $job_id <<EOF
r["deployment"]["metadata_file_path"] = "/Workspace/changed/state/metadata.json"
r["description"] = "updated remotely"
EOF

edit_resource.py pipelines $pipeline_id <<EOF
r["deployment"]["metadata_file_path"] = "/Workspace/changed/state/metadata.json"
r["configuration"]["key2"] = "value2"
EOF

title "Detect and save changes"
echo
cp databricks.yml databricks.yml.backup
$CLI bundle config-remote-sync --save

title "Configuration changes"
echo
trace diff.py databricks.yml.backup databricks.yml
rm databricks.yml.backup
