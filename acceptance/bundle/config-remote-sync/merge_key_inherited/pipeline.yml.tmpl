targets:
  staging:
    resources:
      pipelines:
        my_pipeline: &pipeline
          name: test-pipeline-$UNIQUE_NAME
          catalog: main
          schema: default
          clusters:
            - label: default
              num_workers: 1
          libraries:
            - notebook:
                path: /Users/{{workspace_user_name}}/notebook
  default:
    resources:
      pipelines:
        my_pipeline:
          <<: *pipeline
