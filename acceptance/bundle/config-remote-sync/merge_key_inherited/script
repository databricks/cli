envsubst < databricks.yml.tmpl > databricks.yml
envsubst < pipeline.yml.tmpl > pipeline.yml

cleanup() {
  trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

$CLI bundle deploy
job_id="$(read_id.py my_job)"
pipeline_id="$(read_id.py my_pipeline)"

title "Edit fields inherited through YAML merge keys"
edit_resource.py jobs $job_id <<EOF2
for task in r["tasks"]:
    if task["task_key"] == "b_task":
        task["min_retry_interval_millis"] = 5000
        del task["max_retries"]
        task["notebook_task"]["base_parameters"]["input_file_name"] = "changed"
for cluster in r["job_clusters"]:
    if cluster["job_cluster_key"] == "derived":
        del cluster["new_cluster"]["num_workers"]
        cluster["new_cluster"]["autoscale"] = {"min_workers": 1, "max_workers": 2}
EOF2
edit_resource.py pipelines $pipeline_id <<EOF2
del r["clusters"]
EOF2

title "Detect and save changes"
cp databricks.yml databricks.yml.backup
cp pipeline.yml pipeline.yml.backup
$CLI bundle config-remote-sync --save

title "Configuration changes"
trace diff.py databricks.yml.backup databricks.yml
trace diff.py pipeline.yml.backup pipeline.yml
rm databricks.yml.backup pipeline.yml.backup
