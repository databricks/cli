envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

title "The current identity deploys a job that declares no permissions"
trace $CLI bundle deploy
job_id=$($CLI bundle summary -o json | jq -r '.resources.jobs.my_job.id')
add_repl "$job_id" MY_JOB_ID

title "The service principal is granted CAN_MANAGE on the job, outside the bundle\n"
$CLI permissions set jobs $job_id --json '{"access_control_list":[
  {"permission_level":"IS_OWNER","'"$CURRENT_USER_FIELD"'":"'"$CURRENT_USER_NAME"'"},
  {"permission_level":"CAN_MANAGE","service_principal_name":"'"$TEST_SP_APPLICATION_ID"'"}
]}' > /dev/null
print_acl jobs $job_id

title "The current identity runs config-remote-sync"
sync_and_show_diff

# The job declares no permissions, so the sync imports nothing and the deploy leaves the ACL alone.
title "The service principal takes over the deployment and deploys the synced config"
trace errcode as-test-sp $CLI bundle deploy

title "The job's ACL after the deploy\n"
print_acl jobs $job_id
