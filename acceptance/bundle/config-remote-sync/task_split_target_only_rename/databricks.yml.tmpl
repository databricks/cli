bundle:
  name: test-bundle-$UNIQUE_NAME

# Two targets. dev_only_task exists ONLY in the targets.dev override block.
# A rename is an unpaired remove+add, so config sync cannot prove that the add
# belongs in targets.dev. It must leave both operations stale rather than risk
# relocating the task to the top-level block where it would also affect prod.
resources:
  jobs:
    my_job:
      tasks:
        - task_key: top_task
          run_if: ALL_SUCCESS
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/top

targets:
  dev:
    mode: development
    resources:
      jobs:
        my_job:
          tasks:
            - task_key: dev_only_task
              run_if: ALL_SUCCESS
              notebook_task:
                notebook_path: /Users/{{workspace_user_name}}/dev
  prod:
    resources:
      jobs:
        my_job:
          max_concurrent_runs: 5
