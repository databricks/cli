bundle:
  name: test-bundle-$UNIQUE_NAME

resources:
  jobs:
    my_job:
      name: test-job-$UNIQUE_NAME
      tags: null # Keep job tags in the existing target mapping.
      job_clusters:
        - job_cluster_key: shared
          new_cluster:
            spark_version: $DEFAULT_SPARK_VERSION
            node_type_id: $NODE_TYPE_ID
            custom_tags: # Keep this comment when adding tags.
            spark_env_vars: null # Keep the environment comment.
            init_scripts: ~
            autoscale: ~ # Keep the autoscale comment.
        - job_cluster_key: nested
          new_cluster: null # Keep the cluster comment through both tag additions.
      tasks:
        - task_key: main
          job_cluster_key: shared
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/notebook

targets:
  default:
    resources:
      jobs:
        my_job:
          tags:
            existing: preserved
          job_clusters:
            - job_cluster_key: shared
              new_cluster:
                custom_tags:
                  existing: preserved
                spark_env_vars:
                  EXISTING: preserved
                autoscale:
                  min_workers: 1
            - job_cluster_key: nested
              new_cluster:
                spark_version: $DEFAULT_SPARK_VERSION
                node_type_id: $NODE_TYPE_ID
                num_workers: 1
                custom_tags:
                  existing: preserved
