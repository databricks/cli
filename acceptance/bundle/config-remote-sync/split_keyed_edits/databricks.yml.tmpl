bundle:
  name: test-bundle-$UNIQUE_NAME

variables:
  s10_notebook:
    default: /Workspace/variable-backed-notebook

resources:
  jobs:
    s1_non_first_top:
      tasks:
        - task_key: beta
          timeout_seconds: 10
          notebook_task:
            notebook_path: /Workspace/s1-beta
        - task_key: gamma
          timeout_seconds: 11
          notebook_task:
            notebook_path: /Workspace/s1-gamma

    s2_target_only:
      tasks:
        - task_key: zzz
          timeout_seconds: 20
          notebook_task:
            notebook_path: /Workspace/s2-zzz

    s3_both_blocks_sibling:
      tasks:
        - task_key: shared
          timeout_seconds: 30
          notebook_task:
            notebook_path: /Workspace/s3-shared

    flow_style_mapping:
      tasks: [{task_key: alpha, timeout_seconds: 701, notebook_task: {notebook_path: /Workspace/flow-alpha}}, {task_key: beta, timeout_seconds: 702, notebook_task: {notebook_path: /Workspace/flow-beta}}]

    s7_remove_both_blocks:
      tasks:
        - task_key: b
          notebook_task:
            notebook_path: /Workspace/s7-b
        - task_key: c
          notebook_task:
            notebook_path: /Workspace/s7-c

    s8_remove_and_edit:
      tasks:
        - task_key: p
          timeout_seconds: 80
          notebook_task:
            notebook_path: /Workspace/s8-p
        - task_key: q
          timeout_seconds: 81
          notebook_task:
            notebook_path: /Workspace/s8-q
        - task_key: r
          timeout_seconds: 82
          notebook_task:
            notebook_path: /Workspace/s8-r

    s10_preserve_variable:
      tasks:
        - task_key: top_task
          notebook_task:
            notebook_path: /Workspace/s10-top

    s10_target_only_variable_clone:
      timeout_seconds: 100

    s11_scalar_with_split_list:
      timeout_seconds: 110
      tasks:
        - task_key: top_task
          notebook_task:
            notebook_path: /Workspace/s11-top

targets:
  dev:
    mode: development
    resources:
      jobs:
        s1_non_first_top:
          tasks:
            - task_key: alpha
              timeout_seconds: 12
              notebook_task:
                notebook_path: /Workspace/s1-alpha

        s2_target_only:
          tasks:
            - task_key: alpha
              timeout_seconds: 21
              notebook_task:
                notebook_path: /Workspace/s2-alpha

        s3_both_blocks_sibling:
          tasks:
            - task_key: shared
              timeout_seconds: 31
            - task_key: omega
              timeout_seconds: 32
              notebook_task:
                notebook_path: /Workspace/s3-omega

        flow_style_mapping:
          tasks: [{task_key: aardvark, timeout_seconds: 703, notebook_task: {notebook_path: /Workspace/flow-target}}]

        s7_remove_both_blocks:
          tasks:
            - task_key: a
              notebook_task:
                notebook_path: /Workspace/s7-a
            - task_key: e
              notebook_task:
                notebook_path: /Workspace/s7-e

        s8_remove_and_edit:
          tasks:
            - task_key: a
              timeout_seconds: 83
              notebook_task:
                notebook_path: /Workspace/s8-a

        s10_preserve_variable:
          tasks:
            - task_key: variable_task
              notebook_task:
                notebook_path: ${var.s10_notebook}

        s10_target_only_variable_clone:
          tasks:
            - task_key: variable_task
              notebook_task:
                notebook_path: ${var.s10_notebook}

        s11_scalar_with_split_list:
          tasks:
            - task_key: target_task
              notebook_task:
                notebook_path: /Workspace/s11-target

        target_only_resource:
          tasks:
            - task_key: alpha
              notebook_task:
                notebook_path: /Workspace/target-only-alpha
