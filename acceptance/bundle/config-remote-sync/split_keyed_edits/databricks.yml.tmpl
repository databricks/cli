bundle:
  name: test-bundle-$UNIQUE_NAME

variables:
  notebook_path:
    default: /Workspace/variable-backed-notebook

resources:
  jobs:
    edit_non_first_top_level_task:
      tasks:
        - task_key: beta
          timeout_seconds: 10
          notebook_task:
            notebook_path: /Workspace/non-first-beta
        - task_key: gamma
          timeout_seconds: 11
          notebook_task:
            notebook_path: /Workspace/non-first-gamma

    edit_target_task:
      tasks:
        - task_key: yyy
          timeout_seconds: 19
          notebook_task:
            notebook_path: /Workspace/edit-target-yyy
        - task_key: zzz
          timeout_seconds: 20
          notebook_task:
            notebook_path: /Workspace/edit-target-zzz

    edit_target_sibling_after_shared_task:
      tasks:
        - task_key: new_dep
          notebook_task:
            notebook_path: /Workspace/new-dependency
        - task_key: shared
          timeout_seconds: 30
          notebook_task:
            notebook_path: /Workspace/shared-task
        - task_key: target_dep
          notebook_task:
            notebook_path: /Workspace/target-dependency

    flow_style_mapping:
      tasks: [{task_key: alpha, timeout_seconds: 701, notebook_task: {notebook_path: /Workspace/flow-alpha}}, {task_key: beta, timeout_seconds: 702, notebook_task: {notebook_path: /Workspace/flow-beta}}]

    remove_tasks_from_both_blocks:
      tasks:
        - task_key: b
          notebook_task:
            notebook_path: /Workspace/remove-b
        - task_key: c
          notebook_task:
            notebook_path: /Workspace/remove-c

    remove_and_edit_same_block:
      tasks:
        - task_key: p
          timeout_seconds: 80
          notebook_task:
            notebook_path: /Workspace/remove-edit-p
        - task_key: q
          timeout_seconds: 81
          notebook_task:
            notebook_path: /Workspace/remove-edit-q
        - task_key: r
          timeout_seconds: 82
          notebook_task:
            notebook_path: /Workspace/remove-edit-r

    preserve_variable_on_rename:
      tasks:
        - task_key: top_task
          notebook_task:
            notebook_path: /Workspace/preserve-variable-top

    preserve_variable_on_clone:
      timeout_seconds: 100

    edit_scalar_with_split_tasks:
      timeout_seconds: 110
      tasks:
        - task_key: top_task
          notebook_task:
            notebook_path: /Workspace/edit-scalar-top

targets:
  dev:
    mode: development
    resources:
      jobs:
        edit_non_first_top_level_task:
          tasks:
            - task_key: alpha
              timeout_seconds: 12
              notebook_task:
                notebook_path: /Workspace/non-first-alpha

        edit_target_task:
          tasks:
            - task_key: alpha
              timeout_seconds: 21
              depends_on:
                - task_key: zzz
              notebook_task:
                notebook_path: /Workspace/edit-target-alpha

        edit_target_sibling_after_shared_task:
          tasks:
            - task_key: shared
              timeout_seconds: 31
              depends_on:
                - task_key: target_dep
            - task_key: omega
              timeout_seconds: 32
              notebook_task:
                notebook_path: /Workspace/target-sibling-omega

        flow_style_mapping:
          tasks: [{task_key: aardvark, timeout_seconds: 703, notebook_task: {notebook_path: /Workspace/flow-target}}]

        remove_tasks_from_both_blocks:
          tasks:
            - task_key: a
              notebook_task:
                notebook_path: /Workspace/remove-a
            - task_key: e
              notebook_task:
                notebook_path: /Workspace/remove-e

        remove_and_edit_same_block:
          tasks:
            - task_key: a
              timeout_seconds: 83
              notebook_task:
                notebook_path: /Workspace/remove-edit-a

        preserve_variable_on_rename:
          tasks:
            - task_key: variable_task
              notebook_task:
                notebook_path: ${var.notebook_path}

        preserve_variable_on_clone:
          tasks:
            - task_key: variable_task
              notebook_task:
                notebook_path: ${var.notebook_path}

        edit_scalar_with_split_tasks:
          tasks:
            - task_key: target_task
              notebook_task:
                notebook_path: /Workspace/edit-scalar-target

        target_only_resource:
          tasks:
            - task_key: alpha
              notebook_task:
                notebook_path: /Workspace/target-only-alpha
