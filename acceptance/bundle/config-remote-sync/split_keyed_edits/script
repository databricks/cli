#!/bin/bash

envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
  trace $CLI bundle destroy --auto-approve -t dev
}
trap cleanup EXIT

$CLI bundle deploy -t dev

non_first_top_id="$(read_id.py -t dev edit_non_first_top_level_task)"
target_task_id="$(read_id.py -t dev edit_target_task)"
target_sibling_id="$(read_id.py -t dev edit_target_sibling_after_shared_task)"
flow_id="$(read_id.py -t dev flow_style_mapping)"
remove_both_id="$(read_id.py -t dev remove_tasks_from_both_blocks)"
remove_and_edit_id="$(read_id.py -t dev remove_and_edit_same_block)"
rename_variable_id="$(read_id.py -t dev preserve_variable_on_rename)"
clone_variable_id="$(read_id.py -t dev preserve_variable_on_clone)"
scalar_id="$(read_id.py -t dev edit_scalar_with_split_tasks)"
target_only_resource_id="$(read_id.py -t dev target_only_resource)"

title "Edit a non-first merged task from the top-level block"
edit_resource.py jobs "$non_first_top_id" <<'EOF'
next(t for t in r["tasks"] if t["task_key"] == "beta")["timeout_seconds"] = 101
EOF

title "Edit a task and add a dependency in the target block"
edit_resource.py jobs "$target_task_id" <<'EOF'
task = next(t for t in r["tasks"] if t["task_key"] == "alpha")
task["timeout_seconds"] = 202
task["depends_on"].append({"task_key": "yyy"})
EOF

title "Edit a target sibling and nested list under a task defined in both blocks"
edit_resource.py jobs "$target_sibling_id" <<'EOF'
shared = next(t for t in r["tasks"] if t["task_key"] == "shared")
shared["depends_on"].append({"task_key": "new_dep"})
next(t for t in r["tasks"] if t["task_key"] == "omega")["timeout_seconds"] = 303
EOF

title "Flow-style list elements retain distinct physical positions"
edit_resource.py jobs "$flow_id" <<'EOF'
next(t for t in r["tasks"] if t["task_key"] == "beta")["timeout_seconds"] = 799
EOF

title "Remove tasks from both blocks"
edit_resource.py jobs "$remove_both_id" <<'EOF'
r["tasks"] = [t for t in r["tasks"] if t["task_key"] not in {"b", "e"}]
EOF

title "Remove and edit tasks in one source block"
edit_resource.py jobs "$remove_and_edit_id" <<'EOF'
r["tasks"] = [t for t in r["tasks"] if t["task_key"] != "q"]
next(t for t in r["tasks"] if t["task_key"] == "r")["timeout_seconds"] = 808
EOF

title "Rename and clone a task without resolving its variable-backed field"
edit_resource.py jobs "$rename_variable_id" <<'EOF'
import copy

source = next(t for t in r["tasks"] if t["task_key"] == "variable_task")
source["task_key"] = "variable_task_renamed"
clone = copy.deepcopy(source)
clone["task_key"] = "a_variable_clone"
clone["timeout_seconds"] = 1010
r["tasks"].append(clone)
EOF

title "Clone a variable-backed target task into a missing top-level list"
edit_resource.py jobs "$clone_variable_id" <<'EOF'
import copy

clone = copy.deepcopy(r["tasks"][0])
clone["task_key"] = "cloned_to_top"
r["tasks"].append(clone)
EOF

title "Edit a scalar on a resource that also has split tasks"
edit_resource.py jobs "$scalar_id" <<'EOF'
r["timeout_seconds"] = 1111
EOF

title "A new element on a target-only resource stays in the target scope"
edit_resource.py jobs "$target_only_resource_id" <<'EOF'
r["tasks"].append({
    "task_key": "beta",
    "notebook_task": {"notebook_path": "/Workspace/target-only-beta"},
})
EOF

title "Sync split keyed-list edits"
echo
cp databricks.yml databricks.yml.backup
$CLI bundle config-remote-sync -t dev --save

title "Configuration changes"
echo
trace diff.py databricks.yml.backup databricks.yml
rm databricks.yml.backup

title "Variable references remain references"
echo
trace grep -Fc 'notebook_path: ${var.notebook_path}' databricks.yml

title "Second sync is idempotent"
echo
cp databricks.yml databricks.yml.second-backup
$CLI bundle config-remote-sync -t dev --save | contains.py "No changes detected."
trace diff.py databricks.yml.second-backup databricks.yml
rm databricks.yml.second-backup
