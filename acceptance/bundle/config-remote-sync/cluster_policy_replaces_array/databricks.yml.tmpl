bundle:
  name: test-bundle-$UNIQUE_NAME

workspace:
  root_path: ~/.bundle/$UNIQUE_NAME

resources:
  jobs:
    test_job:
      name: test-job-$UNIQUE_NAME
      tasks:
        - task_key: main
          new_cluster:
            policy_id: $POLICY_ID
            spark_version: $DEFAULT_SPARK_VERSION
            node_type_id: $NODE_TYPE_ID
            num_workers: 1
            init_scripts:
              - workspace:
                  destination: /Workspace/init-a.sh
              - workspace:
                  destination: /Workspace/init-b.sh
          spark_python_task:
            python_file: ./hello.py
