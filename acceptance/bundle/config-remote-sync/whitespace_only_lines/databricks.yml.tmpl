bundle:
  name: test-bundle-$UNIQUE_NAME

resources:
  jobs:
    my_job:
      name: test-job-$UNIQUE_NAME
      job_clusters:
        - job_cluster_key: main
          new_cluster:
            spark_version: $DEFAULT_SPARK_VERSION
            node_type_id: $NODE_TYPE_ID
            num_workers: 1
            spark_env_vars: null
      tasks:
        - task_key: main
          job_cluster_key: main
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/notebook

targets:
  default:
    resources:
      jobs:
        my_job:
          job_clusters:
            - job_cluster_key: main
              new_cluster:
                spark_env_vars:
                  EXISTING: preserved
