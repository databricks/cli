bundle:
  name: test-bundle-$UNIQUE_NAME

workspace:
  root_path: ~/.bundle/$UNIQUE_NAME/${bundle.target}

variables:
  policy_id:
    description: Policy managed outside this bundle

resources:
  jobs:
    policy_sync:
      name: test-job-$UNIQUE_NAME-${bundle.target}
      description: Before UI edit
      job_clusters:
        - job_cluster_key: main
          new_cluster:
            policy_id: ${var.policy_id}
            spark_version: $DEFAULT_SPARK_VERSION
            node_type_id: $NODE_TYPE_ID
            num_workers: 1
            custom_tags:
              owner: bundle-author
      tasks:
        - task_key: main
          job_cluster_key: main
          spark_python_task:
            python_file: ./hello.py

targets:
  dev:
    default: true
    variables:
      policy_id: $DEV_POLICY_ID
  prod:
    variables:
      policy_id: $PROD_POLICY_ID
