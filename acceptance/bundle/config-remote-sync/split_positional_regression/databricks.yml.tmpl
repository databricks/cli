bundle:
  name: test-bundle-$UNIQUE_NAME

variables:
  cluster_workers:
    default: 9
  dependency:
    default: nonexistent-shifted-pkg==1.0

resources:
  pipelines:
    edit_clusters_in_both_scopes:
      name: edit-clusters-in-both-scopes-$UNIQUE_NAME
      clusters:
        - label: default
          num_workers: 1
      libraries:
        - notebook:
            path: /Workspace/edit-clusters-in-both-scopes

    append_cluster_after_target:
      name: append-cluster-after-target-$UNIQUE_NAME
      clusters:
        - label: default
          num_workers: 3
      libraries:
        - notebook:
            path: /Workspace/append-cluster-after-target

    remove_target_cluster:
      name: remove-target-cluster-$UNIQUE_NAME
      clusters:
        - label: default
          num_workers: 5
      libraries:
        - notebook:
            path: /Workspace/remove-target-cluster

    remove_top_cluster_and_edit_target:
      name: remove-top-cluster-and-edit-target-$UNIQUE_NAME
      clusters:
        - label: default
          num_workers: 7
      libraries:
        - notebook:
            path: /Workspace/remove-top-cluster-and-edit-target

    cross_block_renames_with_stable_edit:
      name: cross-block-renames-with-stable-edit-$UNIQUE_NAME
      clusters:
        - label: default
          num_workers: 7
      libraries:
        - notebook:
            path: /Workspace/cross-block-renames-with-stable-edit

    remove_target_cluster_with_shared_survivor:
      name: remove-target-cluster-with-shared-survivor-$UNIQUE_NAME
      clusters:
        - label: default
          num_workers: 9
      libraries:
        - notebook:
            path: /Workspace/remove-target-cluster-with-shared-survivor

    replace_cluster_list:
      name: replace-cluster-list-$UNIQUE_NAME
      clusters:
        - label: default
          num_workers: 12
      libraries:
        - notebook:
            path: /Workspace/replace-cluster-list

    insert_between_repeated_target_entries:
      name: insert-between-repeated-target-entries-$UNIQUE_NAME
      libraries:
        - notebook:
            path: /Workspace/insert-between-repeated-target-entries

    remove_cluster_preserve_variable:
      name: remove-cluster-preserve-variable-$UNIQUE_NAME
      clusters:
        - label: default
          num_workers: 10
        - label: maintenance
          num_workers: ${var.cluster_workers}
      libraries:
        - notebook:
            path: /Workspace/remove-cluster-preserve-variable

    remove_dependency_preserve_variable:
      name: remove-dependency-preserve-variable-$UNIQUE_NAME
      libraries:
        - notebook:
            path: /Workspace/remove-dependency-preserve-variable
      environment:
        dependencies:
          - literal-to-remove
          - ${var.dependency}

    prepend_dependency_preserve_variable:
      name: prepend-dependency-preserve-variable-$UNIQUE_NAME
      libraries:
        - notebook:
            path: /Workspace/prepend-dependency-preserve-variable
      environment:
        dependencies:
          - ${var.dependency}

  jobs:
    single_block_task_changes:
      tasks:
        - task_key: a
          timeout_seconds: 130
          notebook_task:
            notebook_path: /Workspace/single-block-a
        - task_key: b
          timeout_seconds: 131
          notebook_task:
            notebook_path: /Workspace/single-block-b
        - task_key: c
          timeout_seconds: 132
          notebook_task:
            notebook_path: /Workspace/single-block-c

targets:
  dev:
    mode: development
    resources:
      pipelines:
        edit_clusters_in_both_scopes:
          clusters:
            - label: default
              node_type_id: i3.xlarge
            - label: maintenance
              num_workers: 2

        append_cluster_after_target:
          clusters:
            - label: default
              node_type_id: i3.xlarge
            - label: default
              num_workers: 30
            - label: maintenance
              num_workers: 4

        remove_target_cluster:
          clusters:
            - label: maintenance
              num_workers: 6

        remove_top_cluster_and_edit_target:
          clusters:
            - label: maintenance
              num_workers: 8
            - label: stable
              num_workers: 15

        cross_block_renames_with_stable_edit:
          clusters:
            - label: maintenance
              num_workers: 18
            - label: stable
              num_workers: 15

        remove_target_cluster_with_shared_survivor:
          clusters:
            - label: default
              num_workers: 10
            - label: maintenance
              num_workers: 11

        insert_between_repeated_target_entries:
          clusters:
            - label: default
              node_type_id: i3.xlarge
            - label: maintenance
              num_workers: 13
            - label: default
              num_workers: 14
