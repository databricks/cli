bundle:
  name: test-bundle-$UNIQUE_NAME

# The removed tasks are not in alphabetical order (d before c), while removals are
# applied in alphabetical order, so each one has to account for the earlier ones.
resources:
  jobs:
    my_job:
      tasks:
        - task_key: keep
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/keep
        - task_key: a
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/a
        - task_key: b
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/b
        - task_key: d
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/d
        - task_key: c
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/c

    # The same with a rename in place of the last removal.
    rename_job:
      tasks:
        - task_key: keep
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/keep
        - task_key: a
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/a
        - task_key: b
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/b
        - task_key: z
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/z
        - task_key: c
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/c
