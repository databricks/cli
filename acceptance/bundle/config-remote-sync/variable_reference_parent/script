#!/bin/bash

envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
  trace $CLI bundle destroy --auto-approve
  # destroy records requests too; drop the recorded file so it is not compared.
  rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

$CLI bundle deploy
job_id="$(read_id.py my_job)"

title "Edit fields under complex variables"
echo
edit_resource.py jobs $job_id <<'EOF'
r["max_concurrent_runs"] = 5

cluster = r["job_clusters"][0]["new_cluster"]
cluster["spark_conf"]["spark.executor.memory"] = "4g"
cluster["init_scripts"][0]["workspace"]["destination"] = "/Workspace/updated-init.sh"

cluster = r["job_clusters"][1]["new_cluster"]
cluster["spark_env_vars"] = {"ADDED": "value"}
cluster["custom_tags"]["added"] = "new"
cluster["custom_tags"]["changed"] = "updated"
del cluster["custom_tags"]["removed"]
EOF

title "Detect and save all changes"
echo
cp databricks.yml databricks.yml.backup
$CLI bundle config-remote-sync --save

title "Configuration changes"
echo
trace diff.py databricks.yml.backup databricks.yml
rm databricks.yml.backup

title "Telemetry"
echo
# The engine name is dropped because both EnvMatrix variants share this output.
# skipped_changes_count includes changes under both immediate and distant variable ancestors.
trace cat "$OUT_REQUESTS" | jq 'select(has("path") and .path == "/telemetry-ext") | .body.protoLogs[] | fromjson | .entry.databricks_cli_log.bundle_config_remote_sync_event | select(. != null) | del(.engine)'
