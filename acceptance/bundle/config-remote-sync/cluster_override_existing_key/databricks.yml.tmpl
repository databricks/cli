bundle:
  name: test-bundle-$UNIQUE_NAME

# cluster_id makes OverrideCompute clear job_cluster_key, so the merged config
# has no value for it even though the YAML still declares it.

resources:
  jobs:
    my_job:
      job_clusters:
        - job_cluster_key: shared
          new_cluster:
            spark_version: 13.3.x-scala2.12
            num_workers: 1
        - job_cluster_key: other
          new_cluster:
            spark_version: 13.3.x-scala2.12
            num_workers: 2
      tasks:
        - task_key: main
          job_cluster_key: shared
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/nb

targets:
  dev:
    mode: development
    cluster_id: 0101-000000-override
