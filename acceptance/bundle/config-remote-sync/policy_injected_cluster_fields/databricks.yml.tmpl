bundle:
  name: test-bundle-$UNIQUE_NAME

targets:
  default:
    mode: development

resources:
  cluster_policies:
    policy:
      name: test-policy-$UNIQUE_NAME
      definition:
        custom_tags.CostCenter:
          type: fixed
          value: dev-1234
        custom_tags.Team:
          type: fixed
          value: finops
        cluster_log_conf.type:
          type: fixed
          value: DBFS
        cluster_log_conf.path:
          type: fixed
          value: dbfs:/cluster-logs/dev
  jobs:
    job1:
      max_concurrent_runs: 1
      job_clusters:
        - job_cluster_key: shared
          new_cluster:
            policy_id: ${resources.cluster_policies.policy.id}
            spark_version: $DEFAULT_SPARK_VERSION
            node_type_id: $NODE_TYPE_ID
            num_workers: 1
      tasks:
        - task_key: shared_cluster_task
          job_cluster_key: shared
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/notebook
        - task_key: own_cluster_task
          notebook_task:
            notebook_path: /Users/{{workspace_user_name}}/notebook
          new_cluster:
            policy_id: ${resources.cluster_policies.policy.id}
            spark_version: $DEFAULT_SPARK_VERSION
            node_type_id: $NODE_TYPE_ID
            num_workers: 1
