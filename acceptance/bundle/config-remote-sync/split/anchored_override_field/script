envsubst < databricks.yml.tmpl > databricks.yml
cleanup() { trace $CLI bundle destroy --auto-approve -t dev; }
trap cleanup EXIT
$CLI bundle deploy -t dev
job_id="$(read_id.py my_job)"

title "Change the fields remotely"
edit_resource.py jobs $job_id <<PYEDIT
r["max_concurrent_runs"] = 10
r["description"] = "edited"
r["schedule"]["quartz_cron_expression"] = "0 0 2 * * ?"
PYEDIT

title "Sync edits under the anchored mapping and leaves the anchored value unapplied"
cp databricks.yml databricks.yml.backup
trace $CLI bundle config-remote-sync -t dev --save
trace diff.py databricks.yml.backup databricks.yml
rm databricks.yml.backup
trace $CLI bundle validate -t dev -o json | jq -c ".resources.jobs.my_job | {description, max_concurrent_runs, timeout_seconds}"
