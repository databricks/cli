mkdir -p .databricks/bundle/default
cp "$STATE_FILE" .databricks/bundle/default/resources.json
state_path="/Workspace/Users/${CURRENT_USER_NAME}/.bundle/test-bundle/default/state"
trace MSYS_NO_PATHCONV=1 $CLI workspace mkdirs "$state_path"
trace MSYS_NO_PATHCONV=1 $CLI workspace import "$state_path/resources.json" --file "$STATE_FILE" --format AUTO --overwrite

DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY=$(jq '.features | has("deployment_history")' "$STATE_FILE")
export DATABRICKS_BUNDLE_DEPLOYMENT_HISTORY

trace $CLI bundle plan | contains.py "Plan: 1 to add, 0 to change, 0 to delete, 0 unchanged"
trace cmp "$STATE_FILE" .databricks/bundle/default/resources.json

trace $CLI bundle deploy
trace jq '.state_version' .databricks/bundle/default/resources.json
# Deployment upgrades the version and preserves the input's feature flags.
diff <(jq -S '.features' "$STATE_FILE") <(jq -S '.features // {}' .databricks/bundle/default/resources.json)
