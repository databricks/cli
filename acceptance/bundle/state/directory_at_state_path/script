envsubst < databricks.yml.tmpl > databricks.yml

# Something else created a directory where the CLI keeps its state file.
state_path=$($CLI bundle validate -o json | jq -r .workspace.state_path)
# MSYS_NO_PATHCONV stops Git Bash on Windows from rewriting the /Workspace/... argument into a local path.
MSYS_NO_PATHCONV=1 $CLI workspace mkdirs "$state_path/resources.json"

cleanup() {
    MSYS_NO_PATHCONV=1 $CLI workspace delete --recursive "$($CLI bundle validate -o json | jq -r .workspace.root_path)"
    rm -f "$OUT_REQUESTS"
}
trap cleanup EXIT

trace musterr $CLI bundle plan
