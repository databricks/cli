# The size grows with every field appended to the schema; replacing it keeps these goldens
# stable while still asserting that the bitmap covers the whole schema (../full records it).
add_repl "$($CLI bundle bitmap schema | wc -l | tr -d ' ')" SCHEMA_SIZE

# One line per set field ("1", or "T"/"F" for a bool) after a size/context header.
trace $CLI bundle bitmap bitmap -o text > out.bitmap.txt
trace $CLI bundle bitmap bitmap -o json > out.bitmap.json

# The encoded bitmap decodes back to the same fields, with the CLI and with the
# self-contained decoder in databricks-bundles. --reinstall-package: the wheel's
# version does not change with the code, and uv would reuse a cached install.
trace $CLI bundle bitmap bitmap > bitmap.b64
trace $CLI bundle bitmap decode < bitmap.b64 > decoded.txt
diff.py out.bitmap.txt decoded.txt
trace $CLI bundle bitmap decode -o json < bitmap.b64 > decoded.json
diff.py out.bitmap.json decoded.json
# Encoding is deterministic, so re-encoding a decoded bitmap gives the same bytes.
trace $CLI bundle bitmap decode -o compressed < bitmap.b64 > recoded.b64
diff.py bitmap.b64 recoded.b64
trace uv run --isolated --no-project --reinstall-package databricks-bundles --with "$DATABRICKS_BUNDLES_WHEEL" -q python -m databricks.bundles._bitmap < bitmap.b64 > decoded-python.txt
diff.py out.bitmap.txt decoded-python.txt

trace $CLI bundle bitmap update-schema --validate

title "decode rejects input that is not an encoded bitmap\n"
echo not-a-bitmap | trace musterr $CLI bundle bitmap decode

title "-o accepts compressed, text and json\n"
trace musterr $CLI bundle bitmap bitmap -o yaml
# The message comes from Python's base64 module and varies by version, so it is logged, not diffed.
echo not-a-bitmap | trace musterr uv run --isolated --no-project --reinstall-package databricks-bundles --with "$DATABRICKS_BUNDLES_WHEEL" -q python -m databricks.bundles._bitmap 2> LOG.decode_python

title "An invalid bundle fails instead of printing a bitmap\n"
cd invalid
trace musterr $CLI bundle bitmap bitmap
