bundle:
  name: test-bundle-$UNIQUE_NAME

workspace:
  sync_mode: immutable

resources:
  jobs:
    foo:
      name: test-job-bind-$UNIQUE_NAME
      tasks:
        - task_key: my_task
          environment_key: default
          spark_python_task:
            python_file: ./hello_world.py
      environments:
        - environment_key: default
          spec:
            environment_version: "4"
  # References no bundle files. Binding it still plans the whole bundle, so the
  # snapshot that the job above depends on has to resolve even here.
  schemas:
    schema1:
      name: $SCHEMA_NAME
      catalog_name: main
      comment: This schema was created from DABs
