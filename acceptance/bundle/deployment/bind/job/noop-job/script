job_id=$(trace $CLI jobs create --json '{"name": "My Job"}' | jq -r '.job_id')
add_repl "$job_id" JOB_ID

trace $CLI bundle deployment bind job_1 $job_id --auto-approve
trace jq '{serial, resource_id: .state["resources.jobs.job_1"].__id__}' .databricks/bundle/default/resources.json
trace assert_not_exists.py .databricks/bundle/default/resources.json.wal .databricks/bundle/default/resources.json.temp-bind

trace $CLI bundle deploy

# there is a difference: in terraform there is also run_as entry
trace $CLI jobs get $job_id --output json | nostamp > out.job.json
