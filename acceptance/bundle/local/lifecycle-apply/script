envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
    rm -f out.requests.txt
}
trap cleanup EXIT

# Full-mode deploy: cluster created and stopped per lifecycle.started=false.
trace errcode $CLI bundle deploy
rm -f out.requests.txt

# Toggle to started=true; redeploy under --planmode=offline. Offline has no live
# status, but lifecycle.started changed in the config, so DoUpdate fires the Start
# based on the config change alone (not on remote state) and does not save a
# lifecycle value it never applied.
trace update_file.py databricks.yml "started: false" "started: true"
trace errcode $CLI bundle deploy --planmode=offline
title "Cluster requests during 'bundle deploy --planmode=offline' (Start expected):\n"
trace print_requests.py //clusters --sort

# Redeploying offline with no config change fires nothing: lifecycle.started did
# not change, so there is no transition to apply.
trace errcode $CLI bundle deploy --planmode=offline
title "Cluster requests during no-op offline redeploy (should be empty):\n"
trace print_requests.py //clusters --sort
