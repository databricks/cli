# Target overrides spread across included files: a null is meant to apply to the base when the target is selected,
# and a later file is meant to win over an earlier one, whether the later value is null or not.
trace $CLI bundle validate -o json -t dev | jq '.resources.jobs | {foo: (.foo | {description, max_concurrent_runs, timeout_seconds, tags, tasks: (.tasks | map({task_key, max_retries}))}), jobs: keys}'
