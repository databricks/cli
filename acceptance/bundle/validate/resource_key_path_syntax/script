# The direct engine addresses resources by path strings such as "resources.jobs.a.b",
# so keys containing "." or "[" resolve to the wrong resource; it used to panic.
musterr trace $CLI bundle validate

# Deploy must fail before uploading files, otherwise existing jobs would run
# new code under old settings.
musterr trace $CLI bundle deploy
trace print_requests.py //api

rm -f "$OUT_REQUESTS"
