setup_custom_host

# The classic profile has no workspace_id. The SDK resolves the ID from host
# metadata, but the generated host stays without ?w= so that it matches the
# profile in strict mode too.
cat > .databrickscfg <<EOT
[classic]
host = $DATABRICKS_HOST
token = $DATABRICKS_TOKEN

[custom_host]
host = $CUSTOM_HOST
workspace_id = $WORKSPACE_ID
token = $DATABRICKS_TOKEN
EOT
export DATABRICKS_CONFIG_FILE=$PWD/.databrickscfg
unset DATABRICKS_HOST
unset DATABRICKS_TOKEN

for profile in classic custom_host; do
  title "Profile $profile\n"
  trace $CLI bundle init default-minimal --config-file ./input.json --profile $profile
  cd my_default_minimal
  trace grep 'host:' databricks.yml
  trace DATABRICKS_BUNDLE_STRICT_PROFILE_MATCH=1 $CLI bundle validate -t dev
  trace $CLI bundle deploy -t dev
  cd ..
  rm -r my_default_minimal
done
