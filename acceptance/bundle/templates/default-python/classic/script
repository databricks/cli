trace $CLI bundle init default-python --config-file ./input.json --output-dir output

cd output/my_default_python
trace $CLI bundle validate -t dev
trace $CLI bundle validate -t prod

# Record which fields of this realistic template the bitmap reports as set. tail skips the
# size=N header: N grows with every field appended to the schema.
$CLI bundle bitmap bitmap -o text -t dev | tail -n +2 > ../../out.bitmap.txt

trace $CLI bundle plan -t dev
trace $CLI bundle plan -t prod

$CLI bundle plan -o json -t dev | nostamp > ../../out.plan_dev.json
$CLI bundle plan -o json -t prod | nostamp > ../../out.plan_prod.json

rm "$OUT_REQUESTS"
# With --plan variant we don't build artifacts, so we can filter out relevant log lines
$CLI bundle deploy -t dev $(readplanarg ../../out.plan_dev.json) 2>&1 | grep -vE '^Building python_artifact|^Uploading .databricks'

# The deploy sends the bundle bitmap in its telemetry event (logged, with the encoded bitmap, to
# LOG.telemetry.dev.json). Decoded, its config fields are the ones bundle bitmap reports above. Its
# telemetry flags also include those only a deploy measures, and those differ with READPLAN, so only
# the config fields are compared.
jq 'select(has("path") and .path == "/telemetry-ext") | .body.protoLogs[] | fromjson' "$OUT_REQUESTS" > ../../LOG.telemetry.dev.json
jq -r '.entry.databricks_cli_log.bundle_deploy_event.bundle_bitmap' ../../LOG.telemetry.dev.json | $CLI bundle bitmap decode | tail -n +2 | grep -v ' telemetry\.' > ../../LOG.bitmap.deploy.dev.txt
grep -v ' telemetry\.' ../../out.bitmap.txt > ../../LOG.bitmap.dev.txt
trace diff.py ../../LOG.bitmap.dev.txt ../../LOG.bitmap.deploy.dev.txt
print_requests.py --sort '^//import-file/' '^//telemetry-ext' > ../../out.requests.dev.txt
read_id.py -t dev sample_job > /dev/null
trace $CLI bundle plan -t dev  # check if if there is drift
trace $CLI bundle plan -t dev -o json | nostamp > ../../out.plan_after_deploy_dev.json

$CLI bundle deploy -t prod $(readplanarg ../../out.plan_prod.json) 2>&1 | grep -vE '^Building python_artifact|^Uploading dist'
print_requests.py --sort '^//import-file/' '^//telemetry-ext' > ../../out.requests.prod.txt
read_id.py -t prod sample_job > /dev/null
trace $CLI bundle plan -t prod  # check if there is drift
trace $CLI bundle plan -t prod -o json | nostamp > ../../out.plan_after_deploy_prod.json

# Do not affect this repository's git behaviour #2318
mv .gitignore out.gitignore
rm -r .databricks dist

cd ../../
rm "$OUT_REQUESTS"

# Calculate the difference from the serverless template
diff.py $TESTDIR/../serverless/output output/ > out.compare-vs-serverless.diff
