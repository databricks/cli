# A custom template whose output path is nested: the bundle root is
# projects/<group>/<project_name>, not <project_name> at the output root.
#
# stderr is dropped so that the golden output only pins the JSON payload; the
# success message is printed to stderr and would otherwise interleave with it.
#
# output_dir is an OS path, so it is backslash-separated on Windows. Normalize it
# to forward slashes to keep a single golden file across platforms. bundle_roots
# are always slash-separated and need no normalization.
trace $CLI bundle init . --config-file input.json --output-dir output -o json 2>/dev/null | sed 's|\\\\|/|g'

# The bundle root is the nested directory, and the CLI does not create a stray
# top-level directory named after the project.
[ -f "output/projects/alpha/yz/databricks.yml" ] || exit 1
[ ! -e "output/yz" ] || exit 1

# The Python variant is selected, so the SQL file is skipped.
[ -f "output/projects/alpha/yz/src/yz.py" ] || exit 1
[ ! -e "output/projects/alpha/yz/yz.sql" ] || exit 1

rm -r output
