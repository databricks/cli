# A built-in template outputs a single top-level directory named after the
# project, so its bundle root is that directory. This pins the contract for the
# standard shape.
#
# stderr is dropped so that the golden output only pins the JSON payload.
#
# output_dir is an OS path, so it is backslash-separated on Windows. Normalize it
# to forward slashes to keep a single golden file across platforms.
trace $CLI bundle init default-minimal --config-file ./input.json --output-dir output -o json 2>/dev/null | sed 's|\\\\|/|g'

[ -f "output/my_default_minimal/databricks.yml" ] || exit 1

# Do not affect this repository's git behaviour #2318
mv output/my_default_minimal/.gitignore output/my_default_minimal/out.gitignore

rm -r output
