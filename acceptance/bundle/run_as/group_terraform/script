title "Terraform rejects inherited group identities before planning or deploying"
trace musterr $CLI bundle plan
trace musterr $CLI bundle deploy

title "Terraform rejects explicit job group identities"
trace musterr $CLI bundle plan -t resource_group

title "Terraform accepts explicit user and service principal overrides"
trace $CLI bundle plan -t user_override

title "Direct engine accepts group identities"
trace DATABRICKS_BUNDLE_ENGINE=direct $CLI bundle plan
