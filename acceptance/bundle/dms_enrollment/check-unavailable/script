envsubst < databricks.yml.tmpl > databricks.yml

title "The workspace is enrolled, so the first deploy records history"
trace $CLI bundle deploy
trace print_requests.py --dms //api/2.0/bundle --get

title "The enrollment check starts failing: the deploy still succeeds and the bundle keeps recording"
trace fault.py "GET /api/2.0/bundle/enrollments:check" 500 0 1000
trace $CLI bundle deploy
trace print_requests.py --dms //api/2.0/bundle/enrollments --get
trace $CLI bundle plan -o json | gron.py | grep features

rm -f "$OUT_REQUESTS"
