envsubst < databricks.yml.tmpl > databricks.yml

title "Save a plan while the workspace is enrolled"
$CLI bundle plan -o json > tmp.plan.json
trace gron.py < tmp.plan.json | grep features

title "The enrollment check fails at deploy time: the deploy follows the plan and records history"
trace fault.py "GET /api/2.0/bundle/enrollments:check" 500 0 1000
trace $CLI bundle deploy --plan tmp.plan.json
trace print_requests.py --dms //api/2.0/bundle

rm -f tmp.plan.json "$OUT_REQUESTS"
