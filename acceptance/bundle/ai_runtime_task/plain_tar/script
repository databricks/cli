# The bundle dir is not a git repo, so the snapshot falls back to plain_tar of the
# working tree (no cache; timestamp-named archive).

title "deploy packages the working tree as a plain tarball\n"
trace $CLI bundle deploy

title "the snapshot tarball is uploaded to the user's repo_snapshots cache\n"
jq -r 'select(.path | test("/import-file/.*/.air/repo_snapshots/src/src_")) | .path' out.requests.txt | sort -u

title "the created job's code_source_path points at the uploaded archive\n"
jq -r 'select(.path == "/api/2.2/jobs/create") | .body.tasks[0].ai_runtime_task.code_source_path' out.requests.txt

rm out.requests.txt
