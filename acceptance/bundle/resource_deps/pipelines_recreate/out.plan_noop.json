{
  "plan_version": [PLAN_VERSION],
  "cli_version": "[CLI_VERSION]",
  "lineage": "[UUID]",
  "serial": 2,
  "plan": {
    "resources.jobs.bar": {
      "depends_on": [
        {
          "node": "resources.pipelines.foo",
          "label": "${resources.pipelines.foo.id}"
        }
      ],
      "action": "skip",
      "remote_state": {
        "deployment": {
          "kind": "BUNDLE",
          "metadata_file_path": "/Workspace/Users/[USERNAME]/.bundle/test-bundle/default/state/metadata.json"
        },
        "description": "depends on foo id [FOO_ID_2]",
        "edit_mode": "UI_LOCKED",
        "email_notifications": {},
        "format": "MULTI_TASK",
        "max_concurrent_runs": 1,
        "name": "job bar",
        "queue": {
          "enabled": true
        },
        "timeout_seconds": 0,
        "webhook_notifications": {},
        "created_time": [UNIX_TIME_MILLIS][0],
        "creator_user_name": "[USERNAME]",
        "job_id": [BAR_ID],
        "run_as_user_name": "[USERNAME]"
      },
      "changes": {
        "email_notifications": {
          "action": "skip",
          "reason": "empty",
          "remote": {}
        },
        "timeout_seconds": {
          "action": "skip",
          "reason": "empty",
          "remote": 0
        },
        "webhook_notifications": {
          "action": "skip",
          "reason": "empty",
          "remote": {}
        }
      }
    },
    "resources.pipelines.foo": {
      "action": "skip",
      "remote_state": {
        "channel": "CURRENT",
        "deployment": {
          "kind": "BUNDLE",
          "metadata_file_path": "/Workspace/Users/[USERNAME]/.bundle/test-bundle/default/state/metadata.json"
        },
        "edition": "ADVANCED",
        "id": "[FOO_ID_2]",
        "name": "pipeline foo",
        "storage": "dbfs:/my-new-storage",
        "creator_user_name": "[USERNAME]",
        "effective_publishing_mode": "DEFAULT_PUBLISHING_MODE",
        "last_modified": [UNIX_TIME_MILLIS][1],
        "pipeline_id": "[FOO_ID_2]",
        "run_as_user_name": "[USERNAME]",
        "state": "IDLE"
      }
    }
  }
}
