{
  "method": "POST",
  "path": "/api/2.2/jobs/reset",
  "body": {
    "job_id": [FOO_ID],
    "new_settings": {
      "name": "foo",
      "trigger": {
        "pause_status": "UNPAUSED",
        "periodic": {
          "interval": 1,
          "unit": "HOURS"
        }
      },
      "max_concurrent_runs": 1,
      "job_clusters": [
        {
          "job_cluster_key": "key",
          "new_cluster": {
            "spark_version": "13.3.x-scala2.12",
            "num_workers": 0
          }
        }
      ],
      "format": "MULTI_TASK",
      "queue": {
        "enabled": true
      },
      "edit_mode": "UI_LOCKED",
      "deployment": {
        "kind": "BUNDLE",
        "metadata_file_path": "/Workspace/Users/[USERNAME]/.bundle/test-bundle/default/state/metadata.json"
      }
    }
  }
}
