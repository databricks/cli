cp databricks.yml full.yml

title "A reference to a resource that was never defined"
cp no_bar.yml databricks.yml
trace musterr $CLI bundle plan
trace musterr $CLI bundle deploy

title "Deploy all jobs"
cp full.yml databricks.yml
trace $CLI bundle deploy
print_requests.py --nostamp //jobs > /dev/null

title "Remove bar while foo and baz still reference it"
cp no_bar.yml databricks.yml
trace musterr $CLI bundle plan
trace musterr $CLI bundle deploy

title "Remove bar and baz: foo references only the id of bar"
cp only_foo.yml databricks.yml
trace musterr $CLI bundle plan
trace musterr $CLI bundle deploy

title "Nothing was deleted or updated"
trace print_requests.py --nostamp //jobs
cp full.yml databricks.yml
trace $CLI bundle plan
trace $CLI bundle destroy --auto-approve
