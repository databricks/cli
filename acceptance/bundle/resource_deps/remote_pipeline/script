print_requests() {
    jq --sort-keys 'select(.method != "GET" and (.path | contains("/pipeline"))) | (.body.name // empty)' < out.requests.txt
    rm out.requests.txt
}

$CLI bundle plan -o json > out.plan_create.$DATABRICKS_BUNDLE_ENGINE.json
trace $CLI bundle deploy
replace_ids.py  # normalize resource IDs shown in deploy-summary URLs
trace print_requests
$CLI bundle plan -o json > out.plan_skip.$DATABRICKS_BUNDLE_ENGINE.json
trace print_requests
