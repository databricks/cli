print_requests() {
    jq --sort-keys 'select(.method != "GET" and (.path | contains("/pipeline"))) | (.body.name // empty)' < "$OUT_REQUESTS"
    rm "$OUT_REQUESTS"
}

$CLI bundle plan -o json | nostamp > out.plan_create.json
trace $CLI bundle deploy
trace print_requests
$CLI bundle plan -o json | nostamp > out.plan_skip.json
trace print_requests
