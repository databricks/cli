job_paths() {
    jq '{
        notebook_path: .tasks[].notebook_task.notebook_path,
        project_environment: .environments[].spec.project_environment
    }'
}

trace $CLI bundle validate -o json | jq '.resources.jobs.notebook' | job_paths

trace $CLI bundle deploy
trace print_requests.py //api/2.2/jobs/create | jq '.body' | job_paths

trace update_file.py resources/job.yml ../pyproject.toml ./pyproject.toml
trace $CLI bundle deploy
trace print_requests.py //api/2.2/jobs/reset | jq '.body.new_settings' | job_paths
