title "With pipeline testing, a folder after -e maps to its deployed folder\n"
trace $CLI bundle validate -o json | jq '{job: .resources.jobs.my_job.environments[0].spec.dependencies, pipeline: .resources.pipelines.my_pipeline.environment.dependencies}'

title "Without pipeline testing, a folder after -e is an error, as before\n"
# The OS error after the message differs on Windows.
musterr env -u DATABRICKS_BUNDLE_ENABLE_EXPERIMENTAL_PIPELINE_TESTING $CLI bundle validate &> LOG.gate-off
grep -o 'Error: unable to determine if .* is not a notebook' LOG.gate-off
