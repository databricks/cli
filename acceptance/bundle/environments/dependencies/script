#!/usr/bin/env bash
set -euo pipefail

trace $CLI bundle validate

trace $CLI bundle deploy
trace jq -s '.[] | select(.path=="/api/2.2/jobs/create") | .body.environments' "$OUT_REQUESTS" | nostamp

trace jq -s '.[] | select(.path=="/api/2.0/pipelines")' "$OUT_REQUESTS" | nostamp

trace $CLI bundle validate -o json | nostamp | jq '.resources.jobs.test_job.environments'
trace $CLI bundle validate -o json | nostamp | jq '.resources.pipelines.test_pipeline.environment'

rm "$OUT_REQUESTS"
