bundle:
  name: environment_key_extras

workspace:
  root_path: "~/.bundle/$UNIQUE_NAME"

artifacts:
    my_test_code:
      type: whl
      build: uv build --wheel --no-build-isolation

resources:
  jobs:
    some_other_job:
      name: "My Wheel Job"
      tasks:
        - task_key: TestTask
          python_wheel_task:
            package_name: "my_test_code"
            entry_point: "run"
          environment_key:  "test_env"
      environments:
        - environment_key:  "test_env"
          spec:
            environment_version: "2"
            dependencies:
              - ./dist/*.whl[train]
