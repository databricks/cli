export DATA_SECURITY_MODE=USER_ISOLATION
envsubst < databricks.yml.tmpl > databricks.yml
trace cat databricks.yml
trap "errcode trace '$CLI' bundle destroy --auto-approve" EXIT
trace $CLI bundle deploy

# Add all resource IDs to runtime replacements to avoid pattern matching ambiguity
replace_ids.py

trace $CLI bundle run some_other_job

title "Make a change to code without version change and run the job again"
update_file.py my_test_code/__main__.py 'Hello from my func' 'UPDATED MY FUNC'
# Direct reads the wheel the job run installed on the cluster as drift and uninstalls it
# (deferred until the next restart); terraform does not manage cluster libraries.
trace $CLI bundle deploy &> out.deploy2.$DATABRICKS_BUNDLE_ENGINE.txt
trace $CLI bundle run some_other_job
