bundle:
  name: update-without-create-$UNIQUE_NAME

resources:
  schemas:
    schema:
      catalog_name: main
      name: schema_$UNIQUE_NAME
      grants:
        - principal: ${workspace.current_user.userName}
          privileges: [USE_SCHEMA]
  jobs:
    job:
      name: job_$UNIQUE_NAME
      tasks:
        - task_key: main
          notebook_task:
            notebook_path: ./hello.py
      permissions:
        - user_name: ${workspace.current_user.userName}
          level: IS_OWNER
