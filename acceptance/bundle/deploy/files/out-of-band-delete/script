# Regression test for https://github.com/databricks/cli/issues/1976: after the remote
# bundle files are deleted out-of-band, a plain redeploy must upload them again.

BUNDLE_PATH="/Workspace/Users/${CURRENT_USER_NAME}/.bundle/out-of-band-delete/default"

trace $CLI bundle deploy

title "After the initial deploy the python_file exists"
trace $CLI workspace get-status "$BUNDLE_PATH/files/hello_world.py" | jq '{object_type,path}'

title "Delete the remote bundle directory out-of-band (simulates deleting it in the UI)"
trace $CLI workspace delete --recursive "/Workspace/Users/${CURRENT_USER_NAME}/.bundle/out-of-band-delete"

title "Redeploy uploads the files again"
trace $CLI bundle deploy
trace $CLI workspace get-status "$BUNDLE_PATH/files/hello_world.py" | jq '{object_type,path}'

title "A redeploy without changes uploads nothing"
trace $CLI bundle deploy

title "Delete only the files directory out-of-band"
trace $CLI workspace delete --recursive "$BUNDLE_PATH/files"

title "A dry run reports the files as pending and does not recreate the directory"
# The line starting with Action lists the files in non-deterministic order, so it is filtered out.
trace $CLI bundle sync --dry-run --output text | grep -v "^Action" | sort
trace musterr $CLI workspace get-status "$BUNDLE_PATH/files"

title "bundle validate recreates the files directory without uploading anything"
trace $CLI bundle validate
trace $CLI workspace get-status "$BUNDLE_PATH/files" | jq '{object_type,path}'

title "The next deploy still uploads the files again"
trace $CLI bundle deploy
trace $CLI workspace get-status "$BUNDLE_PATH/files/hello_world.py" | jq '{object_type,path}'
