# Let the two deploy lock requests through, then inject a single 504 on the next import request, which is a file upload.
# Uploads overwrite, so they are retried and the deploy succeeds.
fault.py "POST /api/2.0/workspace/import" 504 2 1

$CLI bundle deploy

# databricks.yml is the only file. Two requests for it should appear: the initial 504 and the successful retry.
print_requests.py //api/2.0/workspace/import | jq -r .body.multipart_form.path | grep '/files/'
