# Generate a plan, then tamper only with its lineage. Generated rather than committed so the plan
# carries whatever headers the variant produces, which lets this run with recording on too.
trace $CLI bundle plan -o json | jq '.lineage = "different-lineage"' > plan.json

# Try to deploy with mismatched lineage (should fail)
trace musterr $CLI bundle deploy --plan plan.json
rm plan.json
