{
  "plan_version": [PLAN_VERSION],
  "cli_version": "[CLI_VERSION]",
  "lineage": "[UUID]",
  "serial": 1,
  "plan": {
    "resources.jobs.job": {
      "action": "skip",
      "remote_state": {
        "deployment": {
          "kind": "BUNDLE",
          "metadata_file_path": "/Workspace/Users/[USERNAME]/.bundle/test-bundle/default/state/metadata.json"
        },
        "edit_mode": "UI_LOCKED",
        "email_notifications": {},
        "format": "MULTI_TASK",
        "max_concurrent_runs": 1,
        "name": "test-job",
        "queue": {
          "enabled": true
        },
        "timeout_seconds": 0,
        "webhook_notifications": {},
        "created_time": [UNIX_TIME_MILLIS],
        "creator_user_name": "[USERNAME]",
        "job_id": [JOB_ID],
        "run_as_user_name": "[USERNAME]"
      },
      "changes": {
        "email_notifications": {
          "action": "skip",
          "reason": "empty",
          "remote": {}
        },
        "timeout_seconds": {
          "action": "skip",
          "reason": "empty",
          "remote": 0
        },
        "webhook_notifications": {
          "action": "skip",
          "reason": "empty",
          "remote": {}
        }
      }
    }
  }
}
