# Binding in development mode applies the mode's transformations to the adopted
# resource: it is renamed with the [dev <user>] prefix, its schedule is paused and
# it is tagged. The plan is the only place that shows this before it happens.
NEW_JOB_ID=$($CLI jobs create --json '{"name": "test-bind-job", "schedule": {"quartz_cron_expression": "0 0 12 * * ?", "timezone_id": "UTC"}, "environments": [{"environment_key": "default", "spec": {"client": "1"}}], "tasks": [{"task_key": "my_task", "environment_key": "default", "spark_python_task": {"python_file": "/Workspace/test.py"}}]}' | jq -r .job_id)
add_repl.py $NEW_JOB_ID NEW_JOB_ID
update_file.py databricks.yml 'PLACEHOLDER_JOB_ID' "$NEW_JOB_ID"

trace $CLI bundle plan
trace $CLI bundle plan -o json | gron.py | grep -E 'changes\.(name|schedule|tags)'
