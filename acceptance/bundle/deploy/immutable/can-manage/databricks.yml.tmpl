bundle:
  name: test-bundle-immutable-can-manage-$UNIQUE_NAME

workspace:
  sync_mode: immutable

permissions:
  - level: CAN_MANAGE
    user_name: $TEST_USER_EMAIL

resources:
  jobs:
    my_job:
      name: my job
      tasks:
        - task_key: spark_python_task
          spark_python_task:
            python_file: ./src/main.py
          environment_key: env
      environments:
        - environment_key: env
          spec:
            environment_version: "4"
