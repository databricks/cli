envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

title "Deploy the immutable snapshot"
trace $CLI bundle deploy

JOB_ID=$($CLI bundle summary -o json | jq -r '.resources.jobs.my_job.id')
SNAPSHOT_PATH_1=$($CLI jobs get "$JOB_ID" | jq -r '.settings.tasks[0].spark_python_task.python_file')
echo "First snapshot path: $SNAPSHOT_PATH_1"

title "Break the glass out of band"
# Breaking the glass grants write access to the snapshot content path (the folder holding files/
# and artifacts/) and marks the snapshot modified (dirty) for good.
CONTENT_PATH="${SNAPSHOT_PATH_1%/files/src/main.py}"
trace $CLI api post /api/2.0/snapshots:breakGlass --json "{\"snapshot_content_path\": \"$CONTENT_PATH\"}" | jq .status.dirty

title "Deploy without --force fails"
trace musterr $CLI bundle deploy

title "Deploy with --force moves to a new snapshot"
trace $CLI bundle deploy --force
SNAPSHOT_PATH_2=$($CLI jobs get "$JOB_ID" | jq -r '.settings.tasks[0].spark_python_task.python_file')
echo "Second snapshot path: $SNAPSHOT_PATH_2"
if [ "$SNAPSHOT_PATH_1" = "$SNAPSHOT_PATH_2" ]; then
    echo "ERROR: snapshot path did not change after --force"
    exit 1
fi
echo "OK: --force created a new snapshot path"

title "Redeploy reuses the new snapshot"
trace $CLI bundle deploy
SNAPSHOT_PATH_3=$($CLI jobs get "$JOB_ID" | jq -r '.settings.tasks[0].spark_python_task.python_file')
echo "Third snapshot path: $SNAPSHOT_PATH_3"
if [ "$SNAPSHOT_PATH_2" != "$SNAPSHOT_PATH_3" ]; then
    echo "ERROR: new snapshot path was not reused on redeploy"
    exit 1
fi
echo "OK: new snapshot reused on redeploy"
