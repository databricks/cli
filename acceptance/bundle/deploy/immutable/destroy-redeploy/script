envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

snapshot_path() {
    JOB_ID=$($CLI bundle summary -o json | jq -r '.resources.jobs.my_job.id')
    $CLI jobs get "$JOB_ID" | jq -r '.settings.tasks[0].spark_python_task.python_file'
}

title "Deploy the immutable snapshot"
trace $CLI bundle deploy
SNAPSHOT_PATH_1=$(snapshot_path)
echo "First snapshot path: $SNAPSHOT_PATH_1"

title "Destroy the bundle"
# The snapshot is immutable and stays in the workspace; destroy only drops it from the state.
trace $CLI bundle destroy --auto-approve

title "Deploy again moves to a new snapshot instead of the one left behind"
trace $CLI bundle deploy
SNAPSHOT_PATH_2=$(snapshot_path)
echo "Second snapshot path: $SNAPSHOT_PATH_2"
if [ "$SNAPSHOT_PATH_1" = "$SNAPSHOT_PATH_2" ]; then
    echo "ERROR: deployment reused the snapshot left behind by destroy"
    exit 1
fi
echo "OK: deployment moved to a new snapshot"

title "Redeploy reuses the new snapshot"
trace $CLI bundle deploy
SNAPSHOT_PATH_3=$(snapshot_path)
echo "Third snapshot path: $SNAPSHOT_PATH_3"
if [ "$SNAPSHOT_PATH_2" != "$SNAPSHOT_PATH_3" ]; then
    echo "ERROR: new snapshot path was not reused on redeploy"
    exit 1
fi
echo "OK: new snapshot reused on redeploy"

title "Destroy and deploy again moves to yet another snapshot"
trace $CLI bundle destroy --auto-approve
trace $CLI bundle deploy
SNAPSHOT_PATH_4=$(snapshot_path)
echo "Fourth snapshot path: $SNAPSHOT_PATH_4"
if [ "$SNAPSHOT_PATH_4" = "$SNAPSHOT_PATH_1" ] || [ "$SNAPSHOT_PATH_4" = "$SNAPSHOT_PATH_2" ]; then
    echo "ERROR: deployment reused a snapshot left behind by destroy"
    exit 1
fi
echo "OK: deployment moved to a new snapshot"
