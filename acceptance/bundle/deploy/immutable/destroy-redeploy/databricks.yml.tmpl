bundle:
  name: test-bundle-immutable-redeploy-$UNIQUE_NAME

workspace:
  sync_mode: immutable

resources:
  jobs:
    my_job:
      name: my job
      tasks:
        - task_key: spark_python_task
          spark_python_task:
            python_file: ./src/main.py
          environment_key: env
      environments:
        - environment_key: env
          spec:
            environment_version: "4"
