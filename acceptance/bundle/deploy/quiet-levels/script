envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    # Nothing left to destroy by this point; the destroy levels are exercised below.
    $CLI bundle destroy --auto-approve -qq
}
trap cleanup EXIT

title "plan: default prints the actions and the summary"
trace $CLI bundle plan

title "plan -q: summary only"
trace $CLI bundle plan -q

title "plan -qq: nothing"
trace $CLI bundle plan -qq

title "Default: per-resource lines, progress and summary"
trace $CLI bundle deploy

title "-q: summary only, no per-resource lines"
update_file.py databricks.yml 'name: my-job' 'name: my-job-renamed'
trace $CLI bundle deploy -q

title "-qq: warnings and errors only"
update_file.py databricks.yml 'name: my-job-renamed' 'name: my-job-again'
trace $CLI bundle deploy -qq

title "plan -qq stays silent when there is nothing to do"
trace $CLI bundle plan -qq

title "destroy: default prints the approval list and the summary"
trace $CLI bundle destroy --auto-approve

title "destroy -q: approval list and summary, same as default"
trace $CLI bundle deploy -qq
trace $CLI bundle destroy --auto-approve -q

# Only suppressed because --auto-approve made the listing informational. Without it the
# CLI is about to ask for consent and the listing prints at any -q level; that path needs
# a TTY, so it is covered by TestApprovalForDestroyQuiet instead.
title "destroy --auto-approve -qq: nothing"
trace $CLI bundle deploy -qq
trace $CLI bundle destroy --auto-approve -qq
