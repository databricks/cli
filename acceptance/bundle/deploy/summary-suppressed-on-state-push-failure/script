cleanup() {
    # Second deploy has no fault, so it succeeds and prints the summary; this both
    # cleans up and confirms the summary DOES print on a successful state push.
    trace $CLI bundle deploy
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

# Inject a 403 on the resource-state upload (PushResourcesState). The resources
# are created remotely, but pushing state fails afterwards. The deploy summary
# ("Deploy: ...") must NOT print, since it runs only after a successful push.
fault.py "POST /api/2.0/workspace-files/import-file/Workspace/Users/$CURRENT_USER_NAME/.bundle/test-bundle/default/state/resources.json" 403 0 1

trace errcode $CLI bundle deploy
