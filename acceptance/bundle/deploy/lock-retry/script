# Deploy once so that the state directory exists and the lock create is a single request.
$CLI bundle deploy > /dev/null 2>&1
print_requests.py > /dev/null

title "Lock create is applied, but the response is a 504: the retry finds our own lock"
fault.py --after-handler "POST /api/2.0/workspace-files/import-file/**/deploy.lock" 504 0 1
trace $CLI bundle deploy
print_requests.py //api/2.0/workspace-files/import-file | jq -c 'select(.path | contains("deploy.lock")) | [.method, .q.overwrite]'

title "Lock create is not applied and fails with a 504: the retry creates the lock"
fault.py "POST /api/2.0/workspace-files/import-file/**/deploy.lock" 504 0 1
trace $CLI bundle deploy
print_requests.py //api/2.0/workspace-files/import-file | jq -c 'select(.path | contains("deploy.lock")) | [.method, .q.overwrite]'

title "Every attempt returns a 504, but the first one is applied: reading the lock back finds it is ours"
fault.py --after-handler "POST /api/2.0/workspace-files/import-file/**/deploy.lock" 504 0 3
trace $CLI bundle deploy
print_requests.py //api/2.0/workspace-files/import-file | jq -c 'select(.path | contains("deploy.lock")) | [.method, .q.overwrite]'

title "A late lock write lands after the deploy that sent it released the lock: the next deploy replaces that lock, and its delete is not replayed after a 503"
# The last deploy recorded its locker ID as released. Recreate the lock that its late write would leave.
jq -c --arg id "$(jq -r '.released[-1]' .databricks/bundle/default/released-deploy-locks.json)" '.ID = $id' other.lock > late.lock
MSYS_NO_PATHCONV=1 $CLI workspace import /Workspace/Users/$CURRENT_USER_NAME/.bundle/test-bundle/default/state/deploy.lock --file late.lock --format AUTO > /dev/null
rm late.lock
print_requests.py > /dev/null
fault.py --after-handler --body-contains deploy.lock "POST /api/2.0/workspace/delete" 503 0 1
trace $CLI bundle deploy
print_requests.py //api/2.0/workspace | jq -c 'select(tostring | contains("deploy.lock")) | [.method, (.path | split("/")[3:5] | join("/"))]'

title "Lock is held by another deployer: the retry gets a conflict and the error names the holder"
fault.py "POST /api/2.0/workspace-files/import-file/**/deploy.lock" 504 0 1
# other.lock is a lock held by another deployer.
# MSYS_NO_PATHCONV stops Git Bash on Windows from turning the workspace path into a local one.
MSYS_NO_PATHCONV=1 $CLI workspace import /Workspace/Users/$CURRENT_USER_NAME/.bundle/test-bundle/default/state/deploy.lock --file other.lock --format AUTO > /dev/null
errcode trace $CLI bundle deploy
print_requests.py > /dev/null

title "Lock is held by another deployer and every attempt returns a 504: reading the lock back names the holder"
fault.py --after-handler "POST /api/2.0/workspace-files/import-file/**/deploy.lock" 504 0 3
errcode trace $CLI bundle deploy
print_requests.py //api/2.0/workspace-files/import-file | jq -c 'select(.path | contains("deploy.lock")) | [.method, .q.overwrite]'

title "Forced lock, every overwrite attempt returns a 504 but is applied: reading the lock back finds it is ours"
fault.py --after-handler "POST /api/2.0/workspace-files/import-file/**/deploy.lock" 504 0 3
trace $CLI bundle deploy --force-lock
print_requests.py //api/2.0/workspace-files/import-file | jq -c 'select(.path | contains("deploy.lock")) | [.method, .q.overwrite]'

title "Forced lock over another deployer's lock, every overwrite attempt returns a 504 and is not applied: the error is the 504"
MSYS_NO_PATHCONV=1 $CLI workspace import /Workspace/Users/$CURRENT_USER_NAME/.bundle/test-bundle/default/state/deploy.lock --file other.lock --format AUTO --overwrite > /dev/null
print_requests.py > /dev/null
fault.py "POST /api/2.0/workspace-files/import-file/**/deploy.lock" 504 0 3
errcode trace $CLI bundle deploy --force-lock
print_requests.py //api/2.0/workspace-files/import-file | jq -c 'select(.path | contains("deploy.lock")) | [.method, .q.overwrite]'
