# A real run in a uv workspace member provisions the shared .venv at the
# workspace root and writes the constraint block into the root pyproject.toml.
# The member keeps requires-python and the databricks-connect pin. A fake uv on
# PATH stands in for the network-dependent sync (see acceptance/cmd/psql).
mv fake-uv.sh uv
chmod +x uv
cleanup() {
  rm -f uv
}
trap cleanup EXIT
export PATH="$(pwd):$PATH"

withdir bundles/a trace $CLI environments setup-local --serverless-version 4 --output json
trace cat pyproject.toml
trace cat bundles/a/pyproject.toml
