# A uv workspace member: the plan writes the member pyproject.toml and the
# constraint block into the workspace root pyproject.toml. A fake uv on PATH
# answers `uv workspace dir` (see acceptance/cmd/psql for the pattern).
mv fake-uv.sh uv
chmod +x uv
cleanup() {
  rm -f uv
}
trap cleanup EXIT
export PATH="$(pwd):$PATH"

withdir bundles/a trace $CLI environments setup-local --serverless-version 4 --dry-run
withdir bundles/a trace $CLI environments setup-local --serverless-version 4 --dry-run --output json
