# A uv workspace member: the plan writes the member pyproject.toml and the
# constraint block into the workspace root pyproject.toml. A fake uv on PATH
# answers `uv workspace dir` (see acceptance/cmd/psql for the pattern).
mv fake-uv.sh uv
chmod +x uv
# The script changes folder, so remove the fake uv by its absolute path.
fake_uv="$(pwd)/uv"
cleanup() {
  rm -f "$fake_uv"
}
trap cleanup EXIT
export PATH="$(pwd):$PATH"

cd bundles/a
trace $CLI environments setup-local --serverless-version 4 --dry-run
trace $CLI environments setup-local --serverless-version 4 --dry-run --output json
