# uv older than 0.9.9 cannot report the workspace root, so the plan is the same
# as for a standalone project: no workspace fields.
mv fake-uv.sh uv
chmod +x uv
cleanup() {
  rm -f uv
}
trap cleanup EXIT
export PATH="$(pwd):$PATH"

trace $CLI environments setup-local --serverless-version 4 --dry-run --output json
