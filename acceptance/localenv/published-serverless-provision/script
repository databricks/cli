if [ -z "${CLOUD_ENV:-}" ]; then
  echo "SKIP_TEST needs the published databricks/environments artifacts and a package index"
  exit 0
fi

# Fetch the real published artifacts, and let uv reach the package index: the
# runner points every uv at the vendored wheels offline, which lack
# databricks-connect (a warm uv cache would hide that).
unset DATABRICKS_LOCALENV_CONSTRAINT_SOURCE_URL_TEST_OVERRIDE UV_OFFLINE UV_FIND_LINKS

# `uv python install` rewrites the minor-version links of every managed Python in
# its install dir (junctions on Windows), which breaks concurrent uv users of a
# shared dir, so give it a private one. Git Bash's $PWD is /c/..., which the
# native uv does not read, so use pwd -W there, as sethome does.
venv_python=.venv/bin/python
case "$OSTYPE" in
  msys*|cygwin*|win32)
    root="$(pwd -W)"
    venv_python=.venv/Scripts/python.exe
    ;;
  *) root="$PWD" ;;
esac
export UV_PYTHON_INSTALL_DIR="$root/uv-python/installs"
export UV_PYTHON_BIN_DIR="$root/uv-python/bin"
export UV_PYTHON_INSTALL_REGISTRY=0

mkdir project
cd project

$CLI environments setup-local --serverless-version 5 --output json > ../LOG.provision.json
jq '{ok, dryRun, command, mode, compute: {source: .compute.source, envKey: .compute.envKey}, artifactSource: .resolved.artifactSource, hasPythonVersion: (.resolved.pythonVersion | type == "string" and length > 0), hasDBConnectVersion: (.resolved.dbconnectVersion | type == "string" and length > 0), phases: [.phases[] | "\(.phase): \(.status)"]}' ../LOG.provision.json

title "Files in the project"
ls -A | sort
if [ -f "$venv_python" ]; then
  echo "venv python: present"
fi
for f in pyproject.toml uv.lock; do
  if [ -f "$f" ]; then
    echo "$f: regular file"
  fi
done
