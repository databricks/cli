#!/bin/sh

printf '%s\n' "$*" >> "$DOCKER_LOG"

case "$1 $2" in
  "image ls")
    if [ "$DOCKER_TEST_MODE" = daemon-error ]; then
      printf 'Cannot connect to the Docker daemon\n' >&2
      exit 1
    fi
    if [ "$DOCKER_TEST_MODE" != missing ]; then
      printf 'image-id\n'
    fi
    ;;
  "image inspect")
    case "$DOCKER_TEST_MODE" in
      inspect-error)
        printf 'Docker inspect failed\n' >&2
        exit 1
        ;;
      arm64) printf 'linux/arm64|7140000000|\n' ;;
      bad-size) printf 'linux/amd64||\n' ;;
      workdir) printf 'linux/amd64|7140000000|/app\n' ;;
      workdir-root) printf 'linux/amd64|7140000000|/\n' ;;
      *) printf 'linux/amd64|7140000000|\n' ;;
    esac
    ;;
  "manifest inspect")
    if [ "$DOCKER_TEST_MODE" = bad-size ]; then
      printf 'no such manifest: %s\n' "$4" >&2
      exit 1
    fi
    printf '{"Descriptor":{"platform":{"architecture":"amd64","os":"linux"}},"OCIManifest":{"layers":[{"size":2900000000},{"size":240000000}]}}\n'
    ;;
  pull\ *)
    if [ "$DOCKER_TEST_MODE" = pull-error ]; then
      printf 'Docker pull failed\n' >&2
      exit 1
    fi
    printf 'Docker pull progress\n'
    ;;
  tag\ *)
    exit 0
    ;;
  push\ *)
    if [ "$DOCKER_TEST_MODE" = push-error ]; then
      printf 'denied: image exceeds the registry size limit\n' >&2
      exit 1
    fi
    printf 'Docker push progress\n'
    ;;
  *)
    printf 'unexpected docker command: %s\n' "$*" >&2
    exit 1
    ;;
esac
