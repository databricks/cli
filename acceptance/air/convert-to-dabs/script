title "code_source outside the bundle directory: the error suggests the code directory's parent as --output-dir"
# Runs first: the in-place conversion below writes databricks.yml into src's parent.
musterr trace $CLI air convert-to-dabs workloads/eval.yaml

title "convert an AIR run YAML into a DABs bundle (in place, next to the source)"
trace $CLI air convert-to-dabs train.yaml

title "emitted databricks.yml (code_source packaged as a tgz artifact; no code is copied)"
trace cat databricks.yml

title "the generated command.sh carries the run command"
trace cat generated_artifacts/command.sh

title "the emitted bundle validates"
trace $CLI bundle validate

title "re-converting refuses to clobber the generated bundle"
musterr trace $CLI air convert-to-dabs train.yaml

title "--force overwrites it"
trace $CLI air convert-to-dabs train.yaml --force

title "convert a B300 run using the current SDK"
trace $CLI air convert-to-dabs b300.yaml --output-dir generated-b300

title "the B300 bundle preserves its accelerator and AI Runtime version"
trace cat generated-b300/databricks.yml

title "the current SDK recognizes B300 so bundle validation is clean"
(cd generated-b300 && trace $CLI bundle validate)

title "--force does not replace a different workload's bundle"
musterr trace $CLI air convert-to-dabs databricks-ai.yaml --force

title "databricks_ai versions use a base environment"
trace $CLI air convert-to-dabs databricks-ai.yaml --output-dir generated-databricks-ai
trace grep -E 'environment_version|base_environment' generated-databricks-ai/databricks.yml

title "the Databricks AI bundle validates"
(cd generated-databricks-ai && trace $CLI bundle validate)

title "a parent that already holds a bundle is not suggested: converting there would replace it"
musterr trace $CLI air convert-to-dabs workloads/eval.yaml
