# With the variable set, the group lists its five subcommands and stays hidden from the root help.
trace $CLI skills --help
trace $CLI --help | contains.py "!  skills " > LOG.help

# Each subcommand is a stub that exits non-zero with the not-implemented message.
musterr trace $CLI skills list
musterr trace $CLI skills read demo-skill
musterr trace $CLI skills list-files demo-skill
musterr trace $CLI skills read-file demo-skill SKILL.md
musterr trace $CLI skills search skill words
