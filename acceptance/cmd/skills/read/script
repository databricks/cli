# The skills come from the shared release fixture, read from a local folder.
export DATABRICKS_SKILLS_DIR=$TESTDIR/../release

title "A skill with a supporting file: SKILL.md, then the file list"
trace $CLI skills read guide-skill

title "A skill without supporting files"
trace $CLI skills read demo-skill

title "JSON output, with and without supporting files"
trace $CLI skills read guide-skill -o json
trace $CLI skills read demo-skill -o json

title "An unknown skill exits non-zero and points at skills list"
musterr trace $CLI skills read no-such-skill

title "A skill that needs a newer CLI: the warning goes to stderr, the skill to stdout"
trace $CLI skills read future-skill > out.stdout.txt
