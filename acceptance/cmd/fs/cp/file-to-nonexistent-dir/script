# A trailing slash on the target means "copy into this directory": it works when the directory
# exists and fails with "no such directory" when it does not. Covers local, DBFS and UC Volume
# sources and targets.
CATALOG_NAME="main"
SCHEMA_NAME="default"
VOLUME_NAME="fs-cp-test-${UNIQUE_NAME}"
VOLUME="dbfs:/Volumes/${CATALOG_NAME}/${SCHEMA_NAME}/${VOLUME_NAME}"
DBFS="dbfs:/tmp/fs-cp-test-${UNIQUE_NAME}"

cleanup() {
  $CLI volumes delete "${CATALOG_NAME}.${SCHEMA_NAME}.${VOLUME_NAME}" 2>/dev/null || true
  $CLI fs rm -r ${DBFS} 2>/dev/null || true
}
trap cleanup EXIT

$CLI volumes create "${CATALOG_NAME}" "${SCHEMA_NAME}" "${VOLUME_NAME}" MANAGED >/dev/null
for root in ${VOLUME} ${DBFS}; do
  $CLI fs mkdir $root/src
  $CLI fs cp foo.txt $root/src/foo.txt >/dev/null
done

for src_kind in local dbfs volume; do
  case $src_kind in
    local) src=foo.txt ;;
    dbfs) src=${DBFS}/src/foo.txt ;;
    volume) src=${VOLUME}/src/foo.txt ;;
  esac
  # Separate existing directory per source, so later copies are not skipped as already existing.
  existing="existing-from-$src_kind"
  mkdir -p local/$existing
  $CLI fs mkdir ${DBFS}/$existing
  $CLI fs mkdir ${VOLUME}/$existing
  for dst in local ${DBFS} ${VOLUME}; do
    title "$src -> $dst"
    trace $CLI fs cp $src $dst/$existing/
    errcode trace $CLI fs cp $src $dst/nonexistent/mydir/
  done
done

title "Copies landed in the existing directories"
for existing in existing-from-local existing-from-dbfs existing-from-volume; do
  trace cat local/$existing/foo.txt
  trace $CLI fs cat ${DBFS}/$existing/foo.txt
  trace $CLI fs cat ${VOLUME}/$existing/foo.txt
done
rm -rf local
