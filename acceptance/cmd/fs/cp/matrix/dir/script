title "Copying a directory needs --recursive"
errcode trace $CLI fs cp $SRC_DIR $SRC_DIR/foobar

title "Copy a directory into an existing one"
$CLI fs mkdir $DST_DIR/copy
trace $CLI fs cp -r $SRC_DIR $DST_DIR/copy 2>&1 | sort
trace $CLI fs cat $DST_DIR/copy/pyNb.py
trace $CLI fs cat $DST_DIR/copy/query.sql
trace $CLI fs cat $DST_DIR/copy/a/b/c/hello.txt

title "An existing file is skipped without --overwrite"
trace $CLI fs cp -r $SRC_DIR $DST_DIR/skip 2>&1 | sort
trace $CLI fs cat $DST_DIR/skip/pyNb.py
trace $CLI fs cat $DST_DIR/skip/query.sql
trace $CLI fs cat $DST_DIR/skip/a/b/c/hello.txt

title "--overwrite replaces an existing file"
trace $CLI fs cp -r --overwrite $SRC_DIR $DST_DIR/overwrite 2>&1 | sort
trace $CLI fs cat $DST_DIR/overwrite/pyNb.py
trace $CLI fs cat $DST_DIR/overwrite/query.sql
trace $CLI fs cat $DST_DIR/overwrite/a/b/c/hello.txt

# The error names the backend's storage location on DBFS, so it goes to a log.
title "Copying a directory onto a file fails and leaves the file alone"
musterr $CLI fs cp -r $SRC_DIR $DST_DIR/my_target 2>LOG.my_target
trace $CLI fs cat $DST_DIR/my_target
