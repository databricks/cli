# .gitignore excludes itself and .databricks/ so that hello.py is the only synced file.
mkdir .git
cat > .gitignore << EOF2
.databricks/
.gitignore
EOF2

# Use an ephemeral remote directory so concurrent test runs do not interfere.
remote_dir="/Users/$CURRENT_USER_NAME/sync-getstatus-504-$UNIQUE_NAME"

cleanup() {
  MSYS_NO_PATHCONV=1 $CLI workspace delete --recursive "$remote_dir" 2>/dev/null || true
  rm -rf .git .gitignore .databricks
}
trap cleanup EXIT

# Inject a single 504 on the first workspace get-status, the call that validates the sync
# target (issue #6472). The read has no side effects, so it is retried and the sync succeeds.
fault.py "GET /api/2.0/workspace/get-status" 504 0 1

# MSYS_NO_PATHCONV=1 prevents Git Bash on Windows from converting /Users/... to C:/Program Files/Git/Users/...
MSYS_NO_PATHCONV=1 $CLI sync . "$remote_dir"
