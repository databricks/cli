# Experimental skill-usage tracking: DATABRICKS_SKILLS_INVOKED adds skill/<name> pairs to the user agent.
# Only the pairs are asserted; the rest of the user agent varies by machine.

title "Env var adds the skills to the user agent on a workspace GET"
DATABRICKS_SKILLS_INVOKED=databricks-core,databricks-jobs trace $CLI current-user me > /dev/null
trace print_requests.py --get //scim/v2/Me | contains.py " skill/databricks-core skill/databricks-jobs" > /dev/null

title "Env var adds the skills on databricks api"
DATABRICKS_SKILLS_INVOKED=databricks-core MSYS_NO_PATHCONV=1 trace $CLI api get /api/2.1/clusters/list > /dev/null
trace print_requests.py --get //clusters/list | contains.py " skill/databricks-core" > /dev/null

title "Env var adds the skills from bundle commands"
DATABRICKS_SKILLS_INVOKED=databricks-dabs trace $CLI bundle validate > /dev/null
trace print_requests.py --get //scim/v2/Me | contains.py " skill/databricks-dabs" > /dev/null

title "Invalid entries are dropped and the rest is normalized"
DATABRICKS_SKILLS_INVOKED=' Databricks-Core , bad name!,,databricks-core,databricks:databricks-jobs ' trace $CLI current-user me > /dev/null
trace print_requests.py --get //scim/v2/Me | contains.py " skill/databricks-core" "!skill/databricks-core skill/" "!bad" "!databricks:" > /dev/null

title "No skills when unset"
trace $CLI current-user me > /dev/null
trace print_requests.py --get //scim/v2/Me | contains.py "!skill/" > /dev/null

title "No skills when telemetry is disabled"
DATABRICKS_SKILLS_INVOKED=databricks-core DATABRICKS_CLI_DISABLE_TELEMETRY=1 trace $CLI current-user me > /dev/null
trace print_requests.py --get //scim/v2/Me | contains.py "!skill/" > /dev/null
