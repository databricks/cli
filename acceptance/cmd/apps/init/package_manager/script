#!/bin/bash

go build -o "fake-bin/npm$(go env GOEXE)" ./npm/main.go
cp "fake-bin/npm$(go env GOEXE)" "fake-bin/npx$(go env GOEXE)"
export PATH="$PWD/fake-bin:$PATH"
export CLI_TEST_NPM_VERSION=unavailable

title "Missing pnpm fails before creating files, and the same name can be retried"
PATH="$PWD/fake-bin" musterr trace $CLI apps init --name retry-app --template pnpm-template
test ! -e retry-app
PATH="$PWD/fake-bin" trace $CLI apps init --name retry-app --template pnpm-template --skip-install
jq '.packageManager' retry-app/package.json

title "Missing npm also fails before creating files"
mkdir empty-bin
PATH="$PWD/empty-bin" musterr trace $CLI apps init --name missing-npm --template npm-only-template
test ! -e missing-npm

title "Explicit manager values must be nonempty and supported"
musterr trace $CLI apps init --name invalid-manager --package-manager= --skip-install
musterr trace $CLI apps init --name invalid-manager --package-manager yarn --skip-install
test ! -e invalid-manager

title "Python templates reject an explicit Node.js package manager"
for template in python-template python-pip-template; do
    PATH="$PWD/fake-bin" musterr trace $CLI apps init --name python-app --template "$template" --package-manager npm --skip-install
    test ! -e python-app
done
PATH="$PWD/fake-bin" trace $CLI apps init --name python-app --template python-template --skip-install

cp "fake-bin/npm$(go env GOEXE)" "fake-bin/pnpm$(go env GOEXE)"

title "Pnpm includes development dependencies and preserves the template pin"
trace NODE_ENV=production $CLI apps init --name pnpm-installed --template pnpm-template
cat pnpm-installed/node_modules/installed-pin
trace NODE_ENV=production CLI_TEST_INSTALL_MODE=retry $CLI apps init --name pnpm-retried --template pnpm-template
cat pnpm-retried/node_modules/installed-pin

title "Failed installs remove the project so the same name can be retried"
musterr trace CLI_TEST_INSTALL_MODE=fail $CLI apps init --name install-failed --template pnpm-template
test ! -e install-failed
trace $CLI apps init --name install-failed --template pnpm-template
test -d install-failed/node_modules

title "Validation after background preparation cancels installation and removes files"
musterr trace CLI_TEST_INSTALL_MODE=wait $CLI apps init --name validation-failed --template pnpm-template --run invalid
test ! -e validation-failed
test ! -e uncanceled-install

title "Failed background preparation is cleaned up even without an installer channel"
musterr trace $CLI apps init --name preparation-failed --template broken-template
test ! -e preparation-failed

title "Failed setup removes the project"
musterr trace CLI_TEST_NPM_VERSION=11.4.1 $CLI apps init --name setup-failed --template setup-template
test ! -e setup-failed

title "In-place failures preserve the current directory and existing git metadata"
mkdir -p in-place-failed/.git
musterr withdir in-place-failed trace CLI_TEST_INSTALL_MODE=fail $CLI apps init --name . --template ../pnpm-template
test -d in-place-failed/.git
test -f in-place-failed/package.json

title "A failed dev command preserves the completed project"
musterr trace $CLI apps init --name dev-failed --template pnpm-template --run dev
test -f dev-failed/package.json
test -d dev-failed/node_modules

# Test default package manager (pnpm)
trace $CLI apps init --name test-app-pnpm --skip-install

echo "=== test-app-pnpm/app.yaml ==="
cat test-app-pnpm/app.yaml

echo "=== test-app-pnpm/package.json ==="
jq '.scripts, .packageManager, .overrides' test-app-pnpm/package.json

# Test explicit npm package manager
trace $CLI apps init --name test-app-npm --package-manager npm --skip-install

echo "=== test-app-npm/app.yaml ==="
cat test-app-npm/app.yaml

echo "=== test-app-npm/package.json ==="
jq '.scripts, .packageManager, .overrides' test-app-npm/package.json

title "Standard template with pnpm"
trace $CLI apps init --name standard-app-pnpm --template standard-template --skip-install
cat standard-app-pnpm/app.yaml
jq '.scripts, .packageManager, .overrides' standard-app-pnpm/package.json

title "Standard template with npm"
trace $CLI apps init --name standard-app-npm --template standard-template --package-manager npm --skip-install
cat standard-app-npm/app.yaml
jq '.scripts, .packageManager, .overrides' standard-app-npm/package.json

title "Lockless templates reject installation before creating the project"
for manager in npm pnpm; do
    musterr trace $CLI apps init --name "lockless-app-$manager" --template standard-template --package-manager "$manager"
    test ! -e "lockless-app-$manager"
done

title "Npm-only custom template rejects pnpm before copying"
musterr trace $CLI apps init --name incompatible-app --template npm-only-template --package-manager pnpm --skip-install
test ! -e incompatible-app
test -f npm-only-template/package-lock.json

title "Npm-only custom template selects npm quietly"
trace $CLI apps init --name compatible-app --template npm-only-template --skip-install
diff.py npm-only-template/package-lock.json compatible-app/package-lock.json
jq '.packageManager' compatible-app/package.json

title "Npm records the installed version in a plain template"
trace CLI_TEST_NPM_VERSION=11.4.1 $CLI apps init --name installed-app --template npm-only-template --package-manager npm
jq -r '.packageManager' installed-app/package.json > final-pin
diff.py installed-app/node_modules/installed-pin final-pin
cat final-pin

title "Npm records the installed version in a Go template"
trace CLI_TEST_NPM_VERSION=10.8.3 $CLI apps init --name rendered-app --template install-template --package-manager npm
jq -r '.packageManager' rendered-app/package.json > final-pin
diff.py rendered-app/node_modules/installed-pin final-pin
cat final-pin

title "Npm version detection failure stops before creating the project"
musterr trace $CLI apps init --name failed-app --template npm-only-template --package-manager npm
test ! -e failed-app

title "Npm invalid version stops before creating the project"
musterr trace CLI_TEST_NPM_VERSION=invalid $CLI apps init --name invalid-app --template npm-only-template --package-manager npm
test ! -e invalid-app

title "Npm empty version stops before creating the project"
musterr trace CLI_TEST_NPM_VERSION= $CLI apps init --name empty-app --template npm-only-template --package-manager npm
test ! -e empty-app

# Use a local repository to exercise default-template version resolution without network access.
cp template/databricks.yml databricks.yml
git-repo-init
git add template
git commit -qm 'Add template'
git tag template-v0.81.0
git tag template-v0.84.0
git tag template-v0.82.0
git branch 0.81-maintenance
repo_url=$(python3 -c 'from pathlib import Path; print(Path.cwd().as_uri())')
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0="url.${repo_url}/.insteadOf"
export GIT_CONFIG_VALUE_0="https://github.com/databricks/appkit"
export DATABRICKS_APPKIT_TEMPLATE_PATH=""

title "Version-like branch keeps pnpm"
trace $CLI apps init --name branch-app --branch 0.81-maintenance --skip-install
cat branch-app/app.yaml
jq '.packageManager' branch-app/package.json

title "First dual-manager template version keeps pnpm"
trace $CLI apps init --name dual-manager-app --version 0.82.0 --package-manager pnpm --skip-install
cat dual-manager-app/app.yaml
jq '.scripts.build, .packageManager' dual-manager-app/package.json

title "Version downgrade uses npm throughout"
trace $CLI apps init --name older-app --version 0.81.0 --skip-install
cat older-app/app.yaml
jq '.scripts.build, .packageManager' older-app/package.json

title "Explicit pnpm on an older template warns before selecting npm"
trace $CLI apps init --name explicit-older-app --version 0.81.0 --package-manager pnpm --skip-install
jq '.packageManager' explicit-older-app/package.json

title "Missing version falls back to the embedded template and its package manager"
trace DATABRICKS_CACHE_DIR=cache DATABRICKS_CACHE_ENABLED=true DATABRICKS_FORCE_EMBEDDED_COMPAT=false $CLI apps init --name fallback-app --skip-install
cat fallback-app/app.yaml
jq '.scripts.build, .packageManager' fallback-app/package.json

title "Version downgrade resolves the installed npm pin"
trace CLI_TEST_NPM_VERSION=11.4.1 $CLI apps init --name installed-older-app --version 0.81.0
jq '.packageManager' installed-older-app/package.json
cat installed-older-app/node_modules/installed-pin
