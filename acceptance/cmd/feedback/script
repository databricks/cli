# Print the feedback event, keeping only user agent entries that carry feedback
# context; the rest depend on the runner.
print_feedback() {
  trace print_requests.py //telemetry-ext | jq '.body.protoLogs[] | fromjson
      | .entry.fast_feedback_log.user_agent |= (split(" ") | map(select(test("^(cli|cmd|run-id|agent)/"))) | join(" "))'
}

title "Feedback help explains content guidance and agent submissions"
trace $CLI feedback --help

title "Feedback about a product command is routed to its team"
trace $CLI feedback --command "air run" --run-id 123 --can-be-contacted "  logs omitted the failure reason  "
print_feedback

title "A command group, with a JSON receipt"
trace $CLI feedback --command bundle "deploy should print which resources changed" -o json
print_feedback

title "Feedback can name a nested command"
trace $CLI feedback --command "bundle  deploy" "deploy is slow"
print_feedback

title "A command without a product team goes to the CLI team"
trace $CLI feedback --command "no-such-command" "hello"
print_feedback

title "Validation errors send nothing"
musterr trace $CLI feedback "   "
musterr trace $CLI feedback
musterr trace $CLI feedback deploy is slow
musterr trace $CLI feedback --command bundle deploy "deploy is slow"
musterr trace $CLI feedback --command "bundle deploy -t dev" "hello"
musterr trace $CLI feedback --run-id abc "hello"
musterr trace $CLI feedback --target dev "hello"

title "Input errors are reported before authenticating"
musterr trace env -u DATABRICKS_HOST -u DATABRICKS_TOKEN $CLI feedback "   "
musterr trace env -u DATABRICKS_HOST -u DATABRICKS_TOKEN AGENT=test-agent $CLI feedback --run-id abc "hello"
musterr trace env -u DATABRICKS_HOST -u DATABRICKS_TOKEN AGENT=test-agent $CLI feedback --yes=false "hello"

title "General CLI feedback"
trace $CLI feedback "the CLI should support ..."
print_feedback

title "An AI agent can submit without confirmation"
trace AGENT=test-agent $CLI feedback "hello" < /dev/null
print_feedback

title "An AI agent can receive a JSON receipt"
trace AGENT=test-agent $CLI feedback "agent JSON feedback" -o json < /dev/null
print_feedback

title "An explicit rejection from an AI agent sends nothing"
musterr trace AGENT=test-agent $CLI feedback --yes=false "hello"
musterr trace AGENT=test-agent $CLI feedback -y=false "hello"
trace assert_not_exists.py "$OUT_REQUESTS"

title "The deprecated --yes flag remains accepted"
trace AGENT=test-agent $CLI feedback --yes "hello"
print_feedback

title "Feedback is sent even with telemetry disabled"
trace DATABRICKS_CLI_DISABLE_TELEMETRY=1 $CLI feedback "telemetry is disabled"
print_feedback

title "A broken bundle does not block feedback"
trace withdir broken-bundle $CLI feedback "bundle config does not block feedback"
print_feedback
