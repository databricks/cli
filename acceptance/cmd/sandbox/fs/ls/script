title "Help"
trace $CLI sandbox fs ls --help

$CLI sandbox fs cp hello.txt $SANDBOX_ROOT/hello.txt > /dev/null
$CLI sandbox fs mkdir $SANDBOX_ROOT/dir

title "List a directory"
trace $CLI sandbox fs ls $SANDBOX_ROOT
trace $CLI sandbox fs ls --absolute $SANDBOX_ROOT

title "List a file, then a missing path"
musterr trace $CLI sandbox fs ls $SANDBOX_ROOT/hello.txt
musterr trace $CLI sandbox fs ls $SANDBOX_ROOT/missing

title "Complete the entries of a directory, then a partial name"
trace $CLI __complete sandbox fs ls $SANDBOX_ROOT/
trace $CLI __complete sandbox fs ls $SANDBOX_ROOT/d

title "List a directory given with a trailing slash"
trace $CLI sandbox fs ls $SANDBOX_ROOT/
