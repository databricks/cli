# Malformed -L specs are rejected before any API call, so no [[Server]] stub is needed.
musterr $CLI sandbox forward happy-panda-1234 -L 8080

# Remote ports outside 1-65535 are refused up front.
musterr $CLI sandbox forward happy-panda-1234 -L 8080:0

# At least one -L is required.
musterr $CLI sandbox forward happy-panda-1234
