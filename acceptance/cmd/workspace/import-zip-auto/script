# Documents how POST /api/2.0/workspace/import handles a .zip and names reserved for
# other asset types. archive.zip holds a single top-level folder: pkg/a.txt, pkg/sub/c.txt.
DIR="/Workspace/Users/$CURRENT_USER_NAME/$UNIQUE_NAME"
$CLI workspace mkdirs "$DIR"

cleanup() {
  $CLI workspace delete "$DIR" --recursive
}
trap cleanup EXIT

list() {
  $CLI workspace list "$1" -o json | jq -r 'sort_by(.path)[] | "\(.object_type) \(.path)"'
}

title "AUTO extracts a .zip into a folder named after the archive, without .zip\n"
trace $CLI workspace import "$DIR/archive.zip" --file archive.zip --format AUTO
trace list "$DIR"
# The archive's single top-level folder (pkg/) is replaced by the target folder.
trace list "$DIR/archive"
trace list "$DIR/archive/sub"

title "Importing the archive again is rejected, with or without overwrite\n"
trace musterr $CLI workspace import "$DIR/archive.zip" --file archive.zip --format AUTO --overwrite
trace musterr $CLI workspace import "$DIR/archive.zip" --file archive.zip --format AUTO

title "RAW stores the archive as a file, and overwrites it\n"
trace $CLI workspace import "$DIR/raw.zip" --file archive.zip --format RAW
trace $CLI workspace import "$DIR/raw.zip" --file archive.zip --format RAW --overwrite

title "AUTO rejects names reserved for asset types it cannot import; RAW stores them as files\n"
trace musterr $CLI workspace import "$DIR/space.geniespace.json" --file space.geniespace.json --format AUTO
trace $CLI workspace import "$DIR/space.geniespace.json" --file space.geniespace.json --format RAW

trace list "$DIR"
