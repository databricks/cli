# Documents POST /api/2.0/workspace/import for bom.sql, a SQL notebook whose first line
# starts with a UTF-8 byte order mark (see bundle/sync-notebook-detection).
DIR="/Workspace/Users/$CURRENT_USER_NAME/$UNIQUE_NAME"
$CLI workspace mkdirs "$DIR/notebook"
$CLI workspace mkdirs "$DIR/file"

cleanup() {
  $CLI workspace delete "$DIR" --recursive
}
trap cleanup EXIT

title "AUTO imports it as a notebook, like the legacy import-file endpoint. Overwrite can't make it a file\n"
trace $CLI workspace import "$DIR/notebook/bom.sql" --file bom.sql --format AUTO
trace musterr $CLI workspace import "$DIR/notebook/bom.sql" --file bom.sql --format RAW --overwrite

title "RAW imports it as a file, like this CLI. Overwrite can't make it a notebook\n"
trace $CLI workspace import "$DIR/file/bom.sql" --file bom.sql --format RAW
trace musterr $CLI workspace import "$DIR/file/bom.sql" --file bom.sql --format AUTO --overwrite

trace $CLI workspace list "$DIR/notebook" -o json | jq -r '.[] | "\(.object_type) \(.path)"'
trace $CLI workspace list "$DIR/file" -o json | jq -r '.[] | "\(.object_type) \(.path)"'
