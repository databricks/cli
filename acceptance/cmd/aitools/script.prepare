# print_telemetry prints each telemetry event uploaded since the last call, one
# per line: the command it ran under, its exit code, and the event without the
# rest of the execution context (timings and versions vary). print_requests.py
# clears the recorded requests, so the next call sees only the next command's
# upload. It fails when no request was recorded, hence the file check.
print_telemetry() {
    if [ -f "$OUT_REQUESTS" ]; then
        print_requests.py --oneline //telemetry-ext | jq -c '.body.protoLogs[] | fromjson
            | .entry.databricks_cli_log
            | {command: .execution_context.command, exit_code: .execution_context.exit_code}
              + (del(.execution_context))'
    fi
}
# The host's claude, codex, gemini and copilot must not run from any test under acceptance/cmd/aitools. The harness built
# stand-ins for them (see acceptance/internal/fakeagent), and they go first on PATH, so a command that runs an agent
# CLI reaches a stand-in and nothing else. An empty FAKE_AGENT_DIR would put the host's CLIs first on PATH, so the test
# stops instead.
if [[ -z "${FAKE_AGENT_DIR:-}" ]]; then
    echo "FAKE_AGENT_DIR is empty: the agent CLI stand-ins were not built" >&2
    exit 1
fi
# Each stand-in appends its argv to agent-calls.log, which a test can show with trace. An agent CLI may run in another
# directory than the test's, so the log path is absolute. Go opens it, so on msys it is in the mixed form.
export FAKE_AGENT_LOG="$PWD/agent-calls.log"
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
    export PATH="$(cygpath -u "$FAKE_AGENT_DIR"):$PATH"
    export FAKE_AGENT_LOG="$(cygpath -m "$FAKE_AGENT_LOG")"
else
    export PATH="$FAKE_AGENT_DIR:$PATH"
fi
