sethome home
mkdir -p home/.claude
envsubst < .databrickscfg > out && mv out .databrickscfg
export DATABRICKS_CONFIG_FILE=.databrickscfg

MSYS_NO_PATHCONV=1 $CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=genie_one_mcp" --profile logfood --json '{"comment":"Ask questions about your data"}' > /dev/null
rm -f "$OUT_REQUESTS"

title "Installed for two profiles: the bound profile count is 2 after the second add"
trace $CLI aitools mcp add --profile logfood --names system.ai.genie_one_mcp --agents claude-code --output json > /dev/null
mcp_events
trace $CLI aitools mcp add --profile dogfood --names system.ai.genie_one_mcp --agents claude-code --output json > /dev/null
mcp_events

title "remove --profile dogfood: CHANGED for its agent entry, and one profile stays bound"
trace $CLI aitools mcp remove --profile dogfood --output json > /dev/null
mcp_events

title "An entry changed outside this CLI is left in place: SKIPPED"
jq '.mcpServers["genie_one_mcp-logfood"].command = "/usr/bin/other"' home/.claude.json > home/claude.tmp && mv home/claude.tmp home/.claude.json
trace $CLI aitools mcp remove --names genie_one_mcp-logfood --profile logfood --output json > /dev/null
mcp_events

title "An entry already gone from the agent config is SKIPPED, and the state record goes"
jq 'del(.mcpServers["genie_one_mcp-logfood"])' home/.claude.json > home/claude.tmp && mv home/claude.tmp home/.claude.json
trace $CLI aitools mcp remove --names genie_one_mcp-logfood --profile logfood --output json > /dev/null
mcp_events

title "A record with no agent left goes with a REMOVE of its own: CHANGED with no agent, and no profile bound"
mkdir -p home/.databricks/aitools/skills
cp record-only.state.json home/.databricks/aitools/skills/.state.json
trace $CLI aitools mcp remove --names dbsql-logfood --profile logfood --output json > /dev/null
mcp_events
