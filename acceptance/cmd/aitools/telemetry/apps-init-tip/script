# Isolate HOME so the real machine's agents and skills are not seen. The
# committed home/.claude, a Claude Code config dir without Databricks skills, is
# what makes apps init print its tip.
sethome home
export CLAUDECODE=1
unset CLAUDE_CODE_SESSION_ID
unset CLAUDE_CONFIG_DIR

title "apps init with flags prints the tip: one hint-shown event per hint printed"
trace $CLI apps init --template ./template --skip-install --name app-tip > LOG.apps-init
trace print_telemetry
rm -rf app-tip

title "plugin installed: no hint, no tip, no event"
sethome ./plugin-home
trace $CLI apps init --template ./template --skip-install --name app-plugin > LOG.apps-init-plugin
trace print_telemetry
rm -rf app-plugin

title "codex and copilot plugins recorded by aitools install: no tip, no event"
# Codex and Copilot have no plugin manifest the CLI can read, so the plugin
# record in the CLI install state is what counts for them.
sethome ./recorded-plugin-home
unset CLAUDECODE
mkdir -p "$HOME/.codex" "$HOME/.copilot" "${USERPROFILE:-$HOME}/.databricks/aitools/skills"
cat > "${USERPROFILE:-$HOME}/.databricks/aitools/skills/.state.json" <<'STATE'
{
  "schema_version": 2,
  "release": "v0.2.32",
  "last_updated": "2026-01-01T00:00:00Z",
  "skills": {},
  "scope": "global",
  "plugins": {
    "codex": {"marketplace": "databricks-agent-skills", "plugin": "databricks", "scope": "user", "version": "0.2.32"},
    "copilot": {"marketplace": "databricks-agent-skills", "plugin": "databricks", "scope": "user", "version": "0.2.32"}
  }
}
STATE
trace $CLI apps init --template ./template --skip-install --name app-recorded > LOG.apps-init-recorded
trace print_telemetry
rm -rf app-recorded recorded-plugin-home
