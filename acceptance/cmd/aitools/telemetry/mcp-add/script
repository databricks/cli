sethome home
mkdir -p home/.claude home/.codex
envsubst < .databrickscfg > out && mv out .databrickscfg
export DATABRICKS_CONFIG_FILE=.databrickscfg

# Prints the aitools_mcp_event payloads uploaded since the last call, then forgets the recorded uploads.
mcp_events() {
  if [ -f "$OUT_REQUESTS" ]; then
    jq 'select(has("path") and .path == "/telemetry-ext") | .body.protoLogs[] | fromjson | .entry.databricks_cli_log.aitools_mcp_event | select(. != null)' "$OUT_REQUESTS"
    rm -f "$OUT_REQUESTS"
  fi
}

# Seeding the fake is not an MCP command, so its uploads (if any) are dropped here.
$CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=genie_one_mcp" --profile logfood --json '{"comment":"Ask questions about your data"}' > /dev/null
$CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=github" --profile logfood --json '{"comment":"Repositories, issues, pull requests","config":{"source_connection":{"name":"connections/github","options":{"oauth_provider":"github"}}}}' > /dev/null
rm -f "$OUT_REQUESTS"

title "A new install for two agents: CHANGED per (service, agent); github needs sign-in, so its sign-in state is PENDING"
$CLI aitools mcp add --profile logfood --names system.ai.genie_one_mcp,system.ai.github --agents claude-code,codex --output json > /dev/null
mcp_events

title "The same servers again are re-asserted: UNCHANGED"
$CLI aitools mcp add --profile logfood --names system.ai.genie_one_mcp,system.ai.github --agents claude-code,codex --output json > /dev/null
mcp_events

title "An agent config that does not parse fails that agent only: FAILED with AGENT_CONFIG_INVALID"
printf 'not = [valid\n' > home/.codex/config.toml
errcode $CLI aitools mcp add --profile logfood --names system.ai.genie_one_mcp --agents claude-code,codex --output json > /dev/null
mcp_events
