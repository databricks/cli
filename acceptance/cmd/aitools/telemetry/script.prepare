# A host that disables telemetry or sets a zero upload timeout would upload
# nothing, so these cases would record no events.
unset DATABRICKS_CLI_DISABLE_TELEMETRY DATABRICKS_CLI_TELEMETRY_TIMEOUT

# Prints the aitools_mcp_event payloads uploaded since the last call, then forgets the recorded uploads. The uploads are
# filtered by path with print_requests.py; jq reads only the body.
mcp_events() {
  if [ -f "$OUT_REQUESTS" ]; then
    print_requests.py //telemetry-ext | jq '.body.protoLogs[] | fromjson | .entry.databricks_cli_log.aitools_mcp_event | select(. != null)'
  fi
}
