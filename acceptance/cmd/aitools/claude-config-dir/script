export CLAUDECODE=1
unset CLAUDE_CODE_SESSION_ID

# Hint-exempt commands (aitools, auth, one-shot lookups such as version and current-user me,
# completion) skip the install hint; clusters list exercises it against the fake server.
sethome ./empty-home
title "Plugin installed only in the custom config directory"
trace CLAUDE_CONFIG_DIR=custom $CLI clusters list

sethome ./installed-home
title "Custom directory takes precedence over the default installation"
trace CLAUDE_CONFIG_DIR=missing $CLI clusters list

title "Exempt commands never hint, even without the tooling"
trace CLAUDE_CONFIG_DIR=missing $CLI current-user me | jq .userName

title "Empty override uses the default installation"
trace CLAUDE_CONFIG_DIR= $CLI clusters list

title "Unset override uses the default installation"
unset CLAUDE_CONFIG_DIR
trace $CLI clusters list
