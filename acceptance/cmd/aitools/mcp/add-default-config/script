# Isolate HOME. The profile is in the default config file, so DATABRICKS_CONFIG_FILE is unset and no config file is pinned.
sethome home
mkdir -p home/.claude
envsubst < .databrickscfg > home/.databrickscfg
unset DATABRICKS_CONFIG_FILE

# The services of system.ai, created in the fake workspace.
MSYS_NO_PATHCONV=1 $CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=genie_one_mcp" --profile logfood --json '{"comment": "Ask questions about your data"}' > /dev/null

title "Without DATABRICKS_CONFIG_FILE the server is added for the default config file"
trace $CLI aitools mcp add --profile logfood --names system.ai.genie_one_mcp --agents claude-code

title "Claude Code config has no pinned variables for the server"
trace gron.py home/.claude.json | grep -F 'mcpServers.genie_one_mcp-logfood.env'

title "State holds the binding with no config file"
trace jq '.mcp.servers[] | {name, profile, config_file}' home/.databricks/aitools/skills/.state.json
