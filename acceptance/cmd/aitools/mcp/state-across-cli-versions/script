# Isolate HOME so the agent config files, the MCP records and the skills state file land in this test directory.
sethome home
mkdir -p home/.claude home/.cursor
envsubst < .databrickscfg > out && mv out .databrickscfg
export DATABRICKS_CONFIG_FILE=.databrickscfg
state=home/.databricks/aitools/skills/.state.json
records=home/.databricks/aitools/mcp.json

# The records name the config file as the binary spells it. Git Bash's $PWD is /c/..., which the Windows binary does not
# match, so there use pwd -W, as sethome does.
case "$OSTYPE" in
  msys*|cygwin*) export CFGDIR="$(pwd -W)" ;;
  *) export CFGDIR="$PWD" ;;
esac

# The service, created in the fake workspace.
MSYS_NO_PATHCONV=1 $CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=genie_one_mcp" --profile logfood --json '{"comment": "Ask questions about your data"}' &> LOG.create-genie_one_mcp-logfood

# repoint makes the profile name the same fake workspace under another host name, as a profile that was logged in to
# another workspace does. restore undoes it.
setup_custom_host
repoint() {
    update_file.py .databrickscfg "$DATABRICKS_HOST" "$CUSTOM_HOST"
}
restore() {
    update_file.py .databrickscfg "$CUSTOM_HOST" "$DATABRICKS_HOST"
}

title "Claude Code and Cursor get the server"
trace $CLI aitools mcp add --profile logfood --names system.ai.genie_one_mcp --agents claude-code,cursor

title "With the install record, serve refuses a profile that now points at another host"
repoint
trace errcode $CLI aitools mcp serve --profile logfood --service system.ai.genie_one_mcp --agent claude-code < requests.ndjson > LOG.stdout
restore

title "A CLI older than v1.28.0 runs aitools install, then aitools uninstall"
# The MCP records have a file of their own, which a CLI older than v1.28.0 does not know. Its aitools install writes the
# skills state file, and its aitools uninstall deletes that file. No such binary is here, so the script writes the file
# as v1.27.0 does, and then deletes it.
mkdir -p home/.databricks/aitools/skills
echo '{"schema_version": 2, "release": "v0.1.0", "last_updated": "2026-01-01T00:00:00Z", "skills": {"databricks": "0.1.0"}}' > $state
trace $CLI aitools mcp list
rm $state
trace $CLI aitools mcp list

title "serve still refuses a profile that now points at another host"
repoint
trace errcode $CLI aitools mcp serve --profile logfood --service system.ai.genie_one_mcp --agent claude-code < requests.ndjson > LOG.stdout
restore

title "remove takes the server out of both agent configs"
trace $CLI aitools mcp remove --names genie_one_mcp-logfood
trace jq -c '.mcpServers // {} | keys' home/.claude.json
trace jq -c '.mcpServers // {} | keys' home/.cursor/mcp.json

title "Records that v1.28.0 wrote into the skills state file are read from there, and the next add copies them"
# v1.28.0 kept the records as a section of the skills state file. The fixture holds two servers; only one is added again.
rm $records
envsubst < v1.28.0.state.json > $state
trace $CLI aitools mcp list
trace $CLI aitools mcp add --profile logfood --names system.ai.genie_one_mcp --agents claude-code
# The section is left as it is, for a v1.28.0 binary on the same machine. The records file has both servers, the one
# that was not added again with the host and the time that v1.28.0 recorded.
trace jq -c '{skills, mcp: [.mcp.servers[].name]}' $state
trace jq -c '{schema_version, servers: [.servers[] | {name, host, installed_at, agents: (.agents | keys)}]}' $records

title "After the last server is removed the records file stays, so the section is not read again"
trace $CLI aitools mcp remove --all
trace jq -c '{schema_version, servers}' $records
trace $CLI aitools mcp list

title "A records file that a newer CLI wrote is read, and is not written"
$CLI aitools mcp add --profile logfood --names system.ai.genie_one_mcp --agents claude-code &> LOG.add-again
jq '.schema_version = 2 | .future_section = {"records": ["written by a newer CLI"]}' $records > records.tmp
mv records.tmp $records
trace $CLI aitools mcp list
trace musterr $CLI aitools mcp add --profile logfood --names system.ai.genie_one_mcp --agents cursor
trace musterr $CLI aitools mcp remove --all
trace jq -c '.mcpServers // {} | keys' home/.cursor/mcp.json
trace jq -c '{schema_version, future_section, servers: [.servers[].name]}' $records
