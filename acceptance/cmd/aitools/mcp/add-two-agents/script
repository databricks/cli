# Isolate HOME so the agent config files and the state file land in this test directory.
sethome home
mkdir -p home/.claude home/.codex
envsubst < .databrickscfg > out && mv out .databrickscfg
export DATABRICKS_CONFIG_FILE=.databrickscfg

# The services of system.ai, created in the fake workspace.
MSYS_NO_PATHCONV=1 $CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=genie_one_mcp" --profile logfood --json '{"comment": "Ask questions about your data"}' > /dev/null
MSYS_NO_PATHCONV=1 $CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=github" --profile logfood --json '{"comment": "Repositories, issues, pull requests", "config": {"source_connection": {"name": "connections/github", "options": {"oauth_provider": "OAUTH_PROVIDER_GITHUB_MCP"}}}}' > /dev/null

# Claude Code's config already holds an entry of its own, which the add keeps.
cat > home/.claude.json <<'EOF'
{
  "mcpServers": {
    "my-server": {
      "type": "stdio",
      "command": "my-server",
      "args": []
    }
  }
}
EOF

title "Two services for two agents, as JSON"
trace $CLI aitools mcp add --profile logfood --names system.ai.genie_one_mcp,system.ai.github --agents claude-code,codex --output json

title "Claude Code config keeps the entries it already had and gets ours"
trace cat home/.claude.json

title "Codex config"
trace cat home/.codex/config.toml

title "State records the binding, without the time and CLI version"
trace jq '.mcp | del(.servers[].installed_at, .servers[].cli_version)' home/.databricks/aitools/skills/.state.json
