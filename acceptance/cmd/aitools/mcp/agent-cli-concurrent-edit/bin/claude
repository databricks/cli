#!/usr/bin/env bash
# Stands in for the claude CLI, in front of the harness's stand-in on PATH. It does what Claude Code 2.1.325 does where
# the harness's stand-in does not: `mcp add-json` refuses a name that the user config already holds.
#
# Before it reads the config, it runs the script that $WHILE_CLAUDE_STARTS names, once. That script is another process
# that changes the config, or runs a second databricks command, after databricks checked the config and started claude,
# and before claude reads it.
set -euo pipefail
config="$HOME/.claude.json"

if [[ -n "${WHILE_CLAUDE_STARTS:-}" ]]; then
    hook="$WHILE_CLAUDE_STARTS"
    unset WHILE_CLAUDE_STARTS
    (cd "$TEST_DIR" && bash "$hook")
fi

case "$1 $2" in
"mcp add-json")
    name="$5"
    if jq -e --arg name "$name" '.mcpServers[$name]' "$config" > /dev/null; then
        echo "MCP server $name already exists in user config" >&2
        exit 1
    fi
    ;;
esac
exec "$FAKE_AGENT_DIR/claude" "$@"
