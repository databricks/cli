# Isolate HOME so the agent config files and the state file land in this test directory.
sethome home
envsubst < .databrickscfg > out && mv out .databrickscfg
export DATABRICKS_CONFIG_FILE="$PWD/.databrickscfg"

# The services of system.ai, created in the fake workspace. The fake keeps one workspace per token, so each profile
# gets its own copy.
MSYS_NO_PATHCONV=1 $CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=github" --profile logfood --json '{"comment": "Repositories, issues, pull requests"}' &> LOG.create-github-logfood
MSYS_NO_PATHCONV=1 $CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=github" --profile dogfood --json '{"comment": "Repositories, issues, pull requests"}' &> LOG.create-github-dogfood

# bin/claude goes in front of the harness's claude stand-in. It runs the script that WHILE_CLAUDE_STARTS names after
# databricks checked the config and started claude, and before claude reads the config. That orders a concurrent
# change without timing. claude runs in an empty directory, so the scripts find this one through TEST_DIR.
export PATH="$PWD/bin:$PATH"
export TEST_DIR="$PWD"

title "add: the user adds their own server of the same name while the claude CLI starts"
export WHILE_CLAUDE_STARTS=user-adds-entry.sh
trace musterr $CLI aitools mcp add --profile logfood --names system.ai.github --agents claude-code
unset WHILE_CLAUDE_STARTS
trace cat concurrent.log
rm concurrent.log
# claude refused to replace the user's entry, and so does databricks without --force.
trace jq -c '.mcpServers["github-logfood"] | {command, args}' home/.claude.json
trace $CLI aitools mcp list

title "remove: the direct writer checks who wrote the entry and removes it under one lock, so claude does not run"
jq 'del(.mcpServers["github-logfood"])' home/.claude.json > home/claude.tmp
mv home/claude.tmp home/.claude.json
trace $CLI aitools mcp add --profile logfood --names system.ai.github --agents claude-code
export WHILE_CLAUDE_STARTS=user-adds-entry.sh
trace $CLI aitools mcp remove --names github-logfood
unset WHILE_CLAUDE_STARTS
trace assert_not_exists.py concurrent.log
trace jq -c '.mcpServers' home/.claude.json

title "two adds of one server name, one after the other: the second is refused"
trace $CLI aitools mcp add --profile logfood --names system.ai.github --name github --agents claude-code
trace musterr $CLI aitools mcp add --profile dogfood --names system.ai.github --name github --agents claude-code
trace $CLI aitools mcp remove --all

title "the same two adds at the same time: the second starts while the first waits for the claude CLI, and is refused"
export WHILE_CLAUDE_STARTS=second-add.sh
trace $CLI aitools mcp add --profile logfood --names system.ai.github --name github --agents claude-code
unset WHILE_CLAUDE_STARTS
trace cat second-add.txt
trace jq -c '.mcpServers | map_values(.args)' home/.claude.json
trace $CLI aitools mcp list
trace $CLI aitools mcp remove --all
trace jq -c '.mcpServers' home/.claude.json
