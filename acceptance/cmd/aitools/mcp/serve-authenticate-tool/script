# Isolate HOME so the proxy finds no state file and no agent config, as on a fresh machine.
sethome home
envsubst < .databrickscfg > out && mv out .databrickscfg
export DATABRICKS_CONFIG_FILE=.databrickscfg
# No browser: the proxy prints the sign-in URL and does not open anything.
export BROWSER=none
# The sign-in is polled every 2 s, so the waits below need more attempts than the default.
export RETRY_MAX_ATTEMPTS=60

# The fake gets the GitHub service with its OAuth connection; the caller has no credential for it yet.
MSYS_NO_PATHCONV=1 $CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=github" --profile logfood --json '{"comment":"Repositories, issues, pull requests","config":{"source_connection":{"name":"connections/github","options":{"oauth_provider":"github"}}}}' &> LOG.create-github

# Stdin stays open until the last request is answered: the proxy shuts down at EOF and cancels a call
# still in flight after 2 s. Each step waits for the previous answer, so the order is deterministic.
# The last steps wait for ids 4 and 5 too, so the proxy has answered them before stdin closes.
{
  cat requests-list.ndjson
  retry --until '"id":2' cat serve.stdout.txt > /dev/null
  cat serve.stderr.txt > stderr-before-authenticate.txt
  cat requests-authenticate.ndjson
  retry --until "Waiting for sign-in" cat serve.stderr.txt > /dev/null
  MSYS_NO_PATHCONV=1 $CLI api post /api/2.1/unity-catalog/mcp-services/system.ai.github/user-credentials --profile logfood --json '{}' &> LOG.sign-in-credential
  retry --until '"id":3' cat serve.stdout.txt > /dev/null
  cat requests-after.ndjson
  retry --until '"id":4' cat serve.stdout.txt > /dev/null
  retry --until '"id":5' cat serve.stdout.txt > /dev/null
} | $CLI aitools mcp serve --profile logfood --service system.ai.github --agent claude-code > serve.stdout.txt 2> serve.stderr.txt

title "Before sign-in, tools/list answers with one tool, authenticate; it opened no sign-in"
trace jq -c 'select(.id==2) | [.result.tools[].name]' serve.stdout.txt
trace cat stderr-before-authenticate.txt

title "authenticate waits for the sign-in, then answers and asks the agent to re-list"
trace jq -c 'select(.id==3) | .result | {isError, text: .content[0].text}' serve.stdout.txt
trace jq -c 'select(.method=="notifications/tools/list_changed")' serve.stdout.txt
trace cat serve.stderr.txt

title "After the sign-in, tools/list passes through and tools/call reaches the service"
trace jq -c 'select(.id==4) | [.result.tools[].name]' serve.stdout.txt
trace jq -c 'select(.id==5) | .result.content[0].text' serve.stdout.txt

title "Stdout holds only JSON-RPC lines"
trace jq -c '.jsonrpc' serve.stdout.txt
