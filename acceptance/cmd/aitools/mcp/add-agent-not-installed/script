# Isolate HOME so the agent config files and the state file land in this test directory.
sethome home
mkdir -p home/.claude
envsubst < .databrickscfg > out && mv out .databrickscfg
export DATABRICKS_CONFIG_FILE=.databrickscfg

# The services of system.ai, created in the fake workspace.
MSYS_NO_PATHCONV=1 $CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=genie_one_mcp" --profile logfood --json '{"comment": "Ask questions about your data"}' > /dev/null

title "An agent named with --agents that is not installed is refused; the installed agent still gets the server, and the command exits non-zero"
musterr trace $CLI aitools mcp add --profile logfood --names system.ai.genie_one_mcp --agents claude-code,antigravity --output json

title "Nothing was created for Antigravity"
trace ls -A home

title "With no installed agent named, the command is refused before any request, and the text output says what to do"
musterr trace $CLI aitools mcp add --profile logfood --names system.ai.genie_one_mcp --agents antigravity
