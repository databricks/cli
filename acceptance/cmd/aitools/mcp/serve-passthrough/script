# Isolate HOME so the proxy finds no state file and no agent config, as on a fresh machine.
sethome home
envsubst < .databrickscfg > out && mv out .databrickscfg
export DATABRICKS_CONFIG_FILE=.databrickscfg

# With no install record the proxy reads the service to learn whether it needs sign-in, so the fake needs it.
MSYS_NO_PATHCONV=1 $CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=genie_one_mcp" --profile logfood --json '{"comment":"Ask questions about your data"}' > /dev/null

# DATABRICKS_HOST points elsewhere; the proxy must still talk to the profile's host.
export DATABRICKS_HOST=https://elsewhere.test

# The service the proxy serves, created in the fake workspace. The fake answers 404 for a service it does not have.
MSYS_NO_PATHCONV=1 $CLI api post "/api/2.1/unity-catalog/mcp-services?parent=schemas/system.ai&mcp_service_id=genie_one_mcp" --profile logfood --json '{"comment": "Ask questions about your data"}' &> LOG.create-genie_one_mcp-logfood

# Each stdout line must be one complete JSON value, so a pretty-printed or doubled-up message fails the filter. Responses
# may arrive in any order, so they are sorted by id.
frames='split("\n") | map(select(length > 0) | fromjson) | sort_by(.id)[] | {id, instructions: .result.instructions, tools: [.result.tools[]?.name], text: .result.content[0].text, error}'

title "Stdout holds one JSON-RPC message per line; the notification gets no reply"
trace $CLI aitools mcp serve --profile logfood --service system.ai.genie_one_mcp --agent claude-code < requests.ndjson 2> LOG.stderr | jq -Rsc "$frames"

title "Diagnostics go to stderr only"
trace cat LOG.stderr

# An agent this binary does not know still serves; it is left out of the User-Agent, with one line on stderr.
title "An agent this binary does not know is accepted"
trace $CLI aitools mcp serve --profile logfood --service system.ai.genie_one_mcp --agent future-agent < requests.ndjson 2> LOG.future | jq -Rsc "$frames"
trace cat LOG.future
