sethome "./home"

envsubst < "./home/.databrickscfg.tmpl" > "./home/.databrickscfg"

title "Initial config"
cat "./home/.databrickscfg"

title "Delete the DEFAULT profile"
trace $CLI auth logout --profile DEFAULT --auto-approve --delete

title "Backup file should exist"
assert_backup_exists

title "Config after logout — empty DEFAULT with comment should remain at the top of the file"
cat "./home/.databrickscfg"

cp "./home/.databrickscfg" "./out.databrickscfg"
