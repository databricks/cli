sethome "./home"

# The fake server issues the user codes WDJB0001, WDJB0002, ... in order.
title "A second login for the same profile replaces the first"
start_login LOG.first $CLI auth login --host $DATABRICKS_HOST --profile test --use-device-code
start_login LOG.second $CLI auth login --host $DATABRICKS_HOST --profile test --use-device-code
trace cache_keys
trace musterr $CLI auth login --host $DATABRICKS_HOST --profile test --use-device-code --user-code WDJB-0001 --confirmation-code FTFA-QQKY
trace $CLI auth login --host $DATABRICKS_HOST --profile test --use-device-code --user-code WDJB-0002 --confirmation-code FTFA-QQKY
trace print_requests.py --oneline //oidc/v1/token

title "Logins for different targets are independent"
start_login LOG.a $CLI auth login --host $DATABRICKS_HOST --profile a --use-device-code
start_login LOG.b $CLI auth login --host $DATABRICKS_HOST --profile b --use-device-code
start_login LOG.host $CLI auth login --host $DATABRICKS_HOST --use-device-code
trace cache_keys
trace $CLI auth login --host $DATABRICKS_HOST --profile b --use-device-code --user-code WDJB-0004 --confirmation-code FTFA-QQKY
trace $CLI auth login --host $DATABRICKS_HOST --use-device-code --user-code WDJB-0005 --confirmation-code FTFA-QQKY
trace $CLI auth login --host $DATABRICKS_HOST --profile a --use-device-code --user-code WDJB-0003 --confirmation-code FTFA-QQKY
trace cache_keys
trace print_requests.py --oneline //oidc/v1/token
