# cache_keys lists the keys of the tokens and of the pending logins in the
# plaintext token cache.
cache_keys() {
    jq -S '{tokens: (.tokens | keys), pending_logins: (.pending_logins // {} | keys)}' "./home/.databricks/token-cache.json"
}

# start_login traces the first step in "$@" and saves its output to file $1,
# for steps whose output was already shown.
start_login() {
    local log="$1"
    shift
    >&2 printf "\n>>> %s\n" "$*"
    "$@" &> "$log"
}
