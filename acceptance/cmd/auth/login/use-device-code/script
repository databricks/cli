sethome "./home"

title "Device code login is disabled by default\n"
trace musterr $CLI auth login --host $DATABRICKS_HOST --profile test --use-device-code

export DATABRICKS_CLI_DEVICE_CODE=true

title "Inputs device code login cannot honor are rejected\n"
trace musterr $CLI auth login --host $DATABRICKS_HOST --profile test --use-device-code --resource https://resource.test
trace musterr $CLI auth login --host $DATABRICKS_HOST --profile test --use-device-code --skip-workspace
# The profile does not exist yet and no host is given. auth login does not read
# DATABRICKS_HOST, so the usual login would fall back to the browser-based
# discovery flow, which device code login does not support.
trace musterr $CLI auth login --profile new-profile --use-device-code
cat > ./home/.databrickscfg << EOF
[scoped]
host = $DATABRICKS_HOST
auth_type = databricks-cli
resources = https://resource.test
EOF
trace musterr $CLI auth login --profile scoped --use-device-code
rm ./home/.databrickscfg

# The profile has no account ID: the host is rejected before the CLI would
# prompt for one.
title "Account hosts are rejected, whether passed directly or from a profile\n"
trace musterr $CLI auth login --host https://accounts.cloud.databricks.test --profile test --use-device-code
cat > ./home/.databrickscfg << EOF
[account]
host = https://accounts.cloud.databricks.test
EOF
trace musterr $CLI auth login --profile account --use-device-code
rm ./home/.databrickscfg

title "Login fails when no confirmation code is provided\n"
trace musterr $CLI auth login --host $DATABRICKS_HOST --profile test --use-device-code < /dev/null

title "Login fails after 3 wrong confirmation codes\n"
printf "AAAA-AAAA\nBBBB-BBBB\nCCCC-CCCC\n" | trace musterr $CLI auth login --host $DATABRICKS_HOST --profile test --use-device-code

# A wrong confirmation code leaves the device code valid, so the user can
# enter it again. A blank line asks again without contacting the workspace.
# The confirmation code is accepted the way the browser displays it, in any case.
title "Login succeeds after re-entering the confirmation code\n"
printf "AAAA-AAAA\n\nftfa-qqky\n" | trace $CLI auth login --host $DATABRICKS_HOST --profile test --use-device-code
trace $CLI auth token --profile test | gron.py | grep access_token
trace $CLI auth profiles

title "Login again with the host from the saved profile\n"
printf "FTFA-QQKY\n" | trace $CLI auth login --profile test --use-device-code
trace $CLI auth token --profile test | gron.py | grep access_token

title "Device code requests\n"
trace print_requests.py //oidc/v1/device/auth //oidc/v1/token

# The token gets the scopes requested at device authorization, so --scopes is
# sent there and not with the token request.
title "Custom scopes are requested at device authorization\n"
printf "FTFA-QQKY\n" | trace $CLI auth login --host $DATABRICKS_HOST --profile custom-scopes --use-device-code --scopes sql
trace print_requests.py //oidc/v1/device/auth //oidc/v1/token

# Track the .databrickscfg file that was created to surface changes.
mv "./home/.databrickscfg" "./out.databrickscfg"
