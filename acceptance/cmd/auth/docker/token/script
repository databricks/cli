setup_docker_auth
cat >> "$HOME/.databrickscfg" <<'ENDCFG'
workspace_id = 900800700600
ENDCFG
registry_host=900800700600.container.us-west-2.localhost

title "Cached token\n"
printf '%s\n' "$registry_host" | trace $CLI auth docker token --no-force-refresh | jq -S .

title "Refreshed token by default\n"
printf '%s\n' "$registry_host" | trace $CLI auth docker token | jq -S .

title "No profile for the workspace\n"
printf '%s\n' "111222333.container.us-west-2.localhost" | trace musterr $CLI auth docker token

title "Not an Artifact Registry host\n"
printf '%s\n' "registry.example.test" | trace musterr $CLI auth docker token

title "Profile flag not supported\n"
printf '%s\n' "$registry_host" | trace musterr $CLI auth docker token --profile docker-test

title "Positional argument not supported\n"
printf '%s\n' "$registry_host" | trace musterr $CLI auth docker token docker-test

title "Other authentication flags not supported\n"
printf '%s\n' "$registry_host" | trace musterr $CLI auth docker token --host https://other.cloud.databricks.test
printf '%s\n' "$registry_host" | trace musterr $CLI auth docker token --account-id 00000000-0000-0000-0000-000000000000
printf '%s\n' "$registry_host" | trace musterr $CLI auth docker token --workspace-id 111222333

title "Test-server registry never matches a remote workspace\n"
cat >> "$HOME/.databrickscfg" <<'ENDCFG'

[remote]
host = https://workspace.cloud.databricks.test
auth_type = databricks-cli
workspace_id = 444555666
ENDCFG
printf '%s\n' "444555666.container.us-west-2.localhost" | trace musterr $CLI auth docker token

title "Multiple profiles for the workspace use the first logged-in profile\n"
cat >> "$HOME/.databrickscfg" <<ENDCFG

[duplicate]
host = $DATABRICKS_HOST_ORIG
auth_type = databricks-cli
workspace_id = 900800700600
ENDCFG
cp token-cache.json "$HOME/.databricks/token-cache.json"
printf '%s\n' "$registry_host" | trace $CLI auth docker token --no-force-refresh | jq -S .

title "Profiles that are not logged in are skipped\n"
cat - "$HOME/.databrickscfg" > "$HOME/databrickscfg.new" <<ENDCFG
[logged-out]
host = $DATABRICKS_HOST_ORIG
auth_type = databricks-cli
workspace_id = 900800700600

ENDCFG
mv "$HOME/databrickscfg.new" "$HOME/.databrickscfg"
printf '%s\n' "$registry_host" | trace $CLI auth docker token | jq -S .

title "No logged-in profile for the workspace\n"
cat >> "$HOME/.databrickscfg" <<ENDCFG

[logged-out-a]
host = $DATABRICKS_HOST_ORIG
auth_type = databricks-cli
workspace_id = 555666777

[logged-out-b]
host = $DATABRICKS_HOST_ORIG
auth_type = databricks-cli
workspace_id = 555666777
ENDCFG
printf '%s\n' "555666777.container.us-west-2.localhost" | trace musterr $CLI auth docker token
