sethome "./home"
export DATABRICKS_CACHE_DIR="$TEST_TMP_DIR/cache"

# Point a profile at the mock server so auth describe triggers a host metadata
# fetch. auth profiles is a pure config read and never fetches, so it can't
# exercise the cache; describe resolves the config and does.
envsubst < "./home/.databrickscfg.tmpl" > "./home/.databrickscfg"

title "First invocation populates the cache\n"
$CLI auth describe --profile cached &> LOG.describe

title "Second invocation should read from the cache\n"
$CLI auth describe --profile cached &> LOG.describe

title "Only one /.well-known/databricks-config request recorded\n"
print_requests.py //.well-known/databricks-config --get --sort
