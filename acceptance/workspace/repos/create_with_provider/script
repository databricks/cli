url=https://github.com/databricks/databricks-empty-ide-project.git
provider=gitHub
path=/Repos/me@databricks.com/test-repo

repo_id=$(MSYS_NO_PATHCONV=1 trace $CLI repos create $url $provider --path $path | jq .id -r)
add_repl "$repo_id" REPO_ID

title "Get by id should work"
MSYS_NO_PATHCONV=1 trace $CLI repos get $repo_id -o json

title "Get by path should work"
MSYS_NO_PATHCONV=1 trace $CLI repos get $path -o json

title "Delete by id should work"
MSYS_NO_PATHCONV=1 trace $CLI repos delete $repo_id

trace print_requests.py --get //repos //workspace/get-status
