trace $CLI pipelines deploy
rm "$OUT_REQUESTS"

title "A test ID resolves against the folder that test IDs are relative to\n"
trace $CLI pipelines test my_pipeline tests/test_a.py::test_one
trace print_requests.py //updates | jq -c .body.test_options

