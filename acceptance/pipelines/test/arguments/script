trace $CLI pipelines test --help

title "pytest arguments must be passed with --pytest-arg"
trace musterr $CLI pipelines test --pipeline-id 1234 -k orders
trace musterr $CLI pipelines test --pipeline-id 1234 -msmoke
trace musterr $CLI pipelines test --pipeline-id 1234 -- -k orders

title "Only -k and -m are supported"
trace musterr $CLI pipelines test --pipeline-id 1234 --pytest-arg=-x
trace musterr $CLI pipelines test --pipeline-id 1234 --pytest-arg=-k
trace musterr $CLI pipelines test --pipeline-id 1234 --pytest-arg=tests/test_orders.py

title "-k and -m take their value in the next --pytest-arg"
trace musterr $CLI pipelines test --pipeline-id 1234 --pytest-arg=-korders
trace musterr $CLI pipelines test --pipeline-id 1234 --pytest-arg=-k --pytest-arg=-m

title "Incompatible run-control flags"
trace musterr $CLI pipelines test --pipeline-id 1234 tests --resume 5678
trace musterr $CLI pipelines test --pipeline-id 1234 --resume 5678 --pytest-arg=-m --pytest-arg=smoke
trace musterr $CLI pipelines test --pipeline-id 1234 --resume 5678 --no-wait
trace musterr $CLI pipelines test --pipeline-id 1234 --no-wait --timeout 10m
trace musterr $CLI pipelines test --pipeline-id 1234 --resume "5678' OR '1'='1"
trace musterr $CLI pipelines test --pipeline-id 1234 --resume ""
trace musterr $CLI pipelines test --pipeline-id 1234 --no-wait --junit-xml out.no-wait.xml

title "An invalid flag replaces an older report"
echo '<testsuites><testsuite name="1234" tests="1"><testcase name="test_old"></testcase></testsuite></testsuites>' > out.flag-error.xml
trace musterr $CLI pipelines test --pipeline-id 1234 --pytest-arg=-x --junit-xml out.flag-error.xml

title "JSON output is not supported"
trace musterr $CLI pipelines test --pipeline-id 1234 -o json
