if [ -n "$CLOUD_ENV" ] && [ -z "${TEST_PIPELINES_TESTING_ENABLED:-}" ]; then
    echo "SKIP_TEST set TEST_PIPELINES_TESTING_ENABLED for a workspace with pipeline testing enabled"
    exit 0
fi

envsubst < databricks.yml.tmpl > databricks.yml

cleanup() {
    trace $CLI bundle destroy --auto-approve
}
trap cleanup EXIT

trace $CLI bundle deploy

title "Run the tests and wait for the results\n"
# Durations differ between runs, so only the exit code, the summary line and the report are compared.
$CLI pipelines test --junit-xml junit.xml > test.log 2>&1
echo "Exit code: $?"
grep -E '^[0-9]+ tests?:' test.log
grep -o '<testcase [^>]*name="[^"]*"' junit.xml
