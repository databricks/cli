pipeline_id=$($CLI pipelines create --json '{"name": "orders", "root_path": "/Workspace/Users/someone@example.com/orders"}' | jq -r .pipeline_id)
no_root_pipeline_id=$($CLI pipelines create --json '{"name": "no-root"}' | jq -r .pipeline_id)
MSYS_NO_PATHCONV=1 $CLI workspace import-dir orders /Workspace/Users/someone@example.com/orders &> LOG.import
rm "$OUT_REQUESTS"

title "Relative test selections resolve against the pipeline root_path"
trace MSYS_NO_PATHCONV=1 $CLI pipelines test --pipeline-id $pipeline_id tests/test_orders.py::test_backfill /Workspace/Users/someone@example.com/other/tests --no-wait
trace print_requests.py //updates
# Like the service, the test server rejects a new update while one is active.
MSYS_NO_PATHCONV=1 $CLI api post /api/2.0/pipelines/$pipeline_id/stop >> LOG.stop 2>&1
rm "$OUT_REQUESTS"

title "Test case IDs are shown relative to the pipeline root_path"
trace $CLI pipelines test --pipeline-id $pipeline_id tests
rm "$OUT_REQUESTS"

title "Without a root_path, test selections must be workspace paths"
trace musterr $CLI pipelines test --pipeline-id $no_root_pipeline_id tests
rm "$OUT_REQUESTS"

title "With --no-wait and only workspace paths, the pipeline is not read"
trace MSYS_NO_PATHCONV=1 $CLI pipelines test --pipeline-id $no_root_pipeline_id /Workspace/Users/someone@example.com/tests/test_other.py::test_x --no-wait
trace print_requests.py --get //pipelines
MSYS_NO_PATHCONV=1 $CLI api post /api/2.0/pipelines/$no_root_pipeline_id/stop >> LOG.stop 2>&1
rm "$OUT_REQUESTS"

title "Without a root_path, test case IDs are absolute workspace paths"
trace MSYS_NO_PATHCONV=1 $CLI pipelines test --pipeline-id $no_root_pipeline_id /Workspace/Users/someone@example.com/orders/tests/test_orders.py
rm "$OUT_REQUESTS"

title "Outside a project, --pipeline-id is required"
trace musterr $CLI pipelines test tests
