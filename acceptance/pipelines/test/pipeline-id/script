# testing is not in the Go SDK yet, so "pipelines create" would drop it.
orders_tests='{"sources": [{"glob": {"include": "/Workspace/Users/someone@example.com/orders/tests/**"}}]}'
pipeline_id=$($CLI api post /api/2.0/pipelines --json '{"name": "orders", "root_path": "/Workspace/Users/someone@example.com/orders", "testing": '"$orders_tests"'}' | jq -r .pipeline_id)
no_root_pipeline_id=$($CLI api post /api/2.0/pipelines --json '{"name": "no-root", "testing": '"$orders_tests"'}' | jq -r .pipeline_id)
no_tests_pipeline_id=$($CLI api post /api/2.0/pipelines --json '{"name": "no-tests", "root_path": "/Workspace/Users/someone@example.com/orders"}' | jq -r .pipeline_id)
$CLI workspace import-dir orders /Workspace/Users/someone@example.com/orders &> LOG.import
rm "$OUT_REQUESTS"

title "Relative test selections resolve against the pipeline root_path"
trace $CLI pipelines test --pipeline-id $pipeline_id tests/test_orders.py::test_backfill /Workspace/Users/someone@example.com/orders/tests --no-wait
trace print_requests.py //updates
# Like the service, the test server rejects a new update while one is active.
$CLI api post /api/2.0/pipelines/$pipeline_id/stop &>> LOG.stop
rm "$OUT_REQUESTS"

title "Test case IDs are shown relative to root_path"
trace $CLI pipelines test --pipeline-id $pipeline_id tests
rm "$OUT_REQUESTS"

title "Without a root_path, test selections must be workspace paths, and test case IDs are shown in full"
trace musterr $CLI pipelines test --pipeline-id $no_root_pipeline_id tests/test_orders.py
trace $CLI pipelines test --pipeline-id $no_root_pipeline_id /Workspace/Users/someone@example.com/orders/tests/test_orders.py
rm "$OUT_REQUESTS"

title "Without test sources, the service rejects the run"
trace musterr $CLI pipelines test --pipeline-id $no_tests_pipeline_id

title "Outside a project, --pipeline-id is required"
trace musterr $CLI pipelines test tests
