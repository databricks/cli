trace $CLI pipelines deploy

title "--no-wait returns after the update starts"
trace $CLI pipelines test my_pipeline tests/test_orders.py --no-wait | tee submit.txt
update_id=$(sed -n 's/^Update: //p' submit.txt)

title "--resume reads the results of an existing update"
trace $CLI pipelines test my_pipeline --resume $update_id

title "--timeout stops waiting but not the update"
trace $CLI pipelines test my_pipeline tests/test_slow.py --no-wait | tee submit.txt
hang_update_id=$(sed -n 's/^Update: //p' submit.txt)
rm submit.txt
trace errcode $CLI pipelines test my_pipeline --resume $hang_update_id --timeout 3s

title "Another update cannot start while the test update is active"
trace errcode $CLI pipelines test my_pipeline tests/test_orders.py

title "Stopping the pipeline cancels the test update"
trace $CLI pipelines stop my_pipeline
trace errcode $CLI pipelines test my_pipeline --resume $hang_update_id
