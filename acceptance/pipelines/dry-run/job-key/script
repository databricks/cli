trace $CLI pipelines deploy
rm "$OUT_REQUESTS"

# A dry run must never execute anything. A job has no dry-run mode.
title "Dry running a job KEY"
musterr trace $CLI pipelines dry-run my_job

title "Completion only offers pipelines"
trace $CLI __complete pipelines dry-run , &> complete.txt
# Drop the machine-specific stack trace if completion panics.
sed '/^Stack Trace:/,$d' complete.txt
rm complete.txt

# Make sure that a dry run of the pipeline itself still works.
title "Dry running the pipeline KEY"
trace $CLI pipelines dry-run my_pipeline

title "Only the pipeline update is requested, with validate_only set"
print_requests.py //jobs/run-now //pipelines
