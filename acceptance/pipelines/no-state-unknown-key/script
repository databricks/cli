# The bundle is never deployed: an undefined key is reported as such,
# a defined key gets the deploy hint.
for cmd in run stop dry-run test; do
  title "pipelines $cmd with an undefined key"
  trace musterr $CLI pipelines $cmd foo

  title "pipelines $cmd with a defined key"
  trace musterr $CLI pipelines $cmd my_pipeline
done

title "pipelines dry-run with a key that is not a pipeline"
trace musterr $CLI pipelines dry-run my_job

title "pipelines dry-run without a key keeps the deploy hint"
trace musterr $CLI pipelines dry-run
