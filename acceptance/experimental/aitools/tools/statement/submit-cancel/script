# Submit returns at once with a PENDING statement; a statement this long is still
# running when the cancel lands, so it ends CANCELED. Locally the testserver's SQL
# fake tracks the statement and its cancellation.
trace $CLI experimental aitools tools statement submit "SELECT count(*) FROM range(100000000000)" > out.submit.json
cat out.submit.json
STATEMENT_ID=$(jq -r .statement_id out.submit.json)
add_repl "$STATEMENT_ID" STATEMENT_ID
rm out.submit.json

trace $CLI experimental aitools tools statement cancel "$STATEMENT_ID"
musterr trace $CLI experimental aitools tools statement get "$STATEMENT_ID"

title "cancel request"
print_requests.py //api/2.0/sql/statements | jq -r 'select(.path | endswith("/cancel")) | .method + " " + .path'
