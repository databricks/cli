# Isolate HOME so parallel aitools tests don't race on a shared ~/.databricks.
sethome home

title "install --output json emits only the JSON document; progress is silenced"
# --agents makes the run fully non-interactive (no picker, no scope prompt), which
# --output json requires. In JSON mode the command silences its human-readable
# progress, so the only thing written is the JSON payload on stdout.
trace $CLI aitools install --skills-only --scope=global --agents=claude-code --output json
