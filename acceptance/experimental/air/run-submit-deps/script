title "submit with inline dependencies"
trace $CLI experimental air run -f run.yaml

title "only config + command are uploaded; no requirements.yaml"
# Uploads go to POST /workspace/import, which carries the target filename in the
# multipart body rather than the URL, so each uploaded path shows up under
# body.multipart_form.path instead of in the request path.
trace print_requests.py //api/2.0/workspace/import --oneline --sort --unique --keep

title "declared deps ride on environments[].spec.dependencies"
trace print_requests.py //api/2.2/jobs/runs/submit

title "a requirements.yaml file path is rejected; deps must be inline"
musterr trace $CLI experimental air run -f run-file.yaml
