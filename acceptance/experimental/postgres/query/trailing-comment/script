# A single statement followed by a comment after its terminating ';' is one
# statement as far as Postgres is concerned, so the pre-flight check must let
# it through. The instance is STOPPED, so an accepted input fails at target
# resolution instead of the multi-statement check.

title "Trailing line comment after ';'"
trace musterr $CLI experimental postgres query --target my-instance "SELECT 1; -- done"

title "Trailing block comment after ';'"
trace musterr $CLI experimental postgres query --target my-instance "SELECT 1; /* done */"

title "File ending with a comment line after the statement"
printf 'SELECT 1;\n-- end of file\n' > q.sql
trace musterr $CLI experimental postgres query --target my-instance --file q.sql
rm q.sql

title "Two statements are still rejected"
trace musterr $CLI experimental postgres query --target my-instance "SELECT 1; -- one" "SELECT 1; SELECT 2"
