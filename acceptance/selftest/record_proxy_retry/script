title "A request answered with a transient error and repeated by the CLI is recorded once"
fault.py "GET /api/2.0/postgres/projects/*/operations/*" 500 0 1 INTERNAL_ERROR
trace $CLI bundle deploy
trace print_requests.py --get //postgres
$CLI bundle destroy --auto-approve &> LOG.destroy
rm -f "$OUT_REQUESTS"

title "A create answered with a transient error, looked up (404) and repeated by the CLI is recorded once"
fault.py "POST /api/2.0/postgres/projects" 500 0 1 INTERNAL_ERROR
trace $CLI bundle deploy
trace print_requests.py --get //postgres
$CLI bundle destroy --auto-approve &> LOG.destroy
rm -f "$OUT_REQUESTS"

title "A create that failed but created the resource stays recorded, and a later identical create is kept too"
fault.py --after-handler "POST /api/2.0/postgres/projects" 504 0 1 DEADLINE_EXCEEDED
trace $CLI bundle deploy
$CLI bundle destroy --auto-approve &> LOG.destroy
trace $CLI bundle deploy
trace print_requests.py --get --oneline //postgres/projects ^//operations/ ^//branches
$CLI bundle destroy --auto-approve &> LOG.destroy
rm -f "$OUT_REQUESTS"

title "A request answered with a transient error and not repeated stays recorded"
fault.py "GET /api/2.0/preview/scim/v2/Me" 500 0 1 INTERNAL_ERROR
trace musterr $CLI current-user me
trace print_requests.py --get //scim
