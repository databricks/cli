title "Non-interactive output uses the non-paged renderer"
trace $CLI selftest tui pager --items 3

title "--header replaces the Name column header"
trace $CLI selftest tui pager --items 2 --header Workspace

title "An injected error after 2 rows is returned"
musterr trace $CLI selftest tui pager --items 5 --fail-after 2

title "--fail-after 0 fails on the first Next"
musterr trace $CLI selftest tui pager --items 5 --fail-after 0

title "Negative --items is rejected"
musterr trace $CLI selftest tui pager --items -1
