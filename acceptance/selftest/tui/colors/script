title "Default stream is stderr, so stdout is empty"
$CLI selftest tui colors 2>/dev/null | contains.py '!red:'
trace $CLI selftest tui colors 2>&1 >/dev/null | contains.py 'red:' 'hiblue:'

title "--stream stdout writes the swatches to stdout"
$CLI selftest tui colors --stream stdout 2>/dev/null

title "--stream stderr writes to stderr"
$CLI selftest tui colors --stream stderr 2>&1 >/dev/null

title "Piped output has no escape codes, even with --lipgloss"
trace NO_COLOR=1 $CLI selftest tui colors --lipgloss 2>&1 | contains.py '!'$'\x1b'

title "--lipgloss prints both swatch rows"
trace $CLI selftest tui colors --lipgloss 2>&1 | contains.py 'truecolor:' '256-color:'

title "Unknown stream is rejected"
errcode trace $CLI selftest tui colors --stream file
