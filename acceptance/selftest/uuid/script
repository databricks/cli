title "UniqueUUID = true numbers distinct UUIDs\n"
# Distinct UUIDs get a stable [N] suffix in order of first appearance, so a golden
# pins which value appears where; a repeated UUID keeps its number.
echo "first:       11111111-1111-1111-1111-111111111111"
echo "second:      22222222-2222-2222-2222-222222222222"
echo "first again: 11111111-1111-1111-1111-111111111111"
