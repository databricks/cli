{
  "version": "1.0",
  "plugins": {
    "analytics": {
      "name": "analytics",
      "displayName": "Analytics",
      "description": "SQL analytics",
      "package": "@databricks/appkit",
      "resources": {
        "required": [
          {
            "type": "sql_warehouse",
            "alias": "SQL Warehouse",
            "resourceKey": "sql-warehouse",
            "description": "SQL Warehouse for analytics queries",
            "permission": "CAN_USE",
            "scope": "sql",
            "fields": {"id": {"env": "DATABRICKS_WAREHOUSE_ID", "description": "SQL Warehouse ID"}}
          }
        ],
        "optional": []
      }
    },
    "genie": {
      "name": "genie",
      "displayName": "Genie",
      "description": "Genie spaces",
      "package": "@databricks/appkit",
      "resources": {
        "required": [
          {
            "type": "genie_space",
            "alias": "Genie Space",
            "resourceKey": "genie-space",
            "description": "Genie Space",
            "permission": "CAN_RUN",
            "scope": "genie",
            "fields": {"id": {"env": "DATABRICKS_GENIE_SPACE_ID", "description": "Genie Space ID"}}
          }
        ],
        "optional": []
      }
    }
  }
}
